{%- comment -%}
  Huggaroo – Reviews: rating summary + review grid.
{%- endcomment -%}
<section class="hgr" id="hg-reviews-{{ section.id }}">
  <div class="hgr__inner">
    <div class="hgr__head">
      {%- if section.settings.heading != blank -%}<h2 class="hgr__heading">{{ section.settings.heading }}</h2>{%- endif -%}
      <div class="hgr__summary">
        <div class="hgr__score">
          <span class="hgr__score-num">{{ section.settings.rating }}</span>
          <span class="hgr__stars" aria-hidden="true">{%- for i in (1..5) -%}<svg viewBox="0 0 20 20"><path d="M10 1.5l2.6 5.4 5.9.8-4.3 4.1 1.1 5.9L10 14.9l-5.3 2.8 1.1-5.9L1.5 7.7l5.9-.8z"/></svg>{%- endfor -%}</span>
          <span class="hgr__score-text">{{ section.settings.rating_text }}</span>
        </div>
        <ul class="hgr__bars">
          {%- assign labels = '5,4,3,2,1' | split: ',' -%}
          {%- assign values = section.settings.bar_5 | append: ',' | append: section.settings.bar_4 | append: ',' | append: section.settings.bar_3 | append: ',' | append: section.settings.bar_2 | append: ',' | append: section.settings.bar_1 | split: ',' -%}
          {%- for label in labels -%}
            {%- assign v = values[forloop.index0] | plus: 0 -%}
            <li><span class="hgr__bar-label">{{ label }} <svg viewBox="0 0 20 20"><path d="M10 1.5l2.6 5.4 5.9.8-4.3 4.1 1.1 5.9L10 14.9l-5.3 2.8 1.1-5.9L1.5 7.7l5.9-.8z"/></svg></span><span class="hgr__bar"><span style="width: {{ v }}%"></span></span><span class="hgr__bar-pct">{{ v }}%</span></li>
          {%- endfor -%}
        </ul>
      </div>
    </div>

    <div class="hgr__grid">
      {%- for block in section.blocks -%}
        <article class="hgr__card" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            <div class="hgr__media">{{ block.settings.image | image_url: width: 700 | image_tag: loading: 'lazy', sizes: '(min-width: 990px) 25vw, 50vw', alt: block.settings.name }}</div>
          {%- endif -%}
          <div class="hgr__body">
            <span class="hgr__stars hgr__stars--sm" aria-label="{{ block.settings.stars }} out of 5 stars">
              {%- for i in (1..5) -%}<svg viewBox="0 0 20 20" class="{% if i > block.settings.stars %}is-off{% endif %}"><path d="M10 1.5l2.6 5.4 5.9.8-4.3 4.1 1.1 5.9L10 14.9l-5.3 2.8 1.1-5.9L1.5 7.7l5.9-.8z"/></svg>{%- endfor -%}
            </span>
            {%- if block.settings.title != blank -%}<h3 class="hgr__title">{{ block.settings.title }}</h3>{%- endif -%}
            <p class="hgr__text">{{ block.settings.text }}</p>
            <div class="hgr__meta">
              <span class="hgr__avatar" aria-hidden="true">{{ block.settings.name | slice: 0 }}</span>
              <span class="hgr__name">{{ block.settings.name }}</span>
              {%- if block.settings.verified -%}
                <span class="hgr__verified"><svg viewBox="0 0 20 20"><path d="M10 1l2.4 2 3-.3.9 2.9 2.6 1.6-1.2 2.8 1.2 2.8-2.6 1.6-.9 2.9-3-.3-2.4 2-2.4-2-3 .3-.9-2.9L1.1 12.8l1.2-2.8L1.1 7.2l2.6-1.6.9-2.9 3 .3z"/></svg>Verified buyer</span>
              {%- endif -%}
            </div>
          </div>
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>

{% stylesheet %}
  .hgr { --hg-brown: #6B4A3A; --hg-tan: #C9A98A; --hg-cream: #F7EFE3; --hg-line: #E6D9C4; --hg-muted: #8A7A6C;
    background: var(--hg-cream); color: #3A2E26; padding: 56px 0; font-family: var(--font-body--family, Inter, sans-serif); }
  .hgr *, .hgr *::before, .hgr *::after { box-sizing: border-box; min-width: 0; }
  .hgr { width: 100%; max-width: 100%; overflow-x: clip; }
  .hgr__inner { max-width: 1200px; margin: 0 auto; padding: 0 16px; }
  .hgr__head { text-align: center; margin-bottom: 28px; }
  .hgr__heading { font-family: var(--font-heading--family, inherit); font-size: clamp(26px, 4vw, 40px); font-weight: 800; line-height: 1.15; margin: 0 0 20px; color: var(--hg-brown); }
  .hgr__summary { display: grid; gap: 20px; justify-content: center; align-items: center; max-width: 620px; margin: 0 auto; background: #fff; border: 1px solid var(--hg-line); border-radius: 16px; padding: 20px; }
  @media (min-width: 750px) { .hgr__summary { grid-template-columns: auto 1fr; gap: 32px; text-align: left; } }
  .hgr__score { display: flex; flex-direction: column; align-items: center; gap: 4px; }
  .hgr__score-num { font-size: 56px; font-weight: 800; line-height: 1; color: var(--hg-brown); }
  .hgr__stars { display: inline-flex; gap: 2px; }
  .hgr__stars svg { width: 20px; height: 20px; fill: var(--hg-tan); }
  .hgr__stars--sm svg { width: 15px; height: 15px; }
  .hgr__stars svg.is-off { fill: #e5d7c2; }
  .hgr__score-text { font-size: 12px; color: var(--hg-muted); }
  .hgr__bars { list-style: none; margin: 0; padding: 0; display: grid; gap: 6px; min-width: 240px; }
  .hgr__bars li { display: grid; grid-template-columns: 34px 1fr 40px; align-items: center; gap: 8px; font-size: 12px; }
  .hgr__bar-label { display: inline-flex; align-items: center; gap: 2px; font-weight: 700; }
  .hgr__bar-label svg { width: 11px; height: 11px; fill: var(--hg-tan); }
  .hgr__bar { height: 8px; border-radius: 999px; background: #ece2d0; overflow: hidden; }
  .hgr__bar span { display: block; height: 100%; background: var(--hg-tan) !important; border-radius: 999px; }
  .hgr__bar-pct { text-align: right; color: var(--hg-muted); }
  .hgr__grid { columns: 2; column-gap: 12px; }
  @media (min-width: 750px) { .hgr__grid { columns: 3; column-gap: 16px; } }
  @media (min-width: 1100px) { .hgr__grid { columns: 4; } }
  .hgr__card { break-inside: avoid; display: inline-block; width: 100%; margin: 0 0 12px; background: #fff; border-radius: 14px; overflow: hidden; border: 1px solid var(--hg-line); }
  .hgr__media img { width: 100%; height: auto; display: block; }
  .hgr__body { padding: 14px; }
  .hgr__title { font-size: 14px; font-weight: 800; margin: 8px 0 4px; }
  .hgr__text { font-size: 13px; line-height: 1.55; color: #4a3c30; margin: 6px 0 12px; }
  .hgr__meta { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; font-size: 12px; }
  .hgr__avatar { width: 26px; height: 26px; border-radius: 50%; background: var(--hg-brown); color: #fff; font-weight: 800; display: inline-flex; align-items: center; justify-content: center; font-size: 12px; }
  .hgr__name { font-weight: 700; }
  .hgr__verified { display: inline-flex; align-items: center; gap: 4px; color: #1f7a3a; font-weight: 600; font-size: 11px; }
  .hgr__verified svg { width: 14px; height: 14px; fill: #1f7a3a; }
{% endstylesheet %}

{% schema %}
{
  "name": "HG Reviews",
  "tag": "section",
  "class": "hg-section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "What parents say about Huggaroo" },
    { "type": "text", "id": "rating", "label": "Average rating", "default": "4.9" },
    { "type": "text", "id": "rating_text", "label": "Rating subtext", "default": "Based on 812 reviews" },
    { "type": "range", "id": "bar_5", "label": "5 star %", "min": 0, "max": 100, "step": 1, "default": 88 },
    { "type": "range", "id": "bar_4", "label": "4 star %", "min": 0, "max": 100, "step": 1, "default": 9 },
    { "type": "range", "id": "bar_3", "label": "3 star %", "min": 0, "max": 100, "step": 1, "default": 2 },
    { "type": "range", "id": "bar_2", "label": "2 star %", "min": 0, "max": 100, "step": 1, "default": 1 },
    { "type": "range", "id": "bar_1", "label": "1 star %", "min": 0, "max": 100, "step": 1, "default": 0 }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Photo" },
        { "type": "range", "id": "stars", "label": "Stars", "min": 1, "max": 5, "step": 1, "default": 5 },
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "textarea", "id": "text", "label": "Review", "default": "Replace with a real customer review." },
        { "type": "text", "id": "name", "label": "Name", "default": "Customer name" },
        { "type": "checkbox", "id": "verified", "label": "Verified buyer", "default": true }
      ]
    }
  ],
  "max_blocks": 24,
  "presets": [
    { "name": "HG Reviews", "blocks": [
      { "type": "review", "settings": { "stars": 5, "title": "Lives in this hoodie", "text": "I wear this around the house constantly. My hands are finally free and the baby naps so much better against me. So soft too.", "name": "Amanda R." } },
      { "type": "review", "settings": { "stars": 5, "title": "Perfect for winter walks", "text": "Keeps us both warm and I don't need a separate carrier. Getting my baby in and out is easy with the center zip.", "name": "Priya S." } },
      { "type": "review", "settings": { "stars": 4, "title": "Great fit", "text": "Runs true to size for me. Ordered a size up since I like it extra roomy for layering underneath.", "name": "Jess M." } },
      { "type": "review", "settings": { "stars": 5, "title": "Bought two colors", "text": "Got the cream and the mocha brown. Both are just as soft as I hoped and my newborn fits perfectly.", "name": "Taylor K." } }
    ] }
  ]
}
{% endschema %}
