{%- comment -%}
  Huggaroo – FAQ accordion (details/summary, no JS).
{%- endcomment -%}
<section class="hgf" id="hg-faq-{{ section.id }}">
  <div class="hgf__inner">
    <div class="hgf__head">
      {%- if section.settings.eyebrow != blank -%}<span class="hgf__eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
      {%- if section.settings.heading != blank -%}<h2 class="hgf__heading">{{ section.settings.heading }}</h2>{%- endif -%}
      {%- if section.settings.text != blank -%}<p class="hgf__text">{{ section.settings.text }}</p>{%- endif -%}
    </div>
    <div class="hgf__list">
      {%- for block in section.blocks -%}
        <details class="hgf__item" {% if forloop.first and section.settings.open_first %}open{% endif %} {{ block.shopify_attributes }}>
          <summary class="hgf__q"><span>{{ block.settings.question }}</span><span class="hgf__icon" aria-hidden="true"></span></summary>
          <div class="hgf__a">{{ block.settings.answer }}</div>
        </details>
      {%- endfor -%}
    </div>
  </div>
</section>

{% stylesheet %}
  .hgf { --hg-brown: #6B4A3A; --hg-tan: #C9A98A; --hg-cream: #F7EFE3; --hg-line: #E6D9C4; --hg-muted: #8A7A6C;
    background: #fff; color: #3A2E26; padding: 56px 0; font-family: var(--font-body--family, Inter, sans-serif); }
  .hgf *, .hgf *::before, .hgf *::after { box-sizing: border-box; min-width: 0; }
  .hgf { width: 100%; max-width: 100%; overflow-x: clip; }
  .hgf__inner { max-width: 780px; margin: 0 auto; padding: 0 16px; }
  .hgf__head { text-align: center; margin-bottom: 26px; }
  .hgf__eyebrow { display: inline-block; font-size: 11px; font-weight: 700; letter-spacing: 2.5px; text-transform: uppercase; color: var(--hg-tan); margin-bottom: 12px; }
  .hgf__heading { font-family: var(--font-heading--family, inherit); font-size: clamp(26px, 4vw, 40px); font-weight: 800; line-height: 1.15; margin: 0 0 10px; color: var(--hg-brown); }
  .hgf__text { font-size: 15px; line-height: 1.6; color: var(--hg-muted); margin: 0; }
  .hgf__list { display: grid; gap: 10px; }
  .hgf__item { border: 1px solid var(--hg-line); border-radius: 14px; background: #fff; overflow: hidden; }
  .hgf__item[open] { border-color: var(--hg-brown); }
  .hgf__q { list-style: none; cursor: pointer; display: flex; justify-content: space-between; align-items: center; gap: 12px; padding: 16px 18px; font-size: 15px; font-weight: 700; }
  .hgf__q::-webkit-details-marker { display: none; }
  .hgf__icon { position: relative; flex: 0 0 26px; width: 26px; height: 26px; border-radius: 50%; background: var(--hg-cream); }
  .hgf__icon::before, .hgf__icon::after { content: ""; position: absolute; left: 50%; top: 50%; width: 10px; height: 2px; background: var(--hg-brown); transform: translate(-50%, -50%); transition: .2s; }
  .hgf__icon::after { transform: translate(-50%, -50%) rotate(90deg); }
  .hgf__item[open] .hgf__icon::after { transform: translate(-50%, -50%) rotate(0); }
  .hgf__a { padding: 0 18px 16px; font-size: 14px; line-height: 1.7; color: var(--hg-muted); }
  .hgf__a p { margin: 0 0 8px; }
{% endstylesheet %}

{% schema %}
{
  "name": "HG FAQ",
  "tag": "section",
  "class": "hg-section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Good to know" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Frequently asked questions" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Everything you need to know before you order." },
    { "type": "checkbox", "id": "open_first", "label": "Open first question by default", "default": true }
  ],
  "blocks": [
    {
      "type": "faq",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "Question" },
        { "type": "richtext", "id": "answer", "label": "Answer", "default": "<p>Answer</p>" }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    { "name": "HG FAQ", "blocks": [
      { "type": "faq", "settings": { "question": "What size should I order?", "answer": "<p>See the size chart in centimeters in the product description above (Length, Bust, Shoulder, Sleeve Length). This is an oversized fit — size down for a snugger fit or up for extra room to layer underneath.</p>" } },
      { "type": "faq", "settings": { "question": "What is it made of?", "answer": "<p>100% polyester fleece, with corduroy trim on the cuffs and pouch opening.</p>" } },
      { "type": "faq", "settings": { "question": "Does it come in other colors?", "answer": "<p>Yes — Oatmeal Cream, Blush Pink, Mocha Brown, and Charcoal Grey.</p>" } },
      { "type": "faq", "settings": { "question": "Do you offer free shipping?", "answer": "<p>Yes, shipping is free on every order. Add shipping protection at checkout to cover loss or damage in transit.</p>" } },
      { "type": "faq", "settings": { "question": "What is your return policy?", "answer": "<p>If you're not happy within 30 days, contact us for a replacement or full refund.</p>" } }
    ] }
  ]
}
{% endschema %}
