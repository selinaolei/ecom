{%- comment -%}
  HeroMode – Testimonials: quote cards with product photography.
{%- endcomment -%}
<section class="hmt" id="hm-testimonials-{{ section.id }}">
  <div class="hmt__inner">
    {%- if section.settings.eyebrow != blank -%}<span class="hmt__eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
    {%- if section.settings.heading != blank -%}<h2 class="hmt__heading">{{ section.settings.heading }}</h2>{%- endif -%}
    <div class="hmt__grid">
      {%- for block in section.blocks -%}
        <article class="hmt__card" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            <div class="hmt__media">{{ block.settings.image | image_url: width: 700 | image_tag: loading: 'lazy', sizes: '(min-width: 990px) 33vw, 90vw', alt: block.settings.name }}</div>
          {%- endif -%}
          <div class="hmt__body">
            <span class="hmt__stars" aria-hidden="true">{%- for i in (1..5) -%}<svg viewBox="0 0 20 20"><path d="M10 1.5l2.6 5.4 5.9.8-4.3 4.1 1.1 5.9L10 14.9l-5.3 2.8 1.1-5.9L1.5 7.7l5.9-.8z"/></svg>{%- endfor -%}</span>
            {%- if block.settings.title != blank -%}<h3 class="hmt__title">&ldquo;{{ block.settings.title }}&rdquo;</h3>{%- endif -%}
            <p class="hmt__text">{{ block.settings.text }}</p>
            <p class="hmt__name">&mdash; {{ block.settings.name }}</p>
          </div>
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>

{% stylesheet %}
  .hmt { --hm-red: #B3272C; --hm-gold: #D9A520; --hm-black: #1A1A1A; --hm-cream: #F5EFE3; --hm-line: #2e2e2e; --hm-muted: #b9b2a6;
    background: var(--hm-black); padding: 56px 0; font-family: var(--font-body--family, Inter, sans-serif); }
  .hmt *, .hmt *::before, .hmt *::after { box-sizing: border-box; min-width: 0; }
  .hmt { width: 100%; max-width: 100%; overflow-x: clip; }
  .hmt__inner { max-width: 1100px; margin: 0 auto; padding: 0 16px; text-align: center; }
  .hmt__eyebrow { display: inline-block; font-size: 11px; font-weight: 700; letter-spacing: 2.5px; text-transform: uppercase; color: var(--hm-gold); margin-bottom: 12px; }
  .hmt__heading { text-align: center; font-family: var(--font-heading--family, inherit); font-size: clamp(26px, 4vw, 38px); font-weight: 900; text-transform: uppercase; letter-spacing: -0.5px; margin: 0 0 30px; color: #fff; }
  .hmt__grid { display: grid; gap: 20px; text-align: left; }
  @media (min-width: 750px) { .hmt__grid { grid-template-columns: repeat(3, 1fr); } }
  .hmt__card { background: #232323; border-radius: 14px; overflow: hidden; border: 1px solid var(--hm-line); display: flex; flex-direction: column; }
  .hmt__media { aspect-ratio: 4 / 5; background: var(--hm-black); }
  .hmt__media img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .hmt__body { padding: 20px; }
  .hmt__stars { display: inline-flex; gap: 2px; margin-bottom: 10px; }
  .hmt__stars svg { width: 15px; height: 15px; fill: var(--hm-gold); }
  .hmt__title { font-size: 16px; font-weight: 800; margin: 0 0 8px; color: #fff; line-height: 1.3; }
  .hmt__text { font-size: 13px; line-height: 1.6; color: #cfc8ba; margin: 0 0 12px; }
  .hmt__name { font-size: 12px; font-weight: 700; color: var(--hm-gold); margin: 0; }
{% endstylesheet %}

{% schema %}
{
  "name": "HM Testimonials",
  "tag": "section",
  "class": "hm-section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Riders love it" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Everyone was asking" }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Photo" },
        { "type": "text", "id": "title", "label": "Quote headline", "default": "So worth it" },
        { "type": "textarea", "id": "text", "label": "Full quote", "default": "Replace with a real customer quote." },
        { "type": "text", "id": "name", "label": "Name", "default": "Customer name" }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    { "name": "HM Testimonials", "blocks": [
      { "type": "testimonial", "settings": { "title": "Everyone was asking where I got it", "text": "Wore it on the first chairlift of the day and three people asked where to get one. Fits perfectly under my helmet.", "name": "Jordan L." } },
      { "type": "testimonial", "settings": { "title": "Warmer than I expected", "text": "Kept my whole face warm on a windy day at the top of the mountain. Goggles sat right over the eye opening with no gaps.", "name": "Marcus T." } },
      { "type": "testimonial", "settings": { "title": "Stands out in every photo", "text": "Bought it for the look but it's actually really practical too. One size fit me and my partner just fine.", "name": "Casey R." } }
    ] }
  ],
  "enabled_on": { "templates": ["product"] }
}
{% endschema %}
