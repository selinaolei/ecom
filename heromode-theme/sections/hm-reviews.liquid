{%- comment -%}
  HeroMode – Reviews: rating summary + review grid.
{%- endcomment -%}
<section class="hmr" id="hm-reviews-{{ section.id }}">
  <div class="hmr__inner">
    <div class="hmr__head">
      {%- if section.settings.heading != blank -%}<h2 class="hmr__heading">{{ section.settings.heading }}</h2>{%- endif -%}
      <div class="hmr__summary">
        <div class="hmr__score">
          <span class="hmr__score-num">{{ section.settings.rating }}</span>
          <span class="hmr__stars" aria-hidden="true">{%- for i in (1..5) -%}<svg viewBox="0 0 20 20"><path d="M10 1.5l2.6 5.4 5.9.8-4.3 4.1 1.1 5.9L10 14.9l-5.3 2.8 1.1-5.9L1.5 7.7l5.9-.8z"/></svg>{%- endfor -%}</span>
          <span class="hmr__score-text">{{ section.settings.rating_text }}</span>
        </div>
        <ul class="hmr__bars">
          {%- assign labels = '5,4,3,2,1' | split: ',' -%}
          {%- assign values = section.settings.bar_5 | append: ',' | append: section.settings.bar_4 | append: ',' | append: section.settings.bar_3 | append: ',' | append: section.settings.bar_2 | append: ',' | append: section.settings.bar_1 | split: ',' -%}
          {%- for label in labels -%}
            {%- assign v = values[forloop.index0] | plus: 0 -%}
            <li><span class="hmr__bar-label">{{ label }} <svg viewBox="0 0 20 20"><path d="M10 1.5l2.6 5.4 5.9.8-4.3 4.1 1.1 5.9L10 14.9l-5.3 2.8 1.1-5.9L1.5 7.7l5.9-.8z"/></svg></span><span class="hmr__bar"><span style="width: {{ v }}%"></span></span><span class="hmr__bar-pct">{{ v }}%</span></li>
          {%- endfor -%}
        </ul>
      </div>
    </div>

    <div class="hmr__grid">
      {%- for block in section.blocks -%}
        <article class="hmr__card" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            <div class="hmr__media">{{ block.settings.image | image_url: width: 700 | image_tag: loading: 'lazy', sizes: '(min-width: 990px) 25vw, 50vw', alt: block.settings.name }}</div>
          {%- endif -%}
          <div class="hmr__body">
            <span class="hmr__stars hmr__stars--sm" aria-label="{{ block.settings.stars }} out of 5 stars">
              {%- for i in (1..5) -%}<svg viewBox="0 0 20 20" class="{% if i > block.settings.stars %}is-off{% endif %}"><path d="M10 1.5l2.6 5.4 5.9.8-4.3 4.1 1.1 5.9L10 14.9l-5.3 2.8 1.1-5.9L1.5 7.7l5.9-.8z"/></svg>{%- endfor -%}
            </span>
            {%- if block.settings.title != blank -%}<h3 class="hmr__title">{{ block.settings.title }}</h3>{%- endif -%}
            <p class="hmr__text">{{ block.settings.text }}</p>
            <div class="hmr__meta">
              <span class="hmr__avatar" aria-hidden="true">{{ block.settings.name | slice: 0 }}</span>
              <span class="hmr__name">{{ block.settings.name }}</span>
              {%- if block.settings.verified -%}
                <span class="hmr__verified"><svg viewBox="0 0 20 20"><path d="M10 1l2.4 2 3-.3.9 2.9 2.6 1.6-1.2 2.8 1.2 2.8-2.6 1.6-.9 2.9-3-.3-2.4 2-2.4-2-3 .3-.9-2.9L1.1 12.8l1.2-2.8L1.1 7.2l2.6-1.6.9-2.9 3 .3z"/></svg>Verified buyer</span>
              {%- endif -%}
            </div>
          </div>
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>

{% stylesheet %}
  .hmr { --hm-red: #B3272C; --hm-gold: #D9A520; --hm-black: #1A1A1A; --hm-cream: #F5EFE3; --hm-line: #E6DFCF; --hm-muted: #7A756D;
    background: var(--hm-black); color: #fff; padding: 56px 0; font-family: var(--font-body--family, Inter, sans-serif); }
  .hmr *, .hmr *::before, .hmr *::after { box-sizing: border-box; min-width: 0; }
  .hmr { width: 100%; max-width: 100%; overflow-x: clip; }
  .hmr__inner { max-width: 1200px; margin: 0 auto; padding: 0 16px; }
  .hmr__head { text-align: center; margin-bottom: 28px; }
  .hmr__heading { font-family: var(--font-heading--family, inherit); font-size: clamp(26px, 4vw, 40px); font-weight: 900; line-height: 1.15; margin: 0 0 20px; color: #fff; text-transform: uppercase; letter-spacing: -0.5px; }
  .hmr__summary { display: grid; gap: 20px; justify-content: center; align-items: center; max-width: 620px; margin: 0 auto; background: #232323; border: 1px solid #3a3a3a; border-radius: 16px; padding: 20px; }
  @media (min-width: 750px) { .hmr__summary { grid-template-columns: auto 1fr; gap: 32px; text-align: left; } }
  .hmr__score { display: flex; flex-direction: column; align-items: center; gap: 4px; }
  .hmr__score-num { font-size: 56px; font-weight: 900; line-height: 1; color: var(--hm-gold); }
  .hmr__stars { display: inline-flex; gap: 2px; }
  .hmr__stars svg { width: 20px; height: 20px; fill: var(--hm-gold); }
  .hmr__stars--sm svg { width: 15px; height: 15px; }
  .hmr__stars svg.is-off { fill: #4a4a4a; }
  .hmr__score-text { font-size: 12px; color: #b9b2a6; }
  .hmr__bars { list-style: none; margin: 0; padding: 0; display: grid; gap: 6px; min-width: 240px; }
  .hmr__bars li { display: grid; grid-template-columns: 34px 1fr 40px; align-items: center; gap: 8px; font-size: 12px; color: #cfc8ba; }
  .hmr__bar-label { display: inline-flex; align-items: center; gap: 2px; font-weight: 700; }
  .hmr__bar-label svg { width: 11px; height: 11px; fill: var(--hm-gold); }
  .hmr__bar { height: 8px; border-radius: 999px; background: #3a3a3a; overflow: hidden; }
  .hmr__bar span { display: block; height: 100%; background: var(--hm-gold) !important; border-radius: 999px; }
  .hmr__bar-pct { text-align: right; color: #b9b2a6; }
  .hmr__grid { columns: 2; column-gap: 12px; }
  @media (min-width: 750px) { .hmr__grid { columns: 3; column-gap: 16px; } }
  @media (min-width: 1100px) { .hmr__grid { columns: 4; } }
  .hmr__card { break-inside: avoid; display: inline-block; width: 100%; margin: 0 0 12px; background: #fff; border-radius: 12px; overflow: hidden; color: #1A1A1A; }
  .hmr__media img { width: 100%; height: auto; display: block; }
  .hmr__body { padding: 14px; }
  .hmr__title { font-size: 14px; font-weight: 800; margin: 8px 0 4px; }
  .hmr__text { font-size: 13px; line-height: 1.55; color: #4a4a4a; margin: 6px 0 12px; }
  .hmr__meta { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; font-size: 12px; }
  .hmr__avatar { width: 26px; height: 26px; border-radius: 50%; background: var(--hm-red); color: #fff; font-weight: 800; display: inline-flex; align-items: center; justify-content: center; font-size: 12px; }
  .hmr__name { font-weight: 700; }
  .hmr__verified { display: inline-flex; align-items: center; gap: 4px; color: #1f7a3a; font-weight: 600; font-size: 11px; }
  .hmr__verified svg { width: 14px; height: 14px; fill: #1f7a3a; }
{% endstylesheet %}

{% schema %}
{
  "name": "HM Reviews",
  "tag": "section",
  "class": "hm-section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "What riders say about HeroMode" },
    { "type": "text", "id": "rating", "label": "Average rating", "default": "4.9" },
    { "type": "text", "id": "rating_text", "label": "Rating subtext", "default": "Based on 640 reviews" },
    { "type": "range", "id": "bar_5", "label": "5 star %", "min": 0, "max": 100, "step": 1, "default": 87 },
    { "type": "range", "id": "bar_4", "label": "4 star %", "min": 0, "max": 100, "step": 1, "default": 9 },
    { "type": "range", "id": "bar_3", "label": "3 star %", "min": 0, "max": 100, "step": 1, "default": 3 },
    { "type": "range", "id": "bar_2", "label": "2 star %", "min": 0, "max": 100, "step": 1, "default": 1 },
    { "type": "range", "id": "bar_1", "label": "1 star %", "min": 0, "max": 100, "step": 1, "default": 0 }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Photo" },
        { "type": "range", "id": "stars", "label": "Stars", "min": 1, "max": 5, "step": 1, "default": 5 },
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "textarea", "id": "text", "label": "Review", "default": "Replace with a real customer review." },
        { "type": "text", "id": "name", "label": "Name", "default": "Customer name" },
        { "type": "checkbox", "id": "verified", "label": "Verified buyer", "default": true }
      ]
    }
  ],
  "max_blocks": 24,
  "presets": [
    { "name": "HM Reviews", "blocks": [
      { "type": "review", "settings": { "stars": 5, "title": "Stands out on the mountain", "text": "Everyone kept asking where I got it. Fits perfectly under my helmet and goggles, no gaps.", "name": "Jordan L." } },
      { "type": "review", "settings": { "stars": 5, "title": "Warm and comfortable", "text": "Wasn't expecting it to be this soft. Kept my face warm all day on the lift.", "name": "Marcus T." } },
      { "type": "review", "settings": { "stars": 4, "title": "Great fit", "text": "One size fits most is accurate for me. Stretchy enough to pull on and off easily.", "name": "Devon K." } },
      { "type": "review", "settings": { "stars": 5, "title": "Exactly as pictured", "text": "Color is bold in person too. Shipped fast and arrived before my trip.", "name": "Casey R." } }
    ] }
  ]
}
{% endschema %}
