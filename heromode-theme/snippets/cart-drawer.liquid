{% doc %}
  HeroMode cart drawer. Every cart change (add, quantity, remove) is a fetch() to Shopify's
  cart endpoints — no iframe, no page reload. The response is the freshly rendered drawer
  section, which is swapped into the open drawer.

  @param {boolean} [render_wrapper] - When true, wraps the drawer in the section wrapper that the Section Rendering API adds automatically.
{% enddoc %}

{%- liquid
  assign render_wrapper = render_wrapper | default: true, allow_false: true

  assign hm_main_handle = 'heromode-face-mask'
  assign hm_main_handles = 'heromode-face-mask' | split: ','
  assign hm_rating = '4.9'
  assign hm_reviews = '640'
  assign hm_orders_base = 24

  assign seed = 'now' | date: '%j' | plus: 0 | times: 5 | modulo: 19
  assign hm_orders_today = hm_orders_base | plus: seed

  assign has_protection = false
  for item in cart.items
    if item.product.handle == 'heromode-shipping-protection'
      assign has_protection = true
    endif
  endfor
  assign main_product = all_products[hm_main_handle]

  assign hmc_total_save = 0
  assign hmc_total_compare = 0
  for item in cart.items
    if item.original_line_price > item.final_line_price
      assign hmc_line_save = item.original_line_price | minus: item.final_line_price
      assign hmc_total_save = hmc_total_save | plus: hmc_line_save
      assign hmc_total_compare = hmc_total_compare | plus: item.original_line_price
    endif
  endfor
  assign hmc_save_pct = 0
  if hmc_total_compare > 0
    assign hmc_save_pct = hmc_total_save | times: 100 | divided_by: hmc_total_compare
  endif
-%}

{%- if settings.cart_type == 'drawer' and template.name != 'cart' -%}
  {% if render_wrapper %}
    <div
      id="shopify-section-cart-drawer-section"
      class="shopify-section"
    >
  {% endif %}

  <script
    type="module"
    src="{{ 'cart-drawer.js' | asset_url }}"
    fetchpriority="low"
  ></script>

  <theme-drawer
    id="cart-drawer"
    data-skip-node-update
  >
    <dialog
      ref="panel"
      class="theme-drawer__dialog color-custom-drawer hmc__dialog"
      aria-labelledby="cart-drawer-heading"
      cart-summary-sticky="true"
    >
      <cart-drawer-component
        {% if settings.auto_open_cart_drawer and template.name != 'cart' %}
          auto-open
        {% endif %}
      >
        <div class="hmc{% if cart.empty? %} hmc--empty{% endif %}" data-hm-cart data-count="{{ cart.item_count }}">

          <div class="hmc__head">
            <h2 class="hmc__title" id="cart-drawer-heading">Your cart <span class="hmc__count">({{ cart.item_count }})</span></h2>
            <button on:click="#cart-drawer/close" class="hmc__close" type="button" aria-label="{{ 'actions.close' | t }}">
              <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M5 5l10 10M15 5L5 15" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/></svg>
            </button>
          </div>

          {%- if cart.empty? -%}
            <div class="hmc__empty">
              <p class="hmc__empty-title">Your cart is empty</p>
              <p class="hmc__empty-text">Your HeroMode mask is one tap away.</p>
              <a class="hmc__empty-btn" href="{{ main_product.url | default: routes.all_products_collection_url }}">Shop the Mask</a>
            </div>
          {%- else -%}
            <p class="hmc__proof">
              <span class="hmc__proof-item"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3c1 4 5 5 5 10a5 5 0 0 1-10 0c0-2 1-3 2-4 0 2 1 3 2 3 0-3-1-5 1-9z"/></svg>{{ hm_orders_today }} ordered today</span>
              <span class="hmc__proof-dot" aria-hidden="true">&middot;</span>
              <span class="hmc__proof-item"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2.8l2.8 5.8 6.4.9-4.6 4.5 1.1 6.3L12 17.3l-5.7 3 1.1-6.3L2.8 9.5l6.4-.9z"/></svg>{{ hm_rating }} ({{ hm_reviews }} reviews)</span>
            </p>

            <div class="hmc__banner">
              <p><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 7h11v9H3zM14 10h4l3 3v3h-7z"/><circle cx="7" cy="17.5" r="1.8"/><circle cx="17" cy="17.5" r="1.8"/></svg>{% if has_protection %}Free insured shipping applied{% else %}Free shipping applied{% endif %}</p>
              <p><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3l7 3v5c0 5-3.5 8.5-7 10-3.5-1.5-7-5-7-10V6z"/><path d="M9 12l2 2 4-4"/></svg>30-day guarantee</p>
            </div>

            <div class="hmc__items">
              {%- comment -%}
                Two passes over the same cart.items array so each form's "line" value stays
                the true 1-based position Shopify expects for /cart/change.js, regardless of
                visual order. Pass 1 renders the mask first; pass 2 renders add-ons after.
              {%- endcomment -%}
              {%- for item in cart.items -%}
                {%- unless hm_main_handles contains item.product.handle -%}{%- continue -%}{%- endunless -%}
                <div class="hmc__item">
                  <div class="hmc__thumb">
                    {%- if item.image -%}
                      {{ item.image | image_url: width: 240 | image_tag: loading: 'lazy', alt: item.product.title, width: 120, height: 120 }}
                    {%- endif -%}
                  </div>
                  <div class="hmc__item-body">
                    <p class="hmc__item-title">{{ item.product.title }}</p>
                    {%- if item.variant.title != 'Default Title' and item.variant.title != blank -%}
                      <p class="hmc__item-variant">{{ item.variant.title | capitalize }}</p>
                    {%- endif -%}
                    <div class="hmc__qty" role="group" aria-label="Quantity">
                      <form action="{{ routes.cart_change_url }}.js" method="post" data-hm-cart-form>
                        <input type="hidden" name="line" value="{{ forloop.index }}">
                        <input type="hidden" name="quantity" value="{{ item.quantity | minus: 1 }}">
                        <button type="submit" aria-label="Decrease quantity">&minus;</button>
                      </form>
                      <span>{{ item.quantity }}</span>
                      <form action="{{ routes.cart_change_url }}.js" method="post" data-hm-cart-form>
                        <input type="hidden" name="line" value="{{ forloop.index }}">
                        <input type="hidden" name="quantity" value="{{ item.quantity | plus: 1 }}">
                        <button type="submit" aria-label="Increase quantity">+</button>
                      </form>
                    </div>
                  </div>
                  <div class="hmc__item-right">
                    <p class="hmc__item-price">{{ item.final_line_price | money }}</p>
                    {%- if item.original_line_price > item.final_line_price -%}
                      <p class="hmc__item-was">{{ item.original_line_price | money }}</p>
                    {%- endif -%}
                    <form action="{{ routes.cart_change_url }}.js" method="post" data-hm-cart-form>
                      <input type="hidden" name="line" value="{{ forloop.index }}">
                      <input type="hidden" name="quantity" value="0">
                      <button type="submit" class="hmc__remove">Remove</button>
                    </form>
                  </div>
                </div>
              {%- endfor -%}
              {%- for item in cart.items -%}
                {%- if hm_main_handles contains item.product.handle -%}{%- continue -%}{%- endif -%}
                <div class="hmc__item">
                  <div class="hmc__thumb">
                    {%- if item.image -%}
                      {{ item.image | image_url: width: 240 | image_tag: loading: 'lazy', alt: item.product.title, width: 120, height: 120 }}
                    {%- endif -%}
                  </div>
                  <div class="hmc__item-body">
                    <p class="hmc__item-title">{{ item.product.title }}</p>
                    {%- if item.variant.title != 'Default Title' and item.variant.title != blank -%}
                      <p class="hmc__item-variant">{{ item.variant.title | capitalize }}</p>
                    {%- endif -%}
                    <div class="hmc__qty" role="group" aria-label="Quantity">
                      <form action="{{ routes.cart_change_url }}.js" method="post" data-hm-cart-form>
                        <input type="hidden" name="line" value="{{ forloop.index }}">
                        <input type="hidden" name="quantity" value="{{ item.quantity | minus: 1 }}">
                        <button type="submit" aria-label="Decrease quantity">&minus;</button>
                      </form>
                      <span>{{ item.quantity }}</span>
                      <form action="{{ routes.cart_change_url }}.js" method="post" data-hm-cart-form>
                        <input type="hidden" name="line" value="{{ forloop.index }}">
                        <input type="hidden" name="quantity" value="{{ item.quantity | plus: 1 }}">
                        <button type="submit" aria-label="Increase quantity">+</button>
                      </form>
                    </div>
                  </div>
                  <div class="hmc__item-right">
                    <p class="hmc__item-price">{{ item.final_line_price | money }}</p>
                    {%- if item.original_line_price > item.final_line_price -%}
                      <p class="hmc__item-was">{{ item.original_line_price | money }}</p>
                    {%- endif -%}
                    <form action="{{ routes.cart_change_url }}.js" method="post" data-hm-cart-form>
                      <input type="hidden" name="line" value="{{ forloop.index }}">
                      <input type="hidden" name="quantity" value="0">
                      <button type="submit" class="hmc__remove">Remove</button>
                    </form>
                  </div>
                </div>
              {%- endfor -%}
            </div>

            <div class="hmc__footer">
              {%- if hmc_total_save > 0 -%}
                <div class="hmc__savings-total"><span>You save</span><span>{{ hmc_total_save | money }}{% if hmc_save_pct > 0 %} ({{ hmc_save_pct }}% off){% endif %}</span></div>
              {%- endif -%}
              <div class="hmc__subtotal"><span>Subtotal</span><span>{{ cart.total_price | money }}</span></div>
              <p class="hmc__note">Taxes calculated at checkout. Shipping is free{% if has_protection %} and insured{% endif %}.</p>
              <form action="{{ routes.cart_url }}" method="post" class="hmc__checkout-form">
                <button type="submit" name="checkout" class="hmc__checkout">
                  <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M8 12.5l2.5 2.5L16 9.5"/></svg>
                  Secure checkout
                </button>
              </form>
              <p class="hmc__encrypted"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="5" y="10" width="14" height="10" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/></svg>256-bit encrypted checkout</p>
              <div class="hmc__payments" aria-label="Accepted payment methods">
                {%- for type in shop.enabled_payment_types -%}{{ type | payment_type_svg_tag: class: 'hmc__pay' }}{%- endfor -%}
              </div>
            </div>
          {%- endif -%}
        </div>
      </cart-drawer-component>
    </dialog>
  </theme-drawer>

  {% if render_wrapper %}
    </div>
  {% endif %}
{%- endif -%}

{% stylesheet %}
  cart-drawer-component { display: contents; }
  @media screen and (max-width: 989px) {
    #cart-drawer .theme-drawer__dialog { --theme-drawer-width: min(88vw, 430px); border-radius: 22px 0 0 22px; box-shadow: -12px 0 40px rgba(0,0,0,.4); }
  }
  #cart-drawer .theme-drawer__dialog::backdrop { background: rgba(0, 0, 0, .65); }
  #cart-drawer .theme-drawer__dialog { height: auto; max-height: 100vh; margin: 0; top: 0; bottom: auto; }
  @supports (height: 100dvh) {
    #cart-drawer .theme-drawer__dialog { max-height: 100dvh; }
  }
  .hmc__dialog { --theme-drawer-padding: 0; }

  .hmc { text-align: left; --b: #B3272C; --b2: #8C1A1A; --gold: #D9A520; --black: #1A1A1A; --cream: #F5EFE3; --ink: #1A1A1A; --muted: #7A756D; --line: #ECE0CE;
    display: flex; flex-direction: column; height: 100%; min-height: 0; overflow: hidden; background: #fff; color: var(--ink); font-family: var(--font-body--family, Inter, sans-serif); position: relative; }
  .hmc *, .hmc *::before, .hmc *::after { box-sizing: border-box; min-width: 0; }
  .hmc form { margin: 0; }
  .hmc.is-busy::after { content: ""; position: absolute; inset: 0; background: rgba(255,255,255,.5); z-index: 5; }
  .hmc__head { position: relative; padding: 22px 68px 6px 22px; background: var(--black); }
  .hmc__title { margin: 0; font-family: var(--font-heading--family, inherit); font-size: 26px; font-weight: 900; color: #fff; text-transform: uppercase; letter-spacing: -0.3px; line-height: 1.1; display: flex; align-items: baseline; flex-wrap: wrap; gap: 8px; padding: 18px 0; }
  .hmc__count { font-size: 15px; font-weight: 700; color: var(--gold); letter-spacing: 0; }
  .hmc__close { position: absolute; top: 22px; right: 16px; width: 44px; height: 44px; border: 0; border-radius: 50%; background: rgba(255,255,255,.12); color: #fff; display: inline-flex; align-items: center; justify-content: center; cursor: pointer; z-index: 2; }
  .hmc__close svg { width: 18px; height: 18px; }
  .hmc__proof { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; margin: 14px 0 12px; padding: 0 22px; font-size: 14px; font-weight: 600; color: var(--b2); }
  .hmc__proof-item { display: inline-flex; align-items: center; gap: 5px; }
  .hmc__proof-item svg { width: 15px; height: 15px; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linejoin: round; }
  .hmc__proof-item:first-child svg { stroke: var(--b); }
  .hmc__proof-item:last-child svg { stroke: var(--gold); }
  .hmc__proof-dot { color: #cbbba8; }
  .hmc__banner { margin: 0 22px 12px; padding: 14px 16px; border-radius: 12px; background: var(--cream); display: grid; gap: 10px; }
  .hmc__banner p { margin: 0; display: flex; align-items: center; gap: 10px; font-size: 14px; font-weight: 700; color: var(--black); }
  .hmc__banner svg { width: 20px; height: 20px; fill: none; stroke: var(--b); stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; flex: 0 0 20px; }

  .hmc__items { flex: 1 1 auto; min-height: 90px; overflow-y: auto; -webkit-overflow-scrolling: touch; padding: 0 22px; }
  .hmc__item { display: grid; grid-template-columns: 74px 1fr auto; gap: 14px; align-items: start; padding: 16px 0; border-bottom: 1px solid var(--line); }
  .hmc__thumb { width: 74px; height: 74px; border-radius: 10px; background: var(--black); overflow: hidden; }
  .hmc__thumb img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .hmc__item-title { margin: 0 0 2px; font-size: 16px; font-weight: 700; line-height: 1.25; }
  .hmc__item-variant { margin: 0 0 8px; font-size: 14px; color: var(--muted); }
  .hmc__qty { display: inline-flex; align-items: center; border: 1.5px solid #e0d3bd; border-radius: 999px; overflow: hidden; margin-top: 6px; }
  .hmc__qty button { width: 34px; height: 32px; border: 0; background: none; font: inherit; font-size: 18px; font-weight: 800; color: var(--ink); cursor: pointer; }
  .hmc__qty span { min-width: 22px; text-align: center; font-size: 15px; font-weight: 800; }
  .hmc__item-right { display: flex; flex-direction: column; align-items: flex-end; gap: 6px; padding-top: 4px; }
  .hmc__item-price { margin: 0; font-size: 18px; font-weight: 800; color: var(--b); }
  .hmc__item-was { margin: -4px 0 0; font-size: 12px; color: #a89a8c; text-decoration: line-through; }
  .hmc__remove { border: 0; background: none; padding: 0; font: inherit; font-size: 14px; color: #a09284; text-decoration: underline; cursor: pointer; }

  .hmc__footer { padding: 14px 22px calc(18px + env(safe-area-inset-bottom)); border-top: 1px solid var(--line); background: #fff; box-shadow: 0 -10px 30px rgba(0,0,0,.06); }
  .hmc__savings-total { display: flex; justify-content: space-between; align-items: baseline; font-size: 15px; font-weight: 800; color: var(--b); margin-bottom: 4px; }
  .hmc__subtotal { display: flex; justify-content: space-between; align-items: baseline; font-size: 20px; font-weight: 900; color: var(--black); }
  .hmc__note { margin: 6px 0 12px; font-size: 13px; color: var(--muted); }
  .hmc__checkout { width: 100%; display: flex; align-items: center; justify-content: center; gap: 10px; border: 0; border-radius: 12px; background: linear-gradient(135deg, #D63A3F 0%, #B3272C 60%, #8C1A1A 100%); color: #fff; font: inherit; font-size: 18px; font-weight: 900; text-transform: uppercase; letter-spacing: .3px; padding: 18px; cursor: pointer; box-shadow: 0 12px 28px rgba(179,39,44,.32), inset 0 0 0 1.5px rgba(217,165,32,.55); }
  .hmc__checkout svg { width: 20px; height: 20px; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
  .hmc__encrypted { display: flex; align-items: center; justify-content: center; gap: 6px; margin: 10px 0 0; font-size: 12px; font-weight: 600; color: var(--muted); }
  .hmc__encrypted svg { width: 14px; height: 14px; fill: none; stroke: var(--black); stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
  .hmc__payments { display: flex; flex-wrap: wrap; justify-content: center; gap: 6px; margin-top: 12px; }
  .hmc__pay { width: 42px; height: 26px; border-radius: 5px; }

  .hmc__empty { flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; padding: 30px 22px; gap: 8px; }
  .hmc__empty-title { margin: 0; font-size: 20px; font-weight: 900; color: var(--black); text-transform: uppercase; }
  .hmc__empty-text { margin: 0 0 10px; font-size: 14px; color: var(--muted); }
  .hmc__empty-btn { display: inline-block; background: var(--b); color: #fff; font-weight: 800; padding: 14px 24px; border-radius: 999px; text-decoration: none; text-transform: uppercase; font-size: 13px; letter-spacing: .5px; }
{% endstylesheet %}
