{%- comment -%}
  HeroMode – cart guard. Add-on products can only be bought together with the face mask.
  If the cart holds add-ons without the mask (test orders, direct /cart/add calls), they
  are removed, the drawer is refreshed and a short notice is shown.
{%- endcomment -%}
<script type="module">
  (function () {
    var MAIN_HANDLES = ['heromode-face-mask'];
    var ADDON_HANDLES = ['heromode-shipping-protection', 'heromode-30-day-warranty'];
    var busy = false;
    var ownRequest = false;

    function notice() {
      if (document.getElementById('hm-cart-guard-notice')) return;
      var n = document.createElement('div');
      n.id = 'hm-cart-guard-notice';
      n.textContent = 'Shipping protection and warranty can only be added together with a HeroMode mask.';
      n.style.cssText = 'position:fixed;left:50%;bottom:20px;transform:translateX(-50%);z-index:10000;background:#1A1A1A;color:#fff;font:600 13px/1.4 Inter,sans-serif;padding:12px 16px;border-radius:10px;max-width:90vw;box-shadow:0 10px 30px rgba(0,0,0,.35);border:1px solid #D9A520';
      document.body.appendChild(n);
      setTimeout(function () { n.remove(); }, 6000);
    }

    async function refreshTheme(cartAfter, removed) {
      try {
        var ev = await import('@shopify/events');
        var d = ev.CartLinesUpdateEvent.createPromise();
        document.dispatchEvent(new ev.CartLinesUpdateEvent({
          action: 'remove',
          context: 'cart',
          lines: removed.map(function (i) { return { id: i.key, quantity: 0 }; }),
          promise: d.promise,
        }));
        d.resolve({
          cart: ev.CartLinesUpdateEvent.createCartFromAjaxResponse(cartAfter),
          detail: { items: cartAfter.items, source: 'hm-cart-guard', didError: false },
        });
      } catch (e) {
        if (window.location.pathname.indexOf('/cart') === 0) window.location.reload();
      }
    }

    async function check() {
      if (busy) return;
      busy = true;
      try {
        ownRequest = true;
        var cart = await (await fetch('/cart.js', { headers: { Accept: 'application/json' }, credentials: 'same-origin' })).json();
        var items = cart.items || [];
        var hasMain = items.some(function (i) { return MAIN_HANDLES.indexOf(i.handle) !== -1; });
        var strays = items.filter(function (i) { return ADDON_HANDLES.indexOf(i.handle) !== -1; });
        if (hasMain || strays.length === 0) return;
        var updates = {};
        strays.forEach(function (i) { updates[i.key] = 0; });
        ownRequest = true;
        var after = await (await fetch('/cart/update.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify({ updates: updates }),
        })).json();
        ownRequest = false;
        notice();
        await refreshTheme(after, strays);
        if (typeof window.hmCartRender === 'function') await window.hmCartRender();
        if (window.location.pathname.indexOf('/cart') === 0) window.location.reload();
      } catch (e) {
        ownRequest = false;
      } finally {
        busy = false;
      }
    }

    window.hmCartGuardCheck = check;
    check();
    document.addEventListener('theme-drawer:open', function () { setTimeout(check, 100); });
    window.addEventListener('pageshow', function (e) { if (e.persisted) check(); });
  })();
</script>
