{% doc %}
  Dear Paws cart drawer (basic version). Plain markup, no JavaScript beyond Horizon's
  open/close shell. Every cart change is a real HTML form post to Shopify's cart endpoints
  (a full page reload with return_to), so nothing on the page can intercept or break it.

  @param {boolean} [render_wrapper] - When true, wraps the drawer in the section wrapper that the Section Rendering API adds automatically.
{% enddoc %}

{%- liquid
  assign render_wrapper = render_wrapper | default: true, allow_false: true
  assign dp_main_handle = 'spiderjet-glove'
  assign back_url = request.path
  if request.path == '/' or request.path == blank
    assign back_url = all_products[dp_main_handle].url
  endif
-%}

{%- if settings.cart_type == 'drawer' and template.name != 'cart' -%}
  {% if render_wrapper %}
    <div
      id="shopify-section-cart-drawer-section"
      class="shopify-section"
    >
  {% endif %}

  <script
    type="module"
    src="{{ 'cart-drawer.js' | asset_url }}"
    fetchpriority="low"
  ></script>

  <theme-drawer
    id="cart-drawer"
    data-skip-node-update
  >
    <dialog
      ref="panel"
      class="theme-drawer__dialog color-custom-drawer dpc__dialog"
      aria-labelledby="cart-drawer-heading"
      cart-summary-sticky="true"
    >
      <cart-drawer-component
        {% if settings.auto_open_cart_drawer and template.name != 'cart' %}
          auto-open
        {% endif %}
      >
        <div class="dpc{% if cart.empty? %} dpc--empty{% endif %}" data-dp-cart>

          <div class="dpc__head">
            <h2 class="dpc__title" id="cart-drawer-heading">Your cart <span class="dpc__count">({{ cart.item_count }})</span></h2>
            <button on:click="#cart-drawer/close" class="dpc__close" type="button" aria-label="{{ 'actions.close' | t }}">
              <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M5 5l10 10M15 5L5 15" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/></svg>
            </button>
          </div>

          {%- if cart.empty? -%}
            <div class="dpc__empty">
              <p class="dpc__empty-title">Your cart is empty</p>
              <a class="dpc__empty-btn" href="{{ all_products[dp_main_handle].url | default: routes.all_products_collection_url }}">Shop the Advent Calendar</a>
            </div>
          {%- else -%}
            <div class="dpc__items">
              {%- for item in cart.items -%}
                <div class="dpc__item">
                  <div class="dpc__thumb">
                    {%- if item.image -%}
                      {{ item.image | image_url: width: 200 | image_tag: loading: 'lazy', alt: item.product.title, width: 100, height: 100 }}
                    {%- endif -%}
                  </div>
                  <div class="dpc__item-body">
                    <p class="dpc__item-title">{{ item.product.title }}</p>
                    {%- if item.variant.title != 'Default Title' and item.variant.title != blank -%}
                      <p class="dpc__item-variant">{{ item.variant.title | capitalize }}</p>
                    {%- endif -%}
                    <p class="dpc__item-qty">Qty {{ item.quantity }}</p>
                  </div>
                  <div class="dpc__item-right">
                    <p class="dpc__item-price">{{ item.final_line_price | money }}</p>
                    <form action="{{ routes.cart_change_url }}" method="post">
                      <input type="hidden" name="line" value="{{ forloop.index }}">
                      <input type="hidden" name="quantity" value="0">
                      <input type="hidden" name="return_to" value="{{ back_url }}?dpcart=1">
                      <button type="submit" class="dpc__remove">Remove</button>
                    </form>
                  </div>
                </div>
              {%- endfor -%}
            </div>

            <div class="dpc__footer">
              <div class="dpc__subtotal"><span>Subtotal</span><span>{{ cart.total_price | money }}</span></div>
              <p class="dpc__note">Taxes calculated at checkout. Shipping is free.</p>
              <form action="{{ routes.cart_url }}" method="post">
                <button type="submit" name="checkout" class="dpc__checkout">Secure checkout</button>
              </form>
            </div>
          {%- endif -%}
        </div>
      </cart-drawer-component>
    </dialog>
  </theme-drawer>

  <script>
    // After a form round-trip (?dpcart=1) open the drawer so the shopper sees the result.
    (function () {
      if (!/[?&]dpcart=1/.test(window.location.search)) return;
      try { history.replaceState(null, '', window.location.pathname); } catch (e) {}
      var tries = 0;
      var timer = setInterval(function () {
        tries++;
        var d = document.getElementById('cart-drawer');
        if (d && typeof d.open === 'function') { d.open(); clearInterval(timer); }
        else if (tries > 40) clearInterval(timer);
      }, 150);
    })();
  </script>

  {% if render_wrapper %}
    </div>
  {% endif %}
{%- endif -%}

{% stylesheet %}
  cart-drawer-component { display: contents; }
  @media screen and (max-width: 989px) {
    #cart-drawer .theme-drawer__dialog { --theme-drawer-width: min(88vw, 430px); border-radius: 22px 0 0 22px; box-shadow: -12px 0 40px rgba(0,0,0,.25); }
  }
  #cart-drawer .theme-drawer__dialog::backdrop { background: rgba(15, 30, 20, .55); }
  .dpc__dialog { --theme-drawer-padding: 0; }
  .dpc { text-align: left; --g: #1F3D2B; --cream: #F7F2E6; --ink: #1a2e1a; --muted: #6B6B5E; --line: #ECE7DA;
    display: flex; flex-direction: column; height: 100%; overflow: hidden; background: #fff; color: var(--ink); font-family: var(--font-body--family, Inter, sans-serif); }
  .dpc *, .dpc *::before, .dpc *::after { box-sizing: border-box; min-width: 0; }
  .dpc__head { display: flex; align-items: center; justify-content: space-between; padding: 22px 22px 10px; }
  .dpc__title { margin: 0; font-size: 28px; font-weight: 900; color: var(--g); line-height: 1; display: flex; align-items: baseline; gap: 8px; }
  .dpc__count { font-size: 15px; font-weight: 700; color: var(--muted); }
  .dpc__close { width: 44px; height: 44px; border: 0; border-radius: 50%; background: var(--cream); color: var(--g); display: inline-flex; align-items: center; justify-content: center; cursor: pointer; }
  .dpc__close svg { width: 18px; height: 18px; }
  .dpc__items { flex: 1; overflow-y: auto; padding: 0 22px; }
  .dpc__item { display: grid; grid-template-columns: 70px 1fr auto; gap: 14px; align-items: start; padding: 16px 0; border-bottom: 1px solid var(--line); }
  .dpc__thumb { width: 70px; height: 70px; border-radius: 12px; background: var(--cream); overflow: hidden; }
  .dpc__thumb img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .dpc__item-title { margin: 0 0 2px; font-size: 15px; font-weight: 700; line-height: 1.25; }
  .dpc__item-variant, .dpc__item-qty { margin: 0 0 4px; font-size: 13px; color: var(--muted); }
  .dpc__item-right { display: flex; flex-direction: column; align-items: flex-end; gap: 6px; }
  .dpc__item-price { margin: 0; font-size: 16px; font-weight: 800; }
  .dpc__remove { border: 0; background: none; padding: 0; font: inherit; font-size: 13px; color: #8a8a7c; text-decoration: underline; cursor: pointer; }
  .dpc__footer { padding: 14px 22px calc(18px + env(safe-area-inset-bottom)); border-top: 1px solid var(--line); background: #fff; }
  .dpc__subtotal { display: flex; justify-content: space-between; font-size: 19px; font-weight: 800; color: var(--g); }
  .dpc__note { margin: 6px 0 12px; font-size: 13px; color: var(--muted); }
  .dpc__checkout { width: 100%; border: 0; border-radius: 999px; background: var(--g); color: #fff; font: inherit; font-size: 17px; font-weight: 800; padding: 17px; cursor: pointer; }
  .dpc__empty { flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; padding: 30px 22px; gap: 12px; }
  .dpc__empty-title { margin: 0; font-size: 20px; font-weight: 800; color: var(--g); }
  .dpc__empty-btn { display: inline-block; background: var(--g); color: #fff; font-weight: 800; padding: 14px 24px; border-radius: 999px; text-decoration: none; }
{% endstylesheet %}
