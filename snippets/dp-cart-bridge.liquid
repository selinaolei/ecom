{%- comment -%}
  Dear Paws cart bridge. Rendered once from layout/theme.liquid, outside every section that
  gets re-rendered, so it is always present.

  Every cart change is a fetch() to Shopify's cart JSON endpoints. The page never navigates.
  On success the drawer section is re-fetched through the Section Rendering API and its markup
  swapped into the open drawer. No iframe, no page reload.
{%- endcomment -%}
<script>
  (function () {
    if (window.dpCartSubmit) return;

    var SECTION = 'cart-drawer-section';

    function wrap() { return document.querySelector('[data-dp-cart]'); }

    function sectionUrl() {
      var u = new URL(window.location.href);
      u.searchParams.set('section_id', SECTION);
      u.searchParams.set('dpts', String(Date.now()));
      return u.pathname + u.search;
    }

    function openDrawer() {
      var d = document.getElementById('cart-drawer');
      if (!d) return;
      if (typeof d.open === 'function') { if (!d.hasAttribute('open')) d.open(); return; }
      var dlg = d.querySelector('dialog');
      if (dlg && !dlg.open && dlg.showModal) dlg.showModal();
    }

    function busy(on) {
      var w = wrap();
      if (w) w.classList.toggle('is-busy', !!on);
      document.querySelectorAll('[data-dp-atc]').forEach(function (b) {
        b.classList.toggle('is-loading', !!on);
        b.disabled = !!on;
      });
    }

    function syncHeader(cart) {
      document.querySelectorAll('.cart-bubble__text, [data-cart-count]').forEach(function (el) {
        el.textContent = String(cart.item_count);
      });
      try {
        import('@shopify/events').then(function (ev) {
          var d = ev.CartLinesUpdateEvent.createPromise();
          document.dispatchEvent(new ev.CartLinesUpdateEvent({ action: 'update', context: 'cart', lines: [], promise: d.promise }));
          d.resolve({ cart: ev.CartLinesUpdateEvent.createCartFromAjaxResponse(cart), detail: { items: cart.items, source: 'dp-cart', didError: false } });
        }).catch(function () {});
      } catch (e) {}
    }

    async function renderDrawer() {
      var r = await fetch(sectionUrl(), { credentials: 'same-origin', cache: 'no-store' });
      var html = await r.text();
      var doc = new DOMParser().parseFromString(html, 'text/html');
      var fresh = doc.querySelector('[data-dp-cart]');
      var current = wrap();
      if (fresh && current) {
        current.innerHTML = fresh.innerHTML;
        current.className = fresh.className;
        current.setAttribute('data-count', fresh.getAttribute('data-count') || '0');
      }
    }

    window.dpCartRender = renderDrawer;

    /**
     * Sends a cart form as a fetch() to its own action (a cart JSON endpoint), then refreshes
     * and opens the drawer. Falls back to a real form submit only if the fetch itself fails
     * (offline, endpoint unreachable) so the shopper is never stuck.
     * @param {HTMLFormElement} form
     */
    window.dpCartSubmit = async function (form) {
      var action = form.getAttribute('action') || '/cart/add';
      if (action.indexOf('.js') === -1) action = action.replace(/[?#].*$/, '') + '.js';
      var body = new FormData(form);
      body.delete('return_to');

      busy(true);
      try {
        var res = await fetch(action, {
          method: (form.getAttribute('method') || 'post').toUpperCase(),
          body: body,
          credentials: 'same-origin',
          headers: { Accept: 'application/json' },
        });
        if (!res.ok) throw new Error('Cart request failed (' + res.status + ')');
        var cart = await fetch('{{ routes.cart_url }}.js', { headers: { Accept: 'application/json' }, credentials: 'same-origin', cache: 'no-store' }).then(function (r) { return r.json(); });

        await renderDrawer();
        openDrawer();
        syncHeader(cart);
        if (typeof window.dpCartGuardCheck === 'function') setTimeout(window.dpCartGuardCheck, 300);
      } catch (e) {
        // Fetch itself failed (offline, blocked): fall back to a real page load so the
        // shopper's action still goes through.
        form.submit();
        return;
      } finally {
        busy(false);
      }
    };

    window.dpCartOpen = openDrawer;

    // Any form marked data-dp-cart-form goes through fetch instead of a real navigation.
    document.addEventListener('submit', function (e) {
      var form = e.target;
      if (!(form instanceof HTMLFormElement)) return;
      if (!form.hasAttribute('data-dp-cart-form')) return;
      e.preventDefault();
      window.dpCartSubmit(form);
    }, true);
  })();
</script>
