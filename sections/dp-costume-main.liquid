{%- comment -%}
  Dear Paws – Costume product hero
  Same gallery/price/feature/add-on/sticky-bar patterns as dp-product-main.liquid, but the
  calendar's bundle-tier system is replaced with a simple Color swatch + Size button picker
  since this is a single apparel item, not a quantity-discounted bundle.
{%- endcomment -%}
{%- liquid
  assign product = section.settings.product | default: product
  assign current_variant = product.selected_or_first_available_variant
  assign media_list = product.media
  assign features = section.blocks | where: 'type', 'feature'
  assign addons = section.blocks | where: 'type', 'addon'
  assign trusts = section.blocks | where: 'type', 'trust'

  assign color_option = product.options_with_values | where: 'name', 'Color' | first
  assign size_option = product.options_with_values | where: 'name', 'Size' | first
-%}

<section class="dpm" id="dp-product-{{ section.id }}" data-dp-costume>
  <div class="dpm__inner">

    {%- comment -%} ===== GALLERY ===== {%- endcomment -%}
    <div class="dpm__gallery">
      <div class="dpm__main">
        {%- if section.settings.badge_text != blank -%}
          <span class="dpm__badge">{{ section.settings.badge_text }}</span>
        {%- endif -%}
        {%- if media_list.size > 0 -%}
          {%- assign first = media_list.first -%}
          <img
            data-dp-main-image
            src="{{ first | image_url: width: 1000 }}"
            srcset="{{ first | image_url: width: 600 }} 600w, {{ first | image_url: width: 1000 }} 1000w, {{ first | image_url: width: 1400 }} 1400w"
            sizes="(min-width: 990px) 560px, 100vw"
            width="1000" height="1000"
            alt="{{ first.alt | default: product.title | escape }}"
            fetchpriority="high"
          >
        {%- else -%}
          {{ 'product-1' | placeholder_svg_tag: 'dpm__placeholder' }}
        {%- endif -%}
        {%- if media_list.size > 1 -%}
          <button type="button" class="dpm__arrow dpm__arrow--prev" data-dp-prev aria-label="Previous image">&#8249;</button>
          <button type="button" class="dpm__arrow dpm__arrow--next" data-dp-next aria-label="Next image">&#8250;</button>
        {%- endif -%}
      </div>
      {%- if media_list.size > 1 -%}
        <div class="dpm__thumbs" role="list">
          {%- for media in media_list -%}
            <button
              type="button"
              role="listitem"
              class="dpm__thumb{% if forloop.first %} is-active{% endif %}"
              data-dp-thumb
              data-src="{{ media | image_url: width: 1000 }}"
              data-srcset="{{ media | image_url: width: 600 }} 600w, {{ media | image_url: width: 1000 }} 1000w, {{ media | image_url: width: 1400 }} 1400w"
              data-alt="{{ media.alt | default: product.title | escape }}"
              aria-label="Show image {{ forloop.index }}"
            >
              <img src="{{ media | image_url: width: 160 }}" width="80" height="80" loading="lazy" alt="">
            </button>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

    {%- comment -%} ===== DETAILS ===== {%- endcomment -%}
    <div class="dpm__details">

      {%- if section.settings.eyebrow != blank -%}
        <span class="dpm__eyebrow">{{ section.settings.eyebrow }}</span>
      {%- endif -%}

      <h1 class="dpm__title">{{ section.settings.title_override | default: product.title }}</h1>

      <a class="dpm__rating" href="{{ section.settings.reviews_anchor | default: '#shopify-section-dp_reviews' }}" aria-label="Read customer reviews">
        <span class="dpm__stars" aria-hidden="true">
          {%- for i in (1..5) -%}
            <svg viewBox="0 0 20 20"><path d="M10 1.5l2.6 5.4 5.9.8-4.3 4.1 1.1 5.9L10 14.9l-5.3 2.8 1.1-5.9L1.5 7.7l5.9-.8z"/></svg>
          {%- endfor -%}
        </span>
        <span class="dpm__rating-text">{{ section.settings.rating_text }}</span>
        <span class="dpm__rating-arrow" aria-hidden="true">&rsaquo;</span>
      </a>

      <div class="dpm__price">
        <span class="dpm__price-now" data-dp-price-now>{{ current_variant.price | money }}</span>
        <s class="dpm__price-was" data-dp-price-was {% unless current_variant.compare_at_price > current_variant.price %}hidden{% endunless %}>{{ current_variant.compare_at_price | money }}</s>
        <span class="dpm__pill" data-dp-price-pill {% unless current_variant.compare_at_price > current_variant.price %}hidden{% endunless %}></span>
      </div>

      {%- comment -%} Feature rows, one per line, each with its own icon {%- endcomment -%}
      {%- if features.size > 0 -%}
        <ul class="dpm__features">
          {%- for block in features -%}
            <li {{ block.shopify_attributes }}>
              <span class="dpm__feature-icon" aria-hidden="true">
                {%- case block.settings.icon -%}
                  {%- when 'gift' -%}<svg viewBox="0 0 24 24"><rect x="3" y="8" width="18" height="4"/><path d="M5 12v8h14v-8M12 8v12M12 8c-2-4-6-3-5-1s5 1 5 1zm0 0c2-4 6-3 5-1s-5 1-5 1z"/></svg>
                  {%- when 'paw' -%}<svg viewBox="0 0 24 24"><ellipse cx="12" cy="15.5" rx="4.2" ry="3.4"/><circle cx="6.2" cy="10.5" r="1.9"/><circle cx="9.6" cy="6.8" r="1.9"/><circle cx="14.4" cy="6.8" r="1.9"/><circle cx="17.8" cy="10.5" r="1.9"/></svg>
                  {%- when 'calendar' -%}<svg viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M3 10h18M8 3v4M16 3v4"/><path d="M8 14h3v3H8z"/></svg>
                  {%- when 'truck' -%}<svg viewBox="0 0 24 24"><path d="M3 7h11v9H3zM14 10h4l3 3v3h-7z"/><circle cx="7" cy="17.5" r="1.8"/><circle cx="17" cy="17.5" r="1.8"/></svg>
                  {%- when 'shield' -%}<svg viewBox="0 0 24 24"><path d="M12 3l7 3v5c0 5-3.5 8.5-7 10-3.5-1.5-7-5-7-10V6z"/><path d="M9 12l2 2 4-4"/></svg>
                  {%- when 'heart' -%}<svg viewBox="0 0 24 24"><path d="M12 20s-7-4.5-7-10a4 4 0 0 1 7-2.5A4 4 0 0 1 19 10c0 5.5-7 10-7 10z"/></svg>
                  {%- when 'sparkle' -%}<svg viewBox="0 0 24 24"><path d="M12 3l2 5 5 2-5 2-2 5-2-5-5-2 5-2zM19 15l.8 2 2 .8-2 .8-.8 2-.8-2-2-.8 2-.8z"/></svg>
                  {%- when 'bone' -%}<svg viewBox="0 0 24 24"><path d="M6.5 8.5a2.5 2.5 0 1 1 2.5-3 2.5 2.5 0 1 1 3 2.5l-.5.5 4.5 4.5.5-.5a2.5 2.5 0 1 1 3 2.5 2.5 2.5 0 1 1-2.5 3 2.5 2.5 0 1 1-3-2.5l.5-.5L9 10.5l-.5.5a2.5 2.5 0 1 1-2-2.5z"/></svg>
                  {%- when 'leaf' -%}<svg viewBox="0 0 24 24"><path d="M4 20C6 10 12 4 20 4c0 8-6 14-16 16z"/><path d="M4 20l8-8"/></svg>
                  {%- else -%}<svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M8 12.5l2.5 2.5L16 9.5"/></svg>
                {%- endcase -%}
              </span>
              <span>{{ block.settings.text }}</span>
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}

      {%- comment -%} ===== VARIANT PICKER: Color + Size ===== {%- endcomment -%}
      <div class="dpm__variants">
        {%- if color_option -%}
          <div class="dpm__opt-group">
            <p class="dpm__opt-label">Color: <span data-dp-color-label>{{ current_variant.option1 }}</span></p>
            <div class="dpm__swatches" role="radiogroup" aria-label="Color">
              {%- for value in color_option.values -%}
                <button
                  type="button"
                  class="dpm__swatch{% if value == current_variant.option1 %} is-active{% endif %}"
                  data-dp-color="{{ value | escape }}"
                  style="--swatch-color: {% if value == 'Red' %}#B3272C{% elsif value == 'Green' %}#1F3D2B{% else %}#ccc{% endif %};"
                  role="radio"
                  aria-checked="{% if value == current_variant.option1 %}true{% else %}false{% endif %}"
                  aria-label="{{ value }}"
                ></button>
              {%- endfor -%}
            </div>
          </div>
        {%- endif -%}

        {%- if size_option -%}
          <div class="dpm__opt-group">
            <p class="dpm__opt-label">Size: <span data-dp-size-label>{{ current_variant.option2 }}</span></p>
            <div class="dpm__sizes" role="radiogroup" aria-label="Size">
              {%- for value in size_option.values -%}
                <button
                  type="button"
                  class="dpm__size-btn{% if value == current_variant.option2 %} is-active{% endif %}"
                  data-dp-size="{{ value | escape }}"
                  role="radio"
                  aria-checked="{% if value == current_variant.option2 %}true{% else %}false{% endif %}"
                >{{ value }}</button>
              {%- endfor -%}
            </div>
            {%- if section.settings.size_guide_text != blank -%}
              <p class="dpm__size-guide">{{ section.settings.size_guide_text }}</p>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>

      {%- comment -%} ===== ADD-ONS ===== {%- endcomment -%}
      {%- if addons.size > 0 -%}
        <div class="dpm__bundle">
          <p class="dpm__label dpm__label--center"><span>{{ section.settings.addons_heading }}</span></p>
          <div class="dpm__addons">
            {%- for ab in addons -%}
              {%- assign aidx = forloop.index0 -%}
              {%- assign ap = ab.settings.product -%}
              {%- assign av = ap.selected_or_first_available_variant -%}
              <label class="dpm__addon{% if ab.settings.default_on %} is-on{% endif %}" data-dp-addon="{{ aidx }}">
                <input type="checkbox" class="dpm__check-input" data-dp-addon-input="{{ aidx }}" {% if ab.settings.default_on %}checked{% endif %} {% unless av %}disabled{% endunless %} aria-label="Add {{ ab.settings.title | default: ap.title | escape }}">
                <span class="dpm__checkbox" aria-hidden="true"><svg viewBox="0 0 20 20"><path d="M4 10.5l4 4 8-9" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
                <span class="dpm__addon-img">
                  {%- if ab.settings.image != blank -%}
                    {{ ab.settings.image | image_url: width: 120 | image_tag: loading: 'lazy', alt: ab.settings.title }}
                  {%- elsif ab.settings.icon != blank -%}
                    <img src="{{ ab.settings.icon | asset_url }}" width="60" height="60" loading="lazy" alt="">
                  {%- elsif ap.featured_media -%}
                    {{ ap.featured_media | image_url: width: 120 | image_tag: loading: 'lazy', alt: ab.settings.title }}
                  {%- endif -%}
                </span>
                <span class="dpm__addon-title">{{ ab.settings.title | default: ap.title }}</span>
                <span class="dpm__addon-price">{%- if av -%}{{ av.price | money }}{%- else -%}<em>Pick product</em>{%- endif -%}</span>
              </label>
            {%- endfor -%}
          </div>
        </div>
      {%- endif -%}

      {%- comment -%} ===== ADD TO CART ===== {%- endcomment -%}
      <div class="dpm__buy">
        <button type="button" class="dpm__atc" data-dp-atc {% unless current_variant.available %}disabled{% endunless %}>
          <span class="dpm__atc-label" data-dp-btn-label>{{ section.settings.button_text }}</span>
          <span class="dpm__atc-spinner" aria-hidden="true"></span>
        </button>
        {%- if section.settings.button_subtext != blank -%}
          <p class="dpm__atc-sub"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 7h11v9H3zM14 10h4l3 3v3h-7z"/><circle cx="7" cy="17.5" r="1.8"/><circle cx="17" cy="17.5" r="1.8"/></svg>{{ section.settings.button_subtext }}</p>
        {%- endif -%}
        <p class="dpm__error" data-dp-error hidden role="alert"></p>
        <ul class="dpm__guarantees" aria-label="Guarantees">
          <li><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3l7 3v5c0 5-3.5 8.5-7 10-3.5-1.5-7-5-7-10V6z"/><path d="M9 12l2 2 4-4"/></svg>30-day guarantee</li>
          <li><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="5" y="10" width="14" height="10" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/></svg>Secure checkout</li>
          <li><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="8" width="18" height="4"/><path d="M5 12v8h14v-8M12 8v12"/></svg>Gift-ready box</li>
        </ul>
      </div>

      {%- if section.settings.show_payment_icons -%}
        <div class="dpm__payments" aria-label="Accepted payment methods">
          {%- for type in shop.enabled_payment_types -%}
            {{ type | payment_type_svg_tag: class: 'dpm__payment-icon' }}
          {%- endfor -%}
        </div>
      {%- endif -%}

      {%- if trusts.size > 0 -%}
        <ul class="dpm__trust">
          {%- for block in trusts -%}
            <li {{ block.shopify_attributes }}>
              <span class="dpm__trust-icon" aria-hidden="true">
                {%- case block.settings.icon -%}
                  {%- when 'truck' -%}<svg viewBox="0 0 24 24"><path d="M3 7h11v9H3zM14 10h4l3 3v3h-7z"/><circle cx="7" cy="17.5" r="1.8"/><circle cx="17" cy="17.5" r="1.8"/></svg>
                  {%- when 'lock' -%}<svg viewBox="0 0 24 24"><rect x="5" y="10" width="14" height="10" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/></svg>
                  {%- when 'gift' -%}<svg viewBox="0 0 24 24"><rect x="3" y="8" width="18" height="4"/><path d="M5 12v8h14v-8M12 8v12M12 8c-2-4-6-3-5-1s5 1 5 1zm0 0c2-4 6-3 5-1s-5 1-5 1z"/></svg>
                  {%- when 'heart' -%}<svg viewBox="0 0 24 24"><path d="M12 20s-7-4.5-7-10a4 4 0 0 1 7-2.5A4 4 0 0 1 19 10c0 5.5-7 10-7 10z"/></svg>
                  {%- when 'leaf' -%}<svg viewBox="0 0 24 24"><path d="M4 20C6 10 12 4 20 4c0 8-6 14-16 16z"/><path d="M4 20l8-8"/></svg>
                  {%- else -%}<svg viewBox="0 0 24 24"><path d="M12 3l7 3v5c0 5-3.5 8.5-7 10-3.5-1.5-7-5-7-10V6z"/><path d="M9 12l2 2 4-4"/></svg>
                {%- endcase -%}
              </span>
              <span>{{ block.settings.text }}</span>
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}

      {%- if section.settings.show_description and product.description != blank -%}
        <details class="dpm__desc">
          <summary>{{ section.settings.description_label }}</summary>
          <div class="dpm__desc-body rte">{{ product.description }}</div>
        </details>
      {%- endif -%}
    </div>
  </div>

  {%- if section.settings.sticky_bar -%}
    <div class="dpm__sticky" data-dp-sticky>
      <div class="dpm__sticky-inner">
        {%- if product.featured_media -%}<img src="{{ product.featured_media | image_url: width: 100 }}" width="48" height="48" alt="" loading="lazy" data-dp-sticky-img>{%- endif -%}
        <div class="dpm__sticky-meta">
          <strong>{{ product.title }}</strong>
          <span><s data-dp-sticky-was hidden></s> <b data-dp-sticky-total></b></span>
        </div>
        <button type="button" class="dpm__sticky-btn" data-dp-sticky-atc>{{ section.settings.button_text }}</button>
      </div>
    </div>
  {%- endif -%}

  <script type="application/json" data-dp-config>
    {
      "productId": {{ product.id | json }},
      "selectedVariantId": {{ current_variant.id | json }},
      "moneyFormat": {{ shop.money_format | json }},
      "variants": [
        {%- for variant in product.variants -%}
          {%- assign img_index = -1 -%}
          {%- if variant.featured_media -%}
            {%- for media in media_list -%}
              {%- if media.id == variant.featured_media.id -%}{%- assign img_index = forloop.index0 -%}{%- endif -%}
            {%- endfor -%}
          {%- endif -%}
          { "id": {{ variant.id | json }}, "title": {{ variant.title | json }}, "option1": {{ variant.option1 | json }}, "option2": {{ variant.option2 | json }}, "price": {{ variant.price | json }}, "compareAtPrice": {{ variant.compare_at_price | default: 0 | json }}, "available": {{ variant.available | json }}, "imageIndex": {{ img_index }} }{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ],
      "addons": [
        {%- for block in addons -%}
          {%- assign ap = block.settings.product -%}
          {%- assign av = ap.selected_or_first_available_variant -%}
          { "variantId": {{ av.id | default: null | json }}, "price": {{ av.price | default: 0 | json }}, "defaultOn": {{ block.settings.default_on | json }} }{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ],
      "text": {
        "addToCart": {{ section.settings.button_text | json }},
        "soldOut": "Sold out",
        "save": "Save",
        "savePct": "SAVE {pct}%"
      }
    }
  </script>
</section>

<script type="module" src="{{ 'dp-costume.js' | asset_url }}"></script>

{% stylesheet %}
  .dpm { --dp-forest: #1F3D2B; --dp-forest-2: #2D4A2D; --dp-gold: #C9A96E; --dp-gold-light: #E8D5A0; --dp-cream: #F7F2E6; --dp-ink: #1a2e1a; --dp-muted: #6B6B5E; --dp-line: #E4DCC8; --dp-radius: 14px;
    background: #fff; color: var(--dp-ink); font-family: var(--font-body--family, Inter, sans-serif); padding: 12px 0 40px; width: 100%; max-width: 100%; overflow-x: clip; }
  .dpm *, .dpm *::before, .dpm *::after { box-sizing: border-box; min-width: 0; }
  html { scroll-behavior: smooth; }
  body { overflow-x: clip; }
  .dp-section, .shopify-section:has(> .dp-section) { max-width: 100%; overflow-x: clip; }
  [id^="shopify-section-dp_"] { scroll-margin-top: 90px; }
  .dpm__inner { max-width: 1200px; margin: 0 auto; padding: 0 16px; display: grid; gap: 22px; }
  @media (min-width: 990px) {
    .dpm { padding: 32px 0 64px; }
    .dpm__inner { grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr); gap: 56px; align-items: start; padding: 0 32px; }
    .dpm__gallery { position: sticky; top: 90px; }
  }

  /* gallery */
  .dpm__main { position: relative; aspect-ratio: 1 / 1; border-radius: var(--dp-radius); overflow: hidden; background: var(--dp-cream); }
  .dpm__main img, .dpm__placeholder { width: 100%; height: 100%; object-fit: cover; display: block; }
  .dpm__badge { position: absolute; top: 14px; left: 14px; z-index: 2; background: var(--dp-forest); color: var(--dp-gold-light); font-size: 11px; font-weight: 700; letter-spacing: 1.6px; text-transform: uppercase; padding: 7px 12px; border-radius: 999px; }
  .dpm__arrow { position: absolute; top: 50%; transform: translateY(-50%); width: 40px; height: 40px; border-radius: 50%; border: 0; background: rgba(255,255,255,.92); color: var(--dp-forest); font-size: 26px; line-height: 1; cursor: pointer; box-shadow: 0 4px 14px rgba(0,0,0,.12); display: flex; align-items: center; justify-content: center; }
  .dpm__arrow--prev { left: 12px; } .dpm__arrow--next { right: 12px; }
  .dpm__thumbs { display: flex; gap: 8px; margin-top: 10px; overflow-x: auto; scrollbar-width: none; padding-bottom: 4px; }
  .dpm__thumbs::-webkit-scrollbar { display: none; }
  .dpm__thumb { flex: 0 0 auto; width: 68px; height: 68px; padding: 0; border-radius: 10px; overflow: hidden; border: 2px solid transparent; background: var(--dp-cream); cursor: pointer; opacity: .75; transition: .2s; }
  .dpm__thumb img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .dpm__thumb.is-active { border-color: var(--dp-forest); opacity: 1; }

  /* details */
  .dpm__eyebrow { display: inline-block; font-size: 11px; font-weight: 700; letter-spacing: 2.5px; text-transform: uppercase; color: var(--dp-gold); margin-bottom: 8px; }
  .dpm__title { font-family: var(--font-heading--family, inherit); font-size: clamp(28px, 4.5vw, 40px); font-weight: 800; line-height: 1.1; letter-spacing: -0.5px; margin: 0 0 10px; color: var(--dp-forest); }
  .dpm__rating { display: inline-flex; align-items: center; gap: 8px; margin-bottom: 12px; text-decoration: none; color: inherit; border-bottom: 1px dashed var(--dp-gold); padding-bottom: 2px; }
  .dpm__rating:hover .dpm__rating-text { color: var(--dp-forest); text-decoration: underline; }
  .dpm__rating-arrow { color: var(--dp-gold); font-size: 20px; line-height: 1; }
  .dpm__stars { display: inline-flex; gap: 2px; }
  .dpm__stars svg { width: 16px; height: 16px; fill: var(--dp-gold); }
  .dpm__rating-text { font-size: 13px; font-weight: 600; color: var(--dp-ink); }
  .dpm__price { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; margin-bottom: 16px; }
  .dpm__price-now { font-size: 30px; font-weight: 800; color: var(--dp-forest); letter-spacing: -0.5px; }
  .dpm__price-was { font-size: 18px; color: #9a9a8c; }
  .dpm__pill { background: var(--dp-gold); color: var(--dp-forest); font-size: 11px; font-weight: 800; letter-spacing: 1px; padding: 5px 10px; border-radius: 999px; }
  @media (max-width: 749px) { .dpm__title { font-size: 26px; } .dpm__price-now { font-size: 26px; } .dpm__price-was { font-size: 16px; } }

  /* feature rows */
  .dpm__features { list-style: none; margin: 0 0 22px; padding: 0; display: grid; gap: 10px; }
  .dpm__features li { display: flex; gap: 12px; align-items: center; font-size: 14px; font-weight: 600; line-height: 1.4; }
  .dpm__feature-icon { flex: 0 0 34px; width: 34px; height: 34px; border-radius: 50%; background: var(--dp-cream); border: 1px solid var(--dp-line); display: inline-flex; align-items: center; justify-content: center; }
  .dpm__feature-icon svg { width: 17px; height: 17px; fill: none; stroke: var(--dp-forest); stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }

  .dpm__label { font-size: 12px; font-weight: 700; letter-spacing: 1.8px; text-transform: uppercase; color: var(--dp-ink); margin: 0 0 12px; }
  .dpm__label--center { text-align: center; position: relative; }
  .dpm__label--center::before { content: ""; position: absolute; left: 0; right: 0; top: 50%; height: 1px; background: var(--dp-line); }
  .dpm__label--center span { position: relative; background: #fff; padding: 0 12px; }

  /* variant picker */
  .dpm__variants { margin-bottom: 18px; display: grid; gap: 16px; }
  .dpm__opt-label { font-size: 13px; font-weight: 700; margin: 0 0 8px; }
  .dpm__opt-label span { font-weight: 800; color: var(--dp-forest); }
  .dpm__swatches { display: flex; gap: 10px; }
  .dpm__swatch { width: 38px; height: 38px; border-radius: 50%; border: 2px solid transparent; padding: 3px; cursor: pointer; background: #fff; box-shadow: 0 0 0 1.5px var(--dp-line); position: relative; }
  .dpm__swatch::before { content: ""; position: absolute; inset: 5px; border-radius: 50%; background: var(--swatch-color); }
  .dpm__swatch.is-active { box-shadow: 0 0 0 2px var(--dp-forest); }
  .dpm__sizes { display: flex; gap: 8px; flex-wrap: wrap; }
  .dpm__size-btn { min-width: 56px; padding: 10px 16px; border-radius: 999px; border: 1.5px solid var(--dp-line); background: #fff; font: inherit; font-size: 13px; font-weight: 700; color: var(--dp-ink); cursor: pointer; transition: .15s; }
  .dpm__size-btn:hover { border-color: var(--dp-gold); }
  .dpm__size-btn.is-active { border-color: var(--dp-forest); background: var(--dp-forest); color: #fff; }
  .dpm__size-guide { margin: 8px 0 0; font-size: 12px; color: var(--dp-muted); }

  /* add-on rows */
  .dpm__bundle { margin-bottom: 18px; }
  .dpm__addons { display: grid; gap: 6px; }
  .dpm__addon { display: grid; grid-template-columns: 22px 30px 1fr auto; gap: 10px; align-items: center; padding: 7px 10px; border: 1px solid var(--dp-line); border-radius: 10px; background: #fff; cursor: pointer; transition: .15s; }
  .dpm__addon.is-on { border-color: var(--dp-forest); background: #FBF8F0; }
  .dpm__check-input { position: absolute; opacity: 0; width: 0; height: 0; }
  .dpm__checkbox { width: 22px; height: 22px; border-radius: 6px; border: 2px solid #c9c4b3; background: #fff; display: inline-flex; align-items: center; justify-content: center; color: #fff; transition: .15s; }
  .dpm__checkbox svg { width: 14px; height: 14px; opacity: 0; transform: scale(.6); transition: .15s; }
  .dpm__check-input:checked + .dpm__checkbox { background: var(--dp-forest); border-color: var(--dp-forest); }
  .dpm__check-input:checked + .dpm__checkbox svg { opacity: 1; transform: scale(1); }
  .dpm__check-input:focus-visible + .dpm__checkbox { outline: 2px solid var(--dp-gold); outline-offset: 2px; }
  .dpm__check-input:disabled + .dpm__checkbox { opacity: .4; }
  .dpm__addon-img { width: 30px; height: 30px; border-radius: 7px; overflow: hidden; background: var(--dp-cream); }
  .dpm__addon-img img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .dpm__addon-title { font-size: 13px; font-weight: 600; line-height: 1.2; }
  .dpm__addon-price { font-size: 13px; font-weight: 700; color: var(--dp-forest); }
  .dpm__addon-price em { font-style: normal; font-size: 11px; color: #b0483a; }

  /* add to cart */
  .dpm__buy { margin-top: 4px; }
  .dpm__atc { position: relative; width: 100%; display: flex; align-items: center; justify-content: center; padding: 18px 20px; border: 0; border-radius: var(--dp-radius); background: linear-gradient(135deg, #2F5A3D 0%, #1F3D2B 60%, #16301F 100%); color: #fff; font: inherit; font-size: 17px; font-weight: 800; letter-spacing: .4px; text-transform: uppercase; cursor: pointer; transition: .15s; box-shadow: 0 12px 28px rgba(31,61,43,.32), inset 0 0 0 1.5px rgba(201,169,110,.55); animation: dpm-pulse 2.4s ease-in-out infinite; }
  .dpm__atc:hover { transform: translateY(-1px); box-shadow: 0 14px 30px rgba(31,61,43,.4), inset 0 0 0 1.5px var(--dp-gold); animation: none; }
  .dpm__atc:disabled { background: #b9b5a8; box-shadow: none; cursor: not-allowed; animation: none; }
  @keyframes dpm-pulse { 0%, 100% { box-shadow: 0 12px 28px rgba(31,61,43,.32), inset 0 0 0 1.5px rgba(201,169,110,.55), 0 0 0 0 rgba(201,169,110,.45); } 50% { box-shadow: 0 12px 28px rgba(31,61,43,.32), inset 0 0 0 1.5px rgba(201,169,110,.55), 0 0 0 8px rgba(201,169,110,0); } }
  @media (prefers-reduced-motion: reduce) { .dpm__atc { animation: none; } }
  .dpm__atc-spinner { display: none; position: absolute; right: 20px; top: 50%; width: 18px; height: 18px; margin-top: -9px; border: 2px solid rgba(255,255,255,.35); border-top-color: #fff; border-radius: 50%; animation: dpm-spin .7s linear infinite; }
  .dpm__atc.is-loading .dpm__atc-spinner { display: block; }
  .dpm__atc.is-added .dpm__atc-label::after { content: " \2713"; }
  @keyframes dpm-spin { to { transform: rotate(360deg); } }
  .dpm__atc-sub { display: flex; align-items: center; justify-content: center; gap: 6px; margin: 10px 0 0; font-size: 12px; font-weight: 600; color: var(--dp-forest); }
  .dpm__atc-sub svg { width: 16px; height: 16px; fill: none; stroke: var(--dp-forest); stroke-width: 1.7; stroke-linecap: round; stroke-linejoin: round; }
  .dpm__error { color: #b0483a; font-size: 13px; margin: 8px 0 0; text-align: center; }
  .dpm__guarantees { list-style: none; margin: 12px 0 0; padding: 0; display: flex; justify-content: center; flex-wrap: wrap; gap: 6px 14px; font-size: 11px; font-weight: 600; color: var(--dp-muted); }
  .dpm__guarantees li { display: inline-flex; align-items: center; gap: 5px; }
  .dpm__guarantees svg { width: 14px; height: 14px; fill: none; stroke: var(--dp-gold); stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }

  .dpm__payments { display: flex; flex-wrap: wrap; justify-content: center; gap: 6px; margin: 14px 0 4px; }
  .dpm__payment-icon { width: 38px; height: 24px; border-radius: 4px; }

  .dpm__trust { list-style: none; margin: 16px 0 0; padding: 14px 0 0; border-top: 1px solid var(--dp-line); display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px 16px; }
  .dpm__trust li { display: flex; align-items: center; gap: 10px; font-size: 13px; font-weight: 600; }
  .dpm__trust-icon { flex: 0 0 36px; width: 36px; height: 36px; border-radius: 50%; background: var(--dp-cream); display: inline-flex; align-items: center; justify-content: center; }
  .dpm__trust-icon svg { width: 18px; height: 18px; fill: none; stroke: var(--dp-forest); stroke-width: 1.7; stroke-linecap: round; stroke-linejoin: round; }

  .dpm__desc { margin-top: 18px; border-top: 1px solid var(--dp-line); border-bottom: 1px solid var(--dp-line); }
  .dpm__desc summary { cursor: pointer; padding: 14px 0; font-weight: 700; font-size: 14px; list-style: none; display: flex; justify-content: space-between; }
  .dpm__desc summary::-webkit-details-marker { display: none; }
  .dpm__desc summary::after { content: "+"; font-size: 18px; color: var(--dp-gold); }
  .dpm__desc[open] summary::after { content: "\2013"; }
  .dpm__desc-body { padding: 0 0 16px; font-size: 14px; line-height: 1.7; color: var(--dp-muted); }

  .dpm__sticky { position: fixed; left: 0; right: 0; bottom: 0; z-index: 40; background: #fff; border-top: 1px solid var(--dp-line); box-shadow: 0 -8px 24px rgba(0,0,0,.08); transform: translateY(110%); transition: transform .25s; padding: 10px 16px calc(10px + env(safe-area-inset-bottom)); }
  .dpm__sticky.is-visible { transform: translateY(0); }
  .dpm__sticky-inner { max-width: 1200px; margin: 0 auto; display: flex; align-items: center; gap: 12px; }
  .dpm__sticky img { width: 44px; height: 44px; border-radius: 8px; object-fit: cover; }
  .dpm__sticky-meta { flex: 1; min-width: 0; display: flex; flex-direction: column; font-size: 13px; }
  .dpm__sticky-meta strong { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .dpm__sticky-meta span { color: var(--dp-forest); font-weight: 800; }
  .dpm__sticky-meta s { color: #9a9a8c; font-weight: 500; font-size: 12px; margin-right: 3px; }
  .dpm__sticky-btn { border: 0; border-radius: 10px; background: var(--dp-forest); color: #fff; font: inherit; font-weight: 800; font-size: 14px; padding: 12px 18px; cursor: pointer; }
{% endstylesheet %}

{% schema %}
{
  "name": "DP Costume hero",
  "tag": "section",
  "class": "dp-section",
  "settings": [
    { "type": "product", "id": "product", "label": "Product", "info": "Leave empty to use the current page product." },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Limited Christmas Edition" },
    { "type": "text", "id": "title_override", "label": "Title override" },
    { "type": "text", "id": "badge_text", "label": "Image badge", "default": "Holiday best seller" },
    { "type": "text", "id": "rating_text", "label": "Rating text", "default": "Rated 4.9 based on 1,204 reviews" },
    { "type": "text", "id": "reviews_anchor", "label": "Reviews link (anchor)", "default": "#shopify-section-dp_reviews" },
    { "type": "text", "id": "size_guide_text", "label": "Size guide text", "default": "S: 1.5–2.5kg · M: 2.5–5kg · L: 5–7.5kg. Between sizes? Size up for a comfy fit." },
    { "type": "text", "id": "addons_heading", "label": "Add-ons heading", "default": "Protect your order" },
    { "type": "text", "id": "button_text", "label": "Button text", "default": "Add to cart" },
    { "type": "text", "id": "button_subtext", "label": "Text under button", "default": "Order today, ships within 24 hours" },
    { "type": "checkbox", "id": "show_payment_icons", "label": "Show payment icons", "default": true },
    { "type": "checkbox", "id": "show_description", "label": "Show product description accordion", "default": true },
    { "type": "text", "id": "description_label", "label": "Description label", "default": "Details & sizing" },
    { "type": "checkbox", "id": "sticky_bar", "label": "Sticky add-to-cart bar", "default": true }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature row",
      "limit": 4,
      "settings": [
        { "type": "select", "id": "icon", "label": "Icon", "options": [
          { "value": "gift", "label": "Gift" }, { "value": "paw", "label": "Paw" }, { "value": "calendar", "label": "Calendar" },
          { "value": "truck", "label": "Truck" }, { "value": "shield", "label": "Shield" }, { "value": "heart", "label": "Heart" },
          { "value": "sparkle", "label": "Sparkle" }, { "value": "bone", "label": "Bone" }, { "value": "leaf", "label": "Leaf" }, { "value": "check", "label": "Check" }
        ], "default": "gift" },
        { "type": "text", "id": "text", "label": "Text", "default": "Soft, breathable fabric for all-day comfort" }
      ]
    },
    {
      "type": "addon",
      "name": "Add-on product",
      "limit": 4,
      "settings": [
        { "type": "product", "id": "product", "label": "Add-on product" },
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "text", "id": "text", "label": "Description" },
        { "type": "image_picker", "id": "image", "label": "Image (optional override)" },
        { "type": "select", "id": "icon", "label": "Built-in illustration", "options": [
          { "value": "", "label": "None (use product image)" },
          { "value": "dp-addon-shipping.png", "label": "Shipping protection" },
          { "value": "dp-addon-warranty.png", "label": "30-day warranty" }
        ], "default": "" },
        { "type": "checkbox", "id": "default_on", "label": "Selected by default", "default": false }
      ]
    },
    {
      "type": "trust",
      "name": "Trust item",
      "limit": 6,
      "settings": [
        { "type": "select", "id": "icon", "label": "Icon", "options": [
          { "value": "truck", "label": "Truck" }, { "value": "lock", "label": "Lock" }, { "value": "gift", "label": "Gift" },
          { "value": "heart", "label": "Heart" }, { "value": "leaf", "label": "Leaf" }, { "value": "shield", "label": "Shield" }
        ], "default": "truck" },
        { "type": "text", "id": "text", "label": "Text", "default": "Free shipping" }
      ]
    }
  ],
  "presets": [
    {
      "name": "DP Costume hero",
      "blocks": [
        { "type": "feature", "settings": { "icon": "gift", "text": "Soft, breathable fabric for all-day comfort" } },
        { "type": "feature", "settings": { "icon": "paw", "text": "Fits small to large dogs, S to L" } },
        { "type": "feature", "settings": { "icon": "truck", "text": "Free shipping and 30-day guarantee" } },
        { "type": "addon", "settings": { "title": "Shipping protection", "text": "Covers loss, theft or damage in transit", "icon": "dp-addon-shipping.png", "default_on": true } },
        { "type": "addon", "settings": { "title": "30-day warranty", "text": "Replacement if anything arrives damaged", "icon": "dp-addon-warranty.png", "default_on": true } },
        { "type": "trust", "settings": { "icon": "truck", "text": "Free shipping" } },
        { "type": "trust", "settings": { "icon": "lock", "text": "Secure checkout" } },
        { "type": "trust", "settings": { "icon": "shield", "text": "30-day guarantee" } },
        { "type": "trust", "settings": { "icon": "heart", "text": "Loved by 1,000+ dogs" } }
      ]
    }
  ],
  "enabled_on": { "templates": ["product"] }
}
{% endschema %}
