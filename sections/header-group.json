      "settings": {
        "custom_liquid": "<style>\n  .dpg-mar { background: #1F3D2B; overflow: hidden; padding: 11px 0; width: 100%; }\n  .dpg-mar__track { display: flex; width: max-content; animation: dpgmar 28s linear infinite; }\n  .dpg-mar__track:hover { animation-play-state: paused; }\n  .dpg-mar__item { display: flex; align-items: center; gap: 12px; padding: 0 36px; white-space: nowrap; font-family: var(--font-body--family, Inter, sans-serif); font-size: 12px; font-weight: 700; letter-spacing: 2px; text-transform: uppercase; color: #E8D5A0; }\n  .dpg-mar__dot { width: 5px; height: 5px; background: #C9A96E; border-radius: 50%; flex-shrink: 0; }\n  @keyframes dpgmar { 0% { transform: translateX(0); } 100% { transform: translateX(-50%); } }\n</style>\n<div class=\"dpg-mar\" aria-hidden=\"true\">\n  <div class=\"dpg-mar__track\">\n    <span class=\"dpg-mar__item\"><span class=\"dpg-mar__dot\"></span>Free shipping on every order</span>\n    <span class=\"dpg-mar__item\"><span class=\"dpg-mar__dot\"></span>24 days of surprises</span>\n    <span class=\"dpg-mar__item\"><span class=\"dpg-mar__dot\"></span>30-day happiness guarantee</span>\n    <span class=\"dpg-mar__item\"><span class=\"dpg-mar__dot\"></span>Ships from Canada</span>\n    <span class=\"dpg-mar__item\"><span class=\"dpg-mar__dot\"></span>Free shipping on every order</span>\n    <span class=\"dpg-mar__item\"><span class=\"dpg-mar__dot\"></span>24 days of surprises</span>\n    <span class=\"dpg-mar__item\"><span class=\"dpg-mar__dot\"></span>30-day happiness guarantee</span>\n    <span class=\"dpg-mar__item\"><span class=\"dpg-mar__dot\"></span>Ships from Canada</span>\n  </div>\n</div>",
        "background_color": "#1F3D2B",
        "section_width": "full-width",
        "padding-block-start": 0,
        "padding-block-end": 0
      }
    },
