{%- comment -%} Dear Paws – "People keep posting about" UGC photo grid (forest green band) {%- endcomment -%}
<section class="dpu" id="dp-ugc-{{ section.id }}">
  <div class="dpu__inner">
    <div class="dpu__head">
      {%- if section.settings.eyebrow != blank -%}<span class="dpu__eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
      {%- if section.settings.heading != blank -%}<h2 class="dpu__heading">{{ section.settings.heading }}</h2>{%- endif -%}
      {%- if section.settings.text != blank -%}<p class="dpu__text">{{ section.settings.text }}</p>{%- endif -%}
    </div>
    <div class="dpu__grid dpu__grid--{{ section.settings.columns }}">
      {%- for block in section.blocks -%}
        <figure class="dpu__card" {{ block.shopify_attributes }}>
          <div class="dpu__media">
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 800 | image_tag: loading: 'lazy', sizes: '(min-width: 990px) 33vw, 50vw', alt: block.settings.handle }}
            {%- else -%}
              {{ 'lifestyle-1' | placeholder_svg_tag: 'dpu__placeholder' }}
            {%- endif -%}
            <span class="dpu__heart" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M12 21s-8-5-8-11a4.5 4.5 0 0 1 8-2.8A4.5 4.5 0 0 1 20 10c0 6-8 11-8 11z"/></svg></span>
          </div>
          {%- if block.settings.handle != blank or block.settings.caption != blank -%}
            <figcaption>
              {%- if block.settings.handle != blank -%}<strong>{{ block.settings.handle }}</strong>{%- endif -%}
              {%- if block.settings.caption != blank -%}<span>{{ block.settings.caption }}</span>{%- endif -%}
            </figcaption>
          {%- endif -%}
        </figure>
      {%- endfor -%}
    </div>
    {%- if section.settings.button_text != blank -%}
      <div class="dpu__cta">
        <a class="dpu__btn" href="{{ section.settings.button_link | default: '#' }}">{{ section.settings.button_text }}</a>
      </div>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  .dpu { --dp-forest: #1F3D2B; --dp-gold: #C9A96E; --dp-gold-light: #E8D5A0; --dp-cream: #F7F2E6;
    background: var(--dp-forest); color: #fff; padding: 56px 0; font-family: var(--font-body--family, Inter, sans-serif); }
  .dpu *, .dpu *::before, .dpu *::after { box-sizing: border-box; }
  .dpu__inner { max-width: 1200px; margin: 0 auto; padding: 0 16px; }
  .dpu__head { text-align: center; max-width: 640px; margin: 0 auto 28px; }
  .dpu__eyebrow { display: inline-block; font-size: 11px; font-weight: 700; letter-spacing: 2.5px; text-transform: uppercase; color: var(--dp-gold); margin-bottom: 12px; }
  .dpu__heading { font-family: var(--font-heading--family, inherit); font-size: clamp(26px, 4vw, 40px); font-weight: 800; line-height: 1.15; margin: 0 0 10px; color: #fff; }
  .dpu__heading em { font-style: italic; color: var(--dp-gold-light); }
  .dpu__text { font-size: 15px; line-height: 1.6; color: rgba(255,255,255,.8); margin: 0; }
  .dpu__grid { display: grid; gap: 12px; grid-template-columns: repeat(2, minmax(0, 1fr)); }
  @media (min-width: 750px) { .dpu__grid--3 { grid-template-columns: repeat(3, minmax(0, 1fr)); } .dpu__grid--4 { grid-template-columns: repeat(4, minmax(0, 1fr)); } .dpu__grid--2 { grid-template-columns: repeat(2, minmax(0,1fr)); } }
  .dpu__card { margin: 0; background: #fff; border-radius: 14px; overflow: hidden; color: #1a2e1a; box-shadow: 0 10px 30px rgba(0,0,0,.18); }
  .dpu__media { position: relative; aspect-ratio: 1 / 1; background: var(--dp-cream); }
  .dpu__media img, .dpu__placeholder { width: 100%; height: 100%; object-fit: cover; display: block; }
  .dpu__heart { position: absolute; right: 10px; bottom: 10px; width: 30px; height: 30px; border-radius: 50%; background: rgba(255,255,255,.92); display: flex; align-items: center; justify-content: center; }
  .dpu__heart svg { width: 16px; height: 16px; fill: #c8473b; }
  .dpu__card figcaption { padding: 10px 12px 12px; display: flex; flex-direction: column; gap: 2px; }
  .dpu__card figcaption strong { font-size: 13px; font-weight: 800; }
  .dpu__card figcaption span { font-size: 12px; color: #6B6B5E; line-height: 1.4; }
  .dpu__cta { text-align: center; margin-top: 26px; }
  .dpu__btn { display: inline-block; background: var(--dp-gold); color: var(--dp-forest); font-weight: 800; font-size: 14px; padding: 14px 26px; border-radius: 999px; text-decoration: none; transition: .15s; }
  .dpu__btn:hover { background: var(--dp-gold-light); }
{% endstylesheet %}

{% schema %}
{
  "name": "DP Customer photos",
  "tag": "section",
  "class": "dp-section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Real pups. Real mornings." },
    { "type": "text", "id": "heading", "label": "Heading", "default": "People keep posting about Dear Paws" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Tag @dearpaws and show us door number one. We repost our favourites every week." },
    { "type": "select", "id": "columns", "label": "Desktop columns", "options": [ { "value": "2", "label": "2" }, { "value": "3", "label": "3" }, { "value": "4", "label": "4" } ], "default": "3" },
    { "type": "text", "id": "button_text", "label": "Button text", "default": "See more on Instagram" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "blocks": [
    {
      "type": "photo",
      "name": "Photo",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "handle", "label": "Handle", "default": "@happypup" },
        { "type": "text", "id": "caption", "label": "Caption", "default": "Day 1 and he already knows the drill." }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    { "name": "DP Customer photos", "blocks": [
      { "type": "photo", "settings": { "handle": "@luna.the.golden", "caption": "Door 1 opened at 6am. No regrets." } },
      { "type": "photo", "settings": { "handle": "@biscuit_and_co", "caption": "He sits next to it every morning now." } },
      { "type": "photo", "settings": { "handle": "@maxthefrenchie", "caption": "Best Christmas gift we have ever bought him." } },
      { "type": "photo", "settings": { "handle": "@twodoodles", "caption": "Two calendars, zero fights. Worth it." } },
      { "type": "photo", "settings": { "handle": "@rosie.dachshund", "caption": "The squeaky bone from day 4 is her new favourite." } },
      { "type": "photo", "settings": { "handle": "@oliver.lab", "caption": "Under the tree and very much guarded." } }
    ] }
  ]
}
{% endschema %}
