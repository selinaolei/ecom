    "warmwear_faq": {
      "type": "warmwear-faq",
      "settings": {
        "heading": "Everything you need to know"
      },
      "blocks": {
        "q1": {
          "type": "qa",
          "settings": {
            "q": "How does the heating work?",
            "a": "Warm Wear uses carbon fiber heating wires woven throughout the jacket. Connect to any USB power bank, choose between 3 heat settings, and you're instantly warm. The wires distribute heat evenly across your core."
          }
        },
        "q2": {
          "type": "qa",
          "settings": {
            "q": "How long does the battery last?",
            "a": "On the medium setting, a standard 20,000mAh power bank keeps you warm for 8-10 hours. High setting runs 5-6 hours. Low setting can last 12+ hours. The power bank stays in the pocket under the jacket."
          }
        },
        "q3": {
          "type": "qa",
          "settings": {
            "q": "Is it waterproof?",
            "a": "Yes. The carbon fiber heating element is fully waterproof. You can wear it in rain, snow, or sleet. The controller and USB connection are weather-sealed. Keep the power bank dry inside the pocket."
          }
        },
        "q4": {
          "type": "qa",
          "settings": {
            "q": "Can I wash it?",
            "a": "Remove the power bank and controller, then hand wash in cold water with mild soap. Air dry only. Do not machine wash or dry clean. The heating element is built to last through many wash cycles."
          }
        },
        "q5": {
          "type": "qa",
          "settings": {
            "q": "What sizes are available?",
            "a": "Warm Wear comes in XS, S, M, L, XL, and XXL. Check the size chart on our product page. Most customers size up one size for layering room. The detachable hood adjusts for all head sizes."
          }
        },
        "q6": {
          "type": "qa",
          "settings": {
            "q": "What's the 30-day guarantee?",
            "a": "If you're not completely satisfied for any reason, return it within 30 days for a full refund. No questions asked. Plus, every jacket comes with a one-year warranty on heating elements."
          }
        }
      },
