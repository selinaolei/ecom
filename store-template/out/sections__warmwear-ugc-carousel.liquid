{% comment %} Warm Wear — UGC vertical carousel {% endcomment %}
<section class="pt-ugc">
  <div class="pt-ugc__head">
    <div>
      {% if section.settings.eyebrow != blank %}<span class="pt-ugc__eyebrow">{{ section.settings.eyebrow }}</span>{% endif %}
      <h2 class="pt-ugc__h">{{ section.settings.heading }}</h2>
    </div>
    <div class="pt-ugc__nav">
      <button type="button" class="pt-ugc__btn" data-pt-ugc-prev aria-label="Previous">&#8249;</button>
      <button type="button" class="pt-ugc__btn" data-pt-ugc-next aria-label="Next">&#8250;</button>
    </div>
  </div>
  <div class="pt-ugc__track" data-pt-ugc-track>
    {% for block in section.blocks %}
      <div class="pt-ugc__slide" {{ block.shopify_attributes }}>
        {% if block.settings.video_url != blank %}
          <video class="pt-ugc__media" src="{{ block.settings.video_url }}" autoplay muted loop playsinline preload="metadata"></video>
        {% elsif block.settings.image != blank %}
          {{ block.settings.image | image_url: width: 480 | image_tag: loading: 'lazy', class: 'pt-ugc__media', alt: '' }}
        {% endif %}
      </div>
    {% endfor %}
  </div>
</section>
<style>
  .pt-ugc{max-width:1120px;margin:14px auto;padding:40px 20px;background:#FDF8F7;border-radius:28px}
  .pt-ugc__head{display:flex;align-items:end;gap:16px}
  .pt-ugc__eyebrow{font-weight:800;font-size:12px;letter-spacing:.14em;text-transform:uppercase;color:#D4805B}
  .pt-ugc__h{margin:8px 0 0}
  .pt-ugc__nav{margin-left:auto;display:flex;gap:8px;flex-shrink:0}
  .pt-ugc__btn{width:42px;height:42px;border-radius:50%;border:1.5px solid #F1D5C8;background:#fff;color:#823C1D;font-size:22px;cursor:pointer}
  .pt-ugc__track{display:flex;gap:14px;margin-top:24px;overflow-x:auto;scroll-snap-type:x mandatory;scrollbar-width:none;padding-bottom:4px}
  .pt-ugc__slide{flex:0 0 220px;aspect-ratio:9/16;scroll-snap-align:start;border-radius:20px;overflow:hidden;background:#F8EBE6}
  .pt-ugc__media{width:100%;height:100%;object-fit:cover;display:block}
</style>
<script>
  (function(){
    var s=document.currentScript.parentElement;
    var t=s.querySelector('[data-pt-ugc-track]');
    s.querySelector('[data-pt-ugc-prev]').addEventListener('click',function(){t.scrollBy({left:-480,behavior:'smooth'})});
    s.querySelector('[data-pt-ugc-next]').addEventListener('click',function(){t.scrollBy({left:480,behavior:'smooth'})});
  })();
</script>
{% schema %}
{
  "name": "Warm Wear UGC carousel",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Instagram · TikTok" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Seen on your feed" }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image (9:16)" },
        { "type": "text", "id": "video_url", "label": "Video URL (mp4, overrides image)" }
      ]
    }
  ],
  "presets": [{ "name": "Warm Wear UGC carousel", "blocks": [{ "type": "slide" }, { "type": "slide" }, { "type": "slide" }, { "type": "slide" }] }]
}
{% endschema %}
