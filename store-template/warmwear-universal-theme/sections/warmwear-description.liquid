<section class="ww-desc">
  <div class="ww-desc__grid">
    <img class="ww-desc__img" src="{{ 'warmwear-description-1.webp' | asset_url }}" alt="Warm Wear heated jacket: LED heat control, 3 temperature settings, carbon fibre wires, detachable hood, power bank pocket and 21 heating zones" width="1024" height="1024" loading="lazy">
    <img class="ww-desc__img" src="{{ 'warmwear-description-2.webp' | asset_url }}" alt="Warm Wear heated jacket details: LED heat control, detachable hood, power bank pocket and carbon fibre wires" width="1024" height="1024" loading="lazy">
