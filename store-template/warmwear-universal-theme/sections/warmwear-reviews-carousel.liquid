<div class="ww-reviews-carousel">
  <div class="ww-reviews-carousel__header">
    <h2>See real customers wearing it</h2>
    <div class="ww-reviews-carousel__nav">
      <button class="ww-reviews-carousel__arrow ww-reviews-carousel__arrow--prev" aria-label="Previous">‹</button>
      <button class="ww-reviews-carousel__arrow ww-reviews-carousel__arrow--next" aria-label="Next">›</button>
    </div>
  </div>

  <div class="ww-reviews-carousel__track">
    {% for review in section.blocks %}
      {% if review.settings.image %}
        <div class="ww-reviews-carousel__item">
          <div class="ww-reviews-carousel__image">
            <img src="{{ review.settings.image | image_url: width: 400 }}" alt="{{ review.settings.name }}" loading="lazy">
          </div>
          <div class="ww-reviews-carousel__content">
            <div class="ww-reviews-carousel__name">{{ review.settings.name }}</div>
            <div class="ww-reviews-carousel__text">{{ review.settings.text }}</div>
            <div class="ww-reviews-carousel__rating">
              {% for i in (1..review.settings.rating) %}★{% endfor %}
            </div>
          </div>
        </div>
      {% endif %}
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "Warm Wear Reviews Slider",
  "blocks": [
    {
      "type": "review",
      "name": "Customer Review",
      "settings": [
        {
          "type": "text",
          "id": "name",
          "label": "Customer name"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Customer photo"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Review text"
        },
        {
          "type": "range",
          "id": "rating",
          "min": 1,
          "max": 5,
          "step": 1,
          "default": 5,
          "label": "Rating"
        }
      ]
    }
  ],
  "presets": [{"name": "Reviews Carousel"}]
}
{% endschema %}

<style>
.ww-reviews-carousel {
  width: 100%;
  padding: 60px 20px;
  background: #fafafa;
}

.ww-reviews-carousel__header {
  max-width: 1120px;
  margin: 0 auto 40px;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.ww-reviews-carousel__header h2 {
  margin: 0;
  font-size: 32px;
  font-weight: 700;
  color: #1a1a1a;
}

.ww-reviews-carousel__nav {
  display: flex;
  gap: 12px;
}

.ww-reviews-carousel__arrow {
  width: 44px;
  height: 44px;
  border-radius: 50%;
  border: 2px solid #C85C2D;
  background: #fff;
  color: #C85C2D;
  font-size: 24px;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.3s;
}

.ww-reviews-carousel__arrow:hover {
  background: #C85C2D;
  color: #fff;
}

.ww-reviews-carousel__track {
  max-width: 1120px;
  margin: 0 auto;
  display: flex;
  gap: 24px;
  overflow-x: auto;
  scroll-snap-type: x mandatory;
  scrollbar-width: none;
  padding: 0 0 16px;
}

.ww-reviews-carousel__track::-webkit-scrollbar {
  display: none;
}

.ww-reviews-carousel__item {
  flex: 0 0 calc((100% - 24px) / 2);
  scroll-snap-align: start;
  background: #fff;
  border-radius: 16px;
  overflow: hidden;
  min-width: 0;
}

.ww-reviews-carousel__image {
  width: 100%;
  aspect-ratio: 1;
  overflow: hidden;
  background: #f5f5f5;
}

.ww-reviews-carousel__image img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

.ww-reviews-carousel__content {
  padding: 24px;
}

.ww-reviews-carousel__name {
  font-weight: 700;
  font-size: 16px;
  color: #1a1a1a;
  margin-bottom: 8px;
}

.ww-reviews-carousel__text {
  font-size: 14px;
  color: #5f5f5f;
  line-height: 1.5;
  margin-bottom: 12px;
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.ww-reviews-carousel__rating {
  color: #F5C51C;
  font-size: 14px;
  letter-spacing: 2px;
}

@media (max-width: 749px) {
  .ww-reviews-carousel {
    padding: 40px 16px;
  }

  .ww-reviews-carousel__header {
    flex-direction: column;
    align-items: flex-start;
    margin-bottom: 24px;
  }

  .ww-reviews-carousel__header h2 {
    font-size: 24px;
    margin-bottom: 16px;
  }

  .ww-reviews-carousel__item {
    flex: 0 0 calc((100% - 16px) / 1.5);
  }
}
</style>
