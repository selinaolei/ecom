<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@600;700;800&family=Nunito:wght@400;600;700;800&display=swap" rel="stylesheet">
<style>
:root{--font-body--family:'Nunito',sans-serif;--font-heading--family:'Baloo 2',sans-serif;--font-subheading--family:'Nunito',sans-serif;--font-accent--family:'Baloo 2',sans-serif}
body{font-family:'Nunito',sans-serif}
h1,h2,h3,h4,.pt-buy__title,.pt-foot__logo{font-family:'Baloo 2',sans-serif}
</style>
{% comment %} Warm Wear — scrolling trust strip with icons {% endcomment %}
<div class="pt-trust">
  <div class="pt-trust__track">
    {% for i in (1..4) %}
      {% for block in section.blocks %}
        <span class="pt-trust__item" {{ block.shopify_attributes }}>
          {% case block.settings.icon %}
          {% when 'truck' %}<svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 7h12v9H1zM13 10h5l3 3v3h-8z"/><circle cx="6" cy="18" r="1.8"/><circle cx="17" cy="18" r="1.8"/></svg>
          {% when 'shield' %}<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2l8 3v6c0 5-3.5 9-8 11-4.5-2-8-6-8-11V5z"/></svg>
          {% when 'moon' %}<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 14A8.5 8.5 0 1 1 10 3.5 7 7 0 0 0 20 14z"/></svg>
          {% when 'plane' %}<svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M2 14l20-9-6 18-4-7z"/></svg>
          {% when 'badge' %}<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="9" r="6"/><path d="M8 14l-2 7 6-3 6 3-2-7"/></svg>
          {% when 'phone' %}<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8 2h8a2 2 0 0 1 2 2v16a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2z"/><path d="M11 18h2"/></svg>
          {% when 'spark' %}<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v4M12 17v4M3 12h4M17 12h4M6 6l2.5 2.5M15.5 15.5L18 18M6 18l2.5-2.5M15.5 8.5L18 6"/></svg>
          {% when 'plug' %}<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 2v6M15 2v6M6 8h12v3a6 6 0 0 1-12 0zM12 17v5"/></svg>
          {% when 'snow' %}<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2v20M4 7l16 10M4 17L20 7M9 4l3 2 3-2M9 20l3-2 3 2"/></svg>
          {% when 'gift' %}<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9h18v4H3zM5 13h14v8H5zM12 9v12M12 9c-2-4-6-4-6-1s6 1 6 1zm0 0c2-4 6-4 6-1s-6 1-6 1z"/></svg>
          {% when 'heart' %}<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21s-7-4.5-9.5-9A5.5 5.5 0 0 1 12 6a5.5 5.5 0 0 1 9.5 6C19 16.5 12 21 12 21z"/></svg>
          {% when 'star' %}<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l2.7 5.6 6.1.9-4.4 4.3 1 6.1L12 17l-5.4 2.9 1-6.1L3.2 9.5l6.1-.9z"/></svg>
          {% when 'leaf' %}<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 19C5 9 11 4 20 4c0 9-5 15-15 15zM5 19l8-8"/></svg>
          {% when 'clock' %}<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
          {% when 'bolt' %}<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2L4 14h7l-1 8 9-12h-7z"/></svg>
          {% when 'drop' %}<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3s7 7.5 7 12a7 7 0 0 1-14 0c0-4.5 7-12 7-12z"/></svg>
          {% when 'paw' %}<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="7" cy="8" r="2"/><circle cx="17" cy="8" r="2"/><circle cx="4.5" cy="13" r="1.8"/><circle cx="19.5" cy="13" r="1.8"/><path d="M12 12c-3 0-5.5 3.5-5.5 6 0 1.5 1.5 2 3 2h5c1.5 0 3-.5 3-2 0-2.5-2.5-6-5.5-6z"/></svg>
          {% when 'breath' %}<svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 8h9a3 3 0 1 0-3-3M3 12h15a3 3 0 1 1-3 3M3 16h7a2.5 2.5 0 1 1-2.5 2.5"/></svg>
          {% endcase %}
          {{ block.settings.text }}
        </span>
      {% endfor %}
    {% endfor %}
  </div>
</div>
<style>
  .pt-trust{background:#FDF8F7;overflow:hidden;padding:12px 0;border-top:1px solid #FBF4F0;border-bottom:1px solid #FBF4F0}
  .pt-trust__track{display:flex;gap:14px;width:max-content;animation:pt-trust {{ section.settings.speed }}s linear infinite;font-weight:700;font-size:12.5px;color:#823C1D;white-space:nowrap}
  .pt-trust__item{display:inline-flex;align-items:center;gap:9px;background:#fff;border:1.5px solid #F8EAE4;border-radius:999px;padding:7px 16px 7px 7px}
  .pt-trust__item svg{color:#C85C2D;flex-shrink:0;background:#FBF2EE;border-radius:50%;width:26px;height:26px;padding:5px;box-sizing:border-box}
  @keyframes pt-trust{from{transform:translateX(0)}to{transform:translateX(-50%)}}
</style>
{% schema %}
{
  "name": "Warm Wear trust strip",
  "tag": "section",
  "settings": [
    { "type": "range", "id": "speed", "label": "Speed (s)", "min": 10, "max": 60, "step": 1, "default": 34 }
  ],
  "blocks": [
    { "type": "item", "name": "Item", "settings": [
      { "type": "select", "id": "icon", "label": "Icon", "default": "truck",
        "options": [ {"value":"truck","label":"Truck"},{"value":"shield","label":"Shield"},{"value":"moon","label":"Moon"},{"value":"plane","label":"Plane"},{"value":"badge","label":"Badge"},{"value":"phone","label":"Phone"},{"value":"spark","label":"Spark"},{"value":"plug","label":"Plug"},{"value":"snow","label":"Snow"},{"value":"gift","label":"Gift"},{"value":"heart","label":"Heart"},{"value":"star","label":"Star"},{"value":"leaf","label":"Leaf"},{"value":"clock","label":"Clock"},{"value":"bolt","label":"Bolt"},{"value":"drop","label":"Drop"},{"value":"paw","label":"Paw"},{"value":"breath","label":"Breath"} ] },
      { "type": "text", "id": "text", "label": "Text", "default": "Free insured shipping" }
    ] }
  ],
  "max_blocks": 6,
  "presets": [{ "name": "Warm Wear trust strip", "blocks": [{"type":"item"},{"type":"item"},{"type":"item"},{"type":"item"}] }]
}
{% endschema %}
