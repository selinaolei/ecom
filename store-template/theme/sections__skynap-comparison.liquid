{% comment %} Skynap — comparison table {% endcomment %}
<section class="pt-cmp">
  <div class="pt-cmp__headwrap"><span class="pt-cmp__eyebrow">{{ section.settings.eyebrow }}</span>
  <h2 class="pt-cmp__h">{{ section.settings.heading }}</h2></div>
  <div class="pt-cmp__card">
    <div class="pt-cmp__row pt-cmp__row--head">
      <div>{{ section.settings.left_label }}</div>
      <div class="pt-cmp__us"><span class="pt-cmp__uslabel">{{ section.settings.right_label }}</span><span class="pt-cmp__badge">Best choice</span></div>
    </div>
    {% for block in section.blocks %}
      <div class="pt-cmp__row" {{ block.shopify_attributes }}>
        <div class="pt-cmp__bad"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><line x1="6" y1="6" x2="18" y2="18"/><line x1="18" y1="6" x2="6" y2="18"/></svg>{{ block.settings.bad }}</div>
        <div class="pt-cmp__good"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><polyline points="4,13 10,19 20,6"/></svg>{{ block.settings.good }}</div>
      </div>
    {% endfor %}
  </div>
  <div class="pt-cmp__ctawrap"><a class="pt-cmp__cta" href="#top">{{ section.settings.cta_label }}</a></div>
</section>
<style>
  .pt-cmp{max-width:820px;margin:0 auto;padding:44px 20px}
  .pt-cmp__headwrap{text-align:center;margin:0 0 24px}
  .pt-cmp__eyebrow{font-weight:800;font-size:12px;letter-spacing:.14em;text-transform:uppercase;color:#8B6FF0}
  .pt-cmp__h{margin:8px 0 0}
  .pt-cmp__us{display:flex;flex-direction:column;align-items:center;gap:4px}
  .pt-cmp__badge{background:#5B3FE0;color:#fff;font-size:10px;font-weight:800;padding:3px 11px;border-radius:999px;text-transform:uppercase;letter-spacing:.05em;white-space:nowrap}
  .pt-cmp__ctawrap{text-align:center;margin-top:24px}
  .pt-cmp__cta{display:inline-block;background:#5B3FE0;color:#fff;font-weight:800;font-size:15px;padding:14px 34px;border-radius:999px;text-decoration:none}
  .pt-cmp__cta:hover{background:#31239E}
  .pt-cmp__card{border:1.5px solid #E6E2F6;border-radius:20px;overflow:hidden;background:#fff}
  .pt-cmp__row{display:grid;grid-template-columns:1fr 1fr;border-top:1px solid #E6E2F6}
  .pt-cmp__row--head{border-top:none;background:#F1EDFD;font-weight:700;font-size:14px;color:#5E5880}
  .pt-cmp__row--head>div{padding:14px 18px;text-align:center}
  .pt-cmp__us{background:#E7E1FB;color:#31239E;font-weight:800}
  .pt-cmp__bad,.pt-cmp__good{padding:13px 18px;display:flex;gap:10px;align-items:center;font-size:14px}
  .pt-cmp__bad svg,.pt-cmp__good svg{width:22px;height:22px;padding:4px;border-radius:50%;box-sizing:border-box}
  .pt-cmp__bad svg{background:#F3F1FA}.pt-cmp__good svg{background:#fff}
  .pt-cmp__bad{color:#5E5880}.pt-cmp__bad svg{color:#9C96BB;flex-shrink:0}
  .pt-cmp__good{background:#F1EDFD;color:#1C1540;font-weight:600}.pt-cmp__good svg{color:#5B3FE0;flex-shrink:0}
</style>
{% schema %}
{
  "name": "Skynap comparison",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Why Skynap" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Fresh flowers vs Skynap" },
    { "type": "text", "id": "cta_label", "label": "Button label", "default": "Get my Skynap" },
    { "type": "text", "id": "left_label", "label": "Left column", "default": "U-shaped neck pillow" },
    { "type": "text", "id": "right_label", "label": "Right column", "default": "Skynap" }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "Row",
      "settings": [
        { "type": "text", "id": "bad", "label": "Theirs", "default": "Head falls forward all flight" },
        { "type": "text", "id": "good", "label": "Ours", "default": "Face rests supported on the tray" }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [{ "name": "Skynap comparison", "blocks": [{ "type": "row" }, { "type": "row" }, { "type": "row" }] }]
}
{% endschema %}
