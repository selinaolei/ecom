<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@600;700;800&family=Nunito:wght@400;600;700;800&display=swap" rel="stylesheet">
<style>
:root{--font-body--family:'Nunito',sans-serif;--font-heading--family:'Baloo 2',sans-serif;--font-subheading--family:'Nunito',sans-serif;--font-accent--family:'Baloo 2',sans-serif}
body{font-family:'Nunito',sans-serif}
h1,h2,h3,h4,.pt-buy__title,.pt-foot__logo{font-family:'Baloo 2',sans-serif}
</style>
{% comment %} Skynap — scrolling trust strip with icons {% endcomment %}
<div class="pt-trust">
  <div class="pt-trust__track">
    {% for i in (1..4) %}
      {% for block in section.blocks %}
        <span class="pt-trust__item" {{ block.shopify_attributes }}>
          {% case block.settings.icon %}
          {% when 'truck' %}<svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 7h12v9H1zM13 10h5l3 3v3h-8z"/><circle cx="6" cy="18" r="1.8"/><circle cx="17" cy="18" r="1.8"/></svg>
          {% when 'shield' %}<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2l8 3v6c0 5-3.5 9-8 11-4.5-2-8-6-8-11V5z"/></svg>
          {% when 'moon' %}<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 14A8.5 8.5 0 1 1 10 3.5 7 7 0 0 0 20 14z"/></svg>
          {% when 'plane' %}<svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M2 14l20-9-6 18-4-7z"/></svg>
          {% when 'badge' %}<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="9" r="6"/><path d="M8 14l-2 7 6-3 6 3-2-7"/></svg>
          {% when 'breath' %}<svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 8h9a3 3 0 1 0-3-3M3 12h15a3 3 0 1 1-3 3M3 16h7a2.5 2.5 0 1 1-2.5 2.5"/></svg>
          {% endcase %}
          {{ block.settings.text }}
        </span>
      {% endfor %}
    {% endfor %}
  </div>
</div>
<style>
  .pt-trust{background:#F6F4FE;overflow:hidden;padding:12px 0;border-top:1px solid #EFEBFB;border-bottom:1px solid #EFEBFB}
  .pt-trust__track{display:flex;gap:14px;width:max-content;animation:pt-trust {{ section.settings.speed }}s linear infinite;font-weight:700;font-size:12.5px;color:#31239E;white-space:nowrap}
  .pt-trust__item{display:inline-flex;align-items:center;gap:9px;background:#fff;border:1.5px solid #E6E2F6;border-radius:999px;padding:7px 16px 7px 7px}
  .pt-trust__item svg{color:#5B3FE0;flex-shrink:0;background:#F1EDFD;border-radius:50%;width:26px;height:26px;padding:5px;box-sizing:border-box}
  @keyframes pt-trust{from{transform:translateX(0)}to{transform:translateX(-50%)}}
</style>
{% schema %}
{
  "name": "Skynap trust strip",
  "tag": "section",
  "settings": [
    { "type": "range", "id": "speed", "label": "Speed (s)", "min": 10, "max": 60, "step": 1, "default": 34 }
  ],
  "blocks": [
    { "type": "item", "name": "Item", "settings": [
      { "type": "select", "id": "icon", "label": "Icon", "default": "truck",
        "options": [ {"value":"truck","label":"Truck"},{"value":"shield","label":"Shield"},{"value":"moon","label":"Moon"},{"value":"plane","label":"Plane"},{"value":"badge","label":"Badge"},{"value":"breath","label":"Breath"} ] },
      { "type": "text", "id": "text", "label": "Text", "default": "Free insured shipping" }
    ] }
  ],
  "max_blocks": 6,
  "presets": [{ "name": "Skynap trust strip", "blocks": [{"type":"item"},{"type":"item"},{"type":"item"},{"type":"item"}] }]
}
{% endschema %}
