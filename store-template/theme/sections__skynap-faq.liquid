{% comment %} Skynap — FAQ accordion (no JS) {% endcomment %}
<section class="pt-faq">
  {% if section.settings.heading != blank %}<h2 class="pt-faq__h">{{ section.settings.heading }}</h2>{% endif %}
  <div class="pt-faq__list">
    {% for block in section.blocks %}
      <details class="pt-faq__item" {{ block.shopify_attributes }}>
        <summary>{{ block.settings.q }}<span class="pt-faq__plus" aria-hidden="true">+</span></summary>
        <div class="pt-faq__a">{{ block.settings.a }}</div>
      </details>
    {% endfor %}
  </div>
</section>
<style>
  .pt-faq{max-width:760px;margin:0 auto;padding:44px 20px}
  .pt-faq__h{text-align:center;margin:0 0 28px}
  .pt-faq__list{display:flex;flex-direction:column;gap:10px}
  .pt-faq__item{background:#fff;border:1.5px solid #E6E2F6;border-radius:12px;overflow:hidden}
  .pt-faq__item[open]{border-color:#A99AF0}
  .pt-faq__item summary{display:flex;justify-content:space-between;align-items:center;gap:12px;padding:14px 18px;cursor:pointer;font-weight:700;font-size:15px;color:#31239E;list-style:none}
  .pt-faq__item summary::-webkit-details-marker{display:none}
  .pt-faq__plus{color:#8B6FF0;font-size:18px;transition:transform .22s}
  .pt-faq__item[open] .pt-faq__plus{transform:rotate(45deg)}
  .pt-faq__a{padding:0 18px 16px;color:#403966;font-size:15px;line-height:1.6}
</style>
{% schema %}
{
  "name": "Skynap FAQ",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Questions, answered" }
  ],
  "blocks": [
    {
      "type": "qa",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "q", "label": "Question", "default": "Does it really fit on the tray table?" },
        { "type": "textarea", "id": "a", "label": "Answer", "default": "Yes — it is sized for standard economy tray tables, with two heights so it works even in tight rows." }
      ]
    }
  ],
  "presets": [{ "name": "Skynap FAQ", "blocks": [{ "type": "qa" }, { "type": "qa" }, { "type": "qa" }] }]
}
{% endschema %}
