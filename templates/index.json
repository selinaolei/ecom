    "custom_liquid_a6t8wq": {
      "type": "custom-liquid",
      "name": "t:names.custom_liquid",
      "settings": {
        "custom_liquid": "<style>\n  @import url('https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,700;0,900;1,700&family=Inter:wght@400;500;600;700;800&display=swap');\n\n  .dphero {\n    background: linear-gradient(160deg, #2D4A2D 0%, #1e331e 100%);\n    padding: 88px 24px;\n    text-align: center;\n    position: relative;\n    overflow: hidden;\n  }\n\n  /* Subtle background glow */\n  .dphero::before {\n    content: '';\n    position: absolute;\n    top: -100px;\n    left: 50%;\n    transform: translateX(-50%);\n    width: 600px;\n    height: 600px;\n    background: radial-gradient(circle, rgba(201,169,110,0.08) 0%, transparent 70%);\n    pointer-events: none;\n  }\n\n  .dphero__inner {\n    max-width: 780px;\n    margin: 0 auto;\n    position: relative;\n  }\n\n  .dphero__label {\n    display: inline-block;\n    font-family: 'Inter', sans-serif;\n    font-size: 11px;\n    font-weight: 700;\n    letter-spacing: 3px;\n    text-transform: uppercase;\n    color: #C9A96E;\n    margin-bottom: 20px;\n    position: relative;\n    padding: 0 24px;\n  }\n  .dphero__label::before, .dphero__label::after {\n    content: '';\n    position: absolute;\n    top: 50%;\n    width: 28px;\n    height: 1px;\n    background: #C9A96E;\n    opacity: 0.6;\n  }\n  .dphero__label::before { right: 100%; margin-right: -22px; }\n  .dphero__label::after { left: 100%; margin-left: -22px; }\n\n  .dphero__title {\n    font-family: 'Playfair Display', Georgia, serif;\n    font-size: clamp(38px, 7vw, 72px);\n    font-weight: 900;\n    line-height: 1.08;\n    color: #F5EFE0;\n    margin-bottom: 6px;\n    letter-spacing: -1px;\n  }\n  .dphero__title-gold {\n    font-style: italic;\n    background: linear-gradient(135deg, #b8924a 0%, #e8d5a0 40%, #C9A96E 60%, #a07840 100%);\n    -webkit-background-clip: text;\n    -webkit-text-fill-color: transparent;\n    background-clip: text;\n  }\n\n  .dphero__divider {\n    display: flex;\n    align-items: center;\n    gap: 14px;\n    justify-content: center;\n    margin: 24px 0;\n  }\n  .dphero__line {\n    width: 80px;\n    height: 1px;\n    background: linear-gradient(to right, transparent, #C9A96E);\n    opacity: 0.6;\n  }\n  .dphero__line-r { background: linear-gradient(to left, transparent, #C9A96E); }\n  .dphero__paw { width: 22px; height: 22px; fill: #C9A96E; opacity: 0.8; }\n\n  .dphero__sub {\n    font-family: 'Inter', sans-serif;\n    font-size: clamp(15px, 2vw, 18px);\n    color: #a8c4a8;\n    line-height: 1.7;\n    max-width: 520px;\n    margin: 0 auto 40px;\n    font-weight: 400;\n  }\n\n  .dphero__btn {\n    display: inline-block;\n    background: linear-gradient(135deg, #b8924a 0%, #e8d5a0 50%, #C9A96E 100%);\n    color: #1a2e1a;\n    font-family: 'Inter', sans-serif;\n    font-size: 16px;\n    font-weight: 800;\n    padding: 18px 52px;\n    border-radius: 10px;\n    text-decoration: none;\n    transition: transform 0.15s ease, box-shadow 0.2s ease;\n    margin-bottom: 32px;\n    display: block;\n    max-width: 380px;\n    margin: 0 auto 20px;\n  }\n  .dphero__btn:hover {\n    transform: translateY(-2px);\n    box-shadow: 0 8px 28px rgba(201,169,110,0.3);\n    color: #1a2e1a;\n  }\n\n  .dphero__sub2 {\n    font-family: 'Inter', sans-serif;\n    font-size: 12px;\n    color: #6a8a6a;\n    margin-bottom: 48px;\n    letter-spacing: 0.3px;\n  }\n\n  .dphero__pills {\n    display: flex;\n    flex-wrap: wrap;\n    justify-content: center;\n    gap: 10px;\n  }\n  .dphero__pill {\n    display: inline-flex;\n    align-items: center;\n    gap: 7px;\n    background: rgba(255,255,255,0.06);\n    border: 1px solid rgba(201,169,110,0.25);\n    border-radius: 999px;\n    padding: 8px 16px;\n    font-family: 'Inter', sans-serif;\n    font-size: 13px;\n    font-weight: 600;\n    color: #F5EFE0;\n  }\n  .dphero__pill-dot {\n    width: 5px;\n    height: 5px;\n    background: #C9A96E;\n    border-radius: 50%;\n    flex-shrink: 0;\n  }\n</style>\n\n<div class=\"dphero\">\n  <div class=\"dphero__inner\">\n\n    <span class=\"dphero__label\">Dear Paws &mdash; Official Store</span>\n\n    <h1 class=\"dphero__title\">\n      Give Your Dog<br>\n      The Gift of<br>\n      <span class=\"dphero__title-gold\">Pure Joy</span>\n    </h1>\n\n    <div class=\"dphero__divider\">\n      <span class=\"dphero__line\"></span>\n      <svg class=\"dphero__paw\" viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\">\n        <ellipse cx=\"30\" cy=\"20\" rx=\"12\" ry=\"16\"/>\n        <ellipse cx=\"70\" cy=\"20\" rx=\"12\" ry=\"16\"/>\n        <ellipse cx=\"12\" cy=\"48\" rx=\"10\" ry=\"14\"/>\n        <ellipse cx=\"88\" cy=\"48\" rx=\"10\" ry=\"14\"/>\n        <path d=\"M50 38 C22 38 15 60 20 75 C26 92 74 92 80 75 C85 60 78 38 50 38Z\"/>\n      </svg>\n      <span class=\"dphero__line dphero__line-r\"></span>\n    </div>\n\n    <p class=\"dphero__sub\">\n      The Christmas countdown your dog will never forget. 24 days of brand new toys, accessories and surprises &mdash; one every single morning from December 1st to Christmas Eve.\n    </p>\n\n    <a href=\"/products/spiderjet-glove\" class=\"dphero__btn\">Shop The Advent Calendar &rarr;</a>\n    <p class=\"dphero__sub2\">Free Shipping &nbsp;&middot;&nbsp; 30 Day Money Back &nbsp;&middot;&nbsp; 2,400+ Happy Dogs</p>\n\n    <div class=\"dphero__pills\">\n      <span class=\"dphero__pill\"><span class=\"dphero__pill-dot\"></span>24 Surprise Toys</span>\n      <span class=\"dphero__pill\"><span class=\"dphero__pill-dot\"></span>All Breeds Welcome</span>\n      <span class=\"dphero__pill\"><span class=\"dphero__pill-dot\"></span>Gift Ready Box</span>\n      <span class=\"dphero__pill\"><span class=\"dphero__pill-dot\"></span>Non-Toxic &amp; Safe</span>\n    </div>\n\n  </div>\n</div>",
        "background_color": "#23442f",
        "section_width": "full-width",
        "padding-block-start": 0,
        "padding-block-end": 0
      }
