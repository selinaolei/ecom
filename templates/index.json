    "custom_liquid_6dgjyX": {
      "type": "custom-liquid",
      "name": "t:names.custom_liquid",
      "settings": {
        "custom_liquid": "<style>\n  @import url('https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,700;1,400&family=Inter:wght@400;500;600;700&display=swap');\n\n  .dpg-rev {\n    background-color: #F5EFE0;\n    padding: 88px 24px;\n  }\n  .dpg-rev__inner { max-width: 1120px; margin: 0 auto; }\n  .dpg-rev__header { text-align: center; margin-bottom: 56px; }\n  .dpg-rev__label {\n    display: inline-block;\n    font-family: 'Inter', sans-serif;\n    font-size: 11px;\n    font-weight: 700;\n    letter-spacing: 3px;\n    text-transform: uppercase;\n    color: #C9A96E;\n    margin-bottom: 16px;\n    position: relative;\n    padding: 0 20px;\n  }\n  .dpg-rev__label::before,\n  .dpg-rev__label::after {\n    content: '';\n    position: absolute;\n    top: 50%;\n    width: 30px;\n    height: 1px;\n    background: #C9A96E;\n  }\n  .dpg-rev__label::before { right: 100%; margin-right: -18px; }\n  .dpg-rev__label::after { left: 100%; margin-left: -18px; }\n  .dpg-rev__heading {\n    font-family: 'Playfair Display', serif;\n    font-size: clamp(28px, 4vw, 48px);\n    font-weight: 700;\n    color: #1a2e1a;\n    line-height: 1.2;\n  }\n  .dpg-rev__heading em { font-style: italic; color: #C9A96E; }\n\n  /* Summary box */\n  .dpg-rev__summary {\n    background: #ffffff;\n    border: 1px solid #e0d5be;\n    border-radius: 20px;\n    padding: 36px;\n    display: grid;\n    grid-template-columns: 1fr;\n    gap: 32px;\n    margin-bottom: 44px;\n    align-items: center;\n  }\n  @media (min-width: 750px) {\n    .dpg-rev__summary { grid-template-columns: 200px 1fr; }\n  }\n  .dpg-rev__score-box { text-align: center; }\n  .dpg-rev__score-num {\n    font-family: 'Playfair Display', serif;\n    font-size: 80px;\n    font-weight: 700;\n    color: #1a2e1a;\n    line-height: 1;\n    display: block;\n  }\n  .dpg-rev__score-stars {\n    font-size: 20px;\n    color: #C9A96E;\n    letter-spacing: 2px;\n    display: block;\n    margin: 8px 0 4px;\n  }\n  .dpg-rev__score-label {\n    font-family: 'Inter', sans-serif;\n    font-size: 13px;\n    color: #9a9a8a;\n  }\n  .dpg-rev__bar-row {\n    display: flex;\n    align-items: center;\n    gap: 14px;\n    margin-bottom: 10px;\n  }\n  .dpg-rev__bar-label {\n    font-family: 'Inter', sans-serif;\n    font-size: 13px;\n    font-weight: 600;\n    color: #5a5a4a;\n    width: 30px;\n    flex-shrink: 0;\n  }\n  .dpg-rev__bar-track {\n    flex: 1;\n    height: 8px;\n    background: #ede5d0;\n    border-radius: 999px;\n    overflow: hidden;\n  }\n  .dpg-rev__bar-fill {\n    height: 100%;\n    background: linear-gradient(to right, #2D4A2D, #4a7a4a);\n    border-radius: 999px;\n    transition: width 0.8s ease;\n  }\n  .dpg-rev__bar-pct {\n    font-family: 'Inter', sans-serif;\n    font-size: 13px;\n    color: #9a9a8a;\n    width: 34px;\n    text-align: right;\n    flex-shrink: 0;\n  }\n\n  /* Cards */\n  .dpg-rev__grid {\n    display: grid;\n    grid-template-columns: 1fr;\n    gap: 16px;\n  }\n  @media (min-width: 600px) { .dpg-rev__grid { grid-template-columns: repeat(2, 1fr); } }\n  @media (min-width: 1024px) { .dpg-rev__grid { grid-template-columns: repeat(3, 1fr); } }\n\n  .dpg-rev__card {\n    background: #ffffff;\n    border: 1px solid #e0d5be;\n    border-radius: 16px;\n    padding: 28px;\n    position: relative;\n    transition: transform 0.2s ease;\n  }\n  .dpg-rev__card:hover { transform: translateY(-3px); }\n  .dpg-rev__card-top {\n    display: flex;\n    align-items: center;\n    gap: 12px;\n    margin-bottom: 16px;\n  }\n  .dpg-rev__avatar {\n    width: 46px;\n    height: 46px;\n    border-radius: 50%;\n    background: #2D4A2D;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    font-family: 'Playfair Display', serif;\n    font-size: 18px;\n    font-weight: 700;\n    color: #C9A96E;\n    flex-shrink: 0;\n  }\n  .dpg-rev__name {\n    font-family: 'Inter', sans-serif;\n    font-size: 14px;\n    font-weight: 700;\n    color: #1a2e1a;\n  }\n  .dpg-rev__source {\n    font-family: 'Inter', sans-serif;\n    font-size: 12px;\n    color: #aaa;\n    margin-top: 2px;\n  }\n  .dpg-rev__stars {\n    font-size: 14px;\n    color: #C9A96E;\n    letter-spacing: 1px;\n    margin-bottom: 10px;\n  }\n  .dpg-rev__card-title {\n    font-family: 'Playfair Display', serif;\n    font-size: 16px;\n    font-weight: 700;\n    color: #1a2e1a;\n    margin-bottom: 10px;\n    line-height: 1.3;\n  }\n  .dpg-rev__card-text {\n    font-family: 'Inter', sans-serif;\n    font-size: 14px;\n    color: #5a5a4a;\n    line-height: 1.7;\n    margin-bottom: 16px;\n  }\n  .dpg-rev__card-footer {\n    display: flex;\n    justify-content: space-between;\n    align-items: center;\n    padding-top: 14px;\n    border-top: 1px solid #ede5d0;\n  }\n  .dpg-rev__date {\n    font-family: 'Inter', sans-serif;\n    font-size: 12px;\n    color: #bbb;\n  }\n  .dpg-rev__verified {\n    font-family: 'Inter', sans-serif;\n    font-size: 11px;\n    font-weight: 700;\n    color: #2D4A2D;\n    letter-spacing: 0.3px;\n  }\n</style>\n\n<div class=\"dpg-rev\">\n  <div class=\"dpg-rev__inner\">\n    <div class=\"dpg-rev__header\">\n      <span class=\"dpg-rev__label\">Verified Reviews</span>\n      <h2 class=\"dpg-rev__heading\">What <em>2,400+ Dog Parents</em><br>Are Saying</h2>\n    </div>\n\n    <div class=\"dpg-rev__summary\">\n      <div class=\"dpg-rev__score-box\">\n        <span class=\"dpg-rev__score-num\">4.9</span>\n        <span class=\"dpg-rev__score-stars\">&#9733;&#9733;&#9733;&#9733;&#9733;</span>\n        <span class=\"dpg-rev__score-label\">Based on 2,400+ reviews</span>\n      </div>\n      <div>\n        <div class=\"dpg-rev__bar-row\">\n          <span class=\"dpg-rev__bar-label\">5 &#9733;</span>\n          <div class=\"dpg-rev__bar-track\"><div class=\"dpg-rev__bar-fill\" style=\"width:82%\"></div></div>\n          <span class=\"dpg-rev__bar-pct\">82%</span>\n        </div>\n        <div class=\"dpg-rev__bar-row\">\n          <span class=\"dpg-rev__bar-label\">4 &#9733;</span>\n          <div class=\"dpg-rev__bar-track\"><div class=\"dpg-rev__bar-fill\" style=\"width:12%\"></div></div>\n          <span class=\"dpg-rev__bar-pct\">12%</span>\n        </div>\n        <div class=\"dpg-rev__bar-row\">\n          <span class=\"dpg-rev__bar-label\">3 &#9733;</span>\n          <div class=\"dpg-rev__bar-track\"><div class=\"dpg-rev__bar-fill\" style=\"width:4%\"></div></div>\n          <span class=\"dpg-rev__bar-pct\">4%</span>\n        </div>\n        <div class=\"dpg-rev__bar-row\">\n          <span class=\"dpg-rev__bar-label\">2 &#9733;</span>\n          <div class=\"dpg-rev__bar-track\"><div class=\"dpg-rev__bar-fill\" style=\"width:1%\"></div></div>\n          <span class=\"dpg-rev__bar-pct\">1%</span>\n        </div>\n        <div class=\"dpg-rev__bar-row\">\n          <span class=\"dpg-rev__bar-label\">1 &#9733;</span>\n          <div class=\"dpg-rev__bar-track\"><div class=\"dpg-rev__bar-fill\" style=\"width:1%\"></div></div>\n          <span class=\"dpg-rev__bar-pct\">1%</span>\n        </div>\n      </div>\n    </div>\n\n    <div class=\"dpg-rev__grid\">\n      <div class=\"dpg-rev__card\">\n        <div class=\"dpg-rev__card-top\">\n          <div class=\"dpg-rev__avatar\">S</div>\n          <div>\n            <div class=\"dpg-rev__name\">Sarah M.</div>\n            <div class=\"dpg-rev__source\">Verified Facebook Review</div>\n          </div>\n        </div>\n        <div class=\"dpg-rev__stars\">&#9733;&#9733;&#9733;&#9733;&#9733;</div>\n        <p class=\"dpg-rev__card-title\">She sat by it every single morning</p>\n        <p class=\"dpg-rev__card-text\">My dog knew what was coming and would wait by the calendar first thing every day. Best purchase I have ever made for her. Already ordered for next year.</p>\n        <div class=\"dpg-rev__card-footer\">\n          <span class=\"dpg-rev__date\">November 2025</span>\n          <span class=\"dpg-rev__verified\">&#10003; Verified Purchase</span>\n        </div>\n      </div>\n      <div class=\"dpg-rev__card\">\n        <div class=\"dpg-rev__card-top\">\n          <div class=\"dpg-rev__avatar\">J</div>\n          <div>\n            <div class=\"dpg-rev__name\">James T.</div>\n            <div class=\"dpg-rev__source\">Verified Facebook Review</div>\n          </div>\n        </div>\n        <div class=\"dpg-rev__stars\">&#9733;&#9733;&#9733;&#9733;&#9733;</div>\n        <p class=\"dpg-rev__card-title\">Way better quality than expected</p>\n        <p class=\"dpg-rev__card-text\">The toys are durable and my lab has been playing with them weeks after Christmas. Worth every penny. The packaging alone was impressive — really premium feel.</p>\n        <div class=\"dpg-rev__card-footer\">\n          <span class=\"dpg-rev__date\">December 2025</span>\n          <span class=\"dpg-rev__verified\">&#10003; Verified Purchase</span>\n        </div>\n      </div>\n      <div class=\"dpg-rev__card\">\n        <div class=\"dpg-rev__card-top\">\n          <div class=\"dpg-rev__avatar\">L</div>\n          <div>\n            <div class=\"dpg-rev__name\">Lisa K.</div>\n            <div class=\"dpg-rev__source\">Verified Facebook Review</div>\n          </div>\n        </div>\n        <div class=\"dpg-rev__stars\">&#9733;&#9733;&#9733;&#9733;&#9733;</div>\n        <p class=\"dpg-rev__card-title\">Ordered for both dogs — both obsessed</p>\n        <p class=\"dpg-rev__card-text\">The variety is incredible. Ropes, balls, plush toys, bandanas. Arrived beautifully packaged. Gifted one to my sister too. Whole family looked forward to it every morning.</p>\n        <div class=\"dpg-rev__card-footer\">\n          <span class=\"dpg-rev__date\">December 2025</span>\n          <span class=\"dpg-rev__verified\">&#10003; Verified Purchase</span>\n        </div>\n      </div>\n      <div class=\"dpg-rev__card\">\n        <div class=\"dpg-rev__card-top\">\n          <div class=\"dpg-rev__avatar\">D</div>\n          <div>\n            <div class=\"dpg-rev__name\">Donna R.</div>\n            <div class=\"dpg-rev__source\">Verified Facebook Review</div>\n          </div>\n        </div>\n        <div class=\"dpg-rev__stars\">&#9733;&#9733;&#9733;&#9733;&#9733;</div>\n        <p class=\"dpg-rev__card-title\">Made the whole holiday so much better</p>\n        <p class=\"dpg-rev__card-text\">Our entire family would gather every morning to watch our pup open his toy. It became a ritual we all looked forward to. The packaging is stunning. 10 out of 10.</p>\n        <div class=\"dpg-rev__card-footer\">\n          <span class=\"dpg-rev__date\">January 2026</span>\n          <span class=\"dpg-rev__verified\">&#10003; Verified Purchase</span>\n        </div>\n      </div>\n      <div class=\"dpg-rev__card\">\n        <div class=\"dpg-rev__card-top\">\n          <div class=\"dpg-rev__avatar\">M</div>\n          <div>\n            <div class=\"dpg-rev__name\">Mike B.</div>\n            <div class=\"dpg-rev__source\">Verified Facebook Review</div>\n          </div>\n        </div>\n        <div class=\"dpg-rev__stars\">&#9733;&#9733;&#9733;&#9733;&#9733;</div>\n        <p class=\"dpg-rev__card-title\">Shipped fast, arrived perfect</p>\n        <p class=\"dpg-rev__card-text\">Ordered a little late and it still arrived in time. My golden went wild every morning without fail. The rope toys are his favorite. This is now a yearly tradition in our house.</p>\n        <div class=\"dpg-rev__card-footer\">\n          <span class=\"dpg-rev__date\">December 2025</span>\n          <span class=\"dpg-rev__verified\">&#10003; Verified Purchase</span>\n        </div>\n      </div>\n      <div class=\"dpg-rev__card\">\n        <div class=\"dpg-rev__card-top\">\n          <div class=\"dpg-rev__avatar\">A</div>\n          <div>\n            <div class=\"dpg-rev__name\">Amanda C.</div>\n            <div class=\"dpg-rev__source\">Verified Facebook Review</div>\n          </div>\n        </div>\n        <div class=\"dpg-rev__stars\">&#9733;&#9733;&#9733;&#9733;&#9733;</div>\n        <p class=\"dpg-rev__card-title\">The best gift idea for dog owners</p>\n        <p class=\"dpg-rev__card-text\">Bought this as a gift for my sister and her dog. She sent me a video every single morning of the reaction. You absolutely cannot go wrong with this for any dog lover.</p>\n        <div class=\"dpg-rev__card-footer\">\n          <span class=\"dpg-rev__date\">November 2025</span>\n          <span class=\"dpg-rev__verified\">&#10003; Verified Purchase</span>\n        </div>\n      </div>\n    </div>\n  </div>\n</div>",
        "background_color": "",
        "section_width": "full-width",
        "padding-block-start": 0,
        "padding-block-end": 0
      }
    }
  },
