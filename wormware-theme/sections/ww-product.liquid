{{ "warmwear-complete.css" | asset_url | stylesheet_tag }}

<div class="ww-hero">
  <div class="ww-hero__inner">
    <div class="ww-gallery">
      <div class="ww-main-image">
        <div style="width: 100%; height: 100%; background: #f5f3f0; display: flex; align-items: center; justify-content: center; color: #999;">Product Image</div>
      </div>
    </div>

    <div class="ww-details">
      <div class="ww-eyebrow">{{ section.settings.eyebrow }}</div>
      <h1 class="ww-title">{{ section.settings.product_name }}</h1>
      <div class="ww-rating">
        <span class="ww-stars">★★★★★</span>
        <span>{{ section.settings.rating }}</span>
      </div>

      <div class="ww-pricing">
        <span class="ww-price">{{ section.settings.price }}</span>
        <span class="ww-compare-price">{{ section.settings.compare_price }}</span>
        <span class="ww-discount">{{ section.settings.discount_text }}</span>
      </div>

      <div class="ww-bundles">
        <div class="ww-bundle-heading">{{ section.settings.bundle_heading }}</div>
        <div class="ww-bundle-option selected">
          <div class="ww-bundle-info">
            <span class="ww-bundle-label">Buy 1</span>
          </div>
          <span class="ww-bundle-price">{{ section.settings.price }}</span>
        </div>
        <div class="ww-bundle-option">
          <div class="ww-bundle-info">
            <span class="ww-bundle-label">Buy 2</span>
            <span class="ww-bundle-discount">{{ section.settings.tier2_discount }}% OFF</span>
          </div>
          <span class="ww-bundle-price">{{ section.settings.tier2_price }}</span>
        </div>
        <div class="ww-bundle-option">
          <div class="ww-bundle-info">
            <span class="ww-bundle-label">Buy 3</span>
            <span class="ww-bundle-discount">{{ section.settings.tier3_discount }}% OFF</span>
          </div>
          <span class="ww-bundle-price">{{ section.settings.tier3_price }}</span>
        </div>
      </div>

      <button class="ww-button">{{ section.settings.button_text }}</button>
      <div class="ww-button-subtext">{{ section.settings.button_subtext }}</div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Warm Wear Product",
  "settings": [
    {"type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Premium Heated Apparel"},
    {"type": "text", "id": "product_name", "label": "Product name", "default": "Warm Wear Heated Jacket"},
    {"type": "text", "id": "rating", "label": "Rating", "default": "4.9 out of 5 (485 reviews)"},
    {"type": "text", "id": "price", "label": "Price", "default": "$149.99 CAD"},
    {"type": "text", "id": "compare_price", "label": "Compare price", "default": "$299.98 CAD"},
    {"type": "text", "id": "discount_text", "label": "Discount", "default": "50% OFF"},
    {"type": "text", "id": "bundle_heading", "label": "Bundle heading", "default": "Choose your set"},
    {"type": "text", "id": "tier2_price", "label": "Tier 2 price", "default": "$269.98 CAD"},
    {"type": "text", "id": "tier2_discount", "label": "Tier 2 discount", "default": "10"},
    {"type": "text", "id": "tier3_price", "label": "Tier 3 price", "default": "$369.97 CAD"},
    {"type": "text", "id": "tier3_discount", "label": "Tier 3 discount", "default": "18"},
    {"type": "text", "id": "button_text", "label": "Button text", "default": "Add to Cart"},
    {"type": "text", "id": "button_subtext", "label": "Button subtext", "default": "Order today, ships within 48 hours"}
  ]
}
{% endschema %}
