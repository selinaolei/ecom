<div class="ww-reviews">
  <div class="ww-reviews__inner">
    <div class="ww-section-heading">
      <h2 class="ww-section-title">{{ section.settings.heading }}</h2>
      <p class="ww-section-subtitle">{{ section.settings.subheading }}</p>
    </div>

    <div class="ww-reviews-header">
      <div class="ww-rating-summary">
        <div class="ww-rating-number">{{ section.settings.average_rating }}</div>
        <div class="ww-rating-stars">
          <div class="ww-stars-display">★★★★★</div>
          <div class="ww-rating-count">Based on {{ section.settings.total_reviews }} reviews</div>
        </div>
      </div>
    </div>

    <div class="ww-reviews-grid">
      {% for block in section.blocks %}
        {% if block.type == 'review' %}
          <div class="ww-review-card">
            <div class="ww-review-header">
              {% if block.settings.avatar %}
                <img src="{{ block.settings.avatar | img_url: '40x40' }}" alt="" class="ww-review-avatar">
              {% else %}
                <div class="ww-review-avatar" style="background: #ddd; display: flex; align-items: center; justify-content: center; color: #999;">Avatar</div>
              {% endif %}
              <div class="ww-review-meta">
                <div class="ww-review-name">{{ block.settings.name }}</div>
                <div class="ww-review-rating">★★★★★ {{ block.settings.rating }}</div>
              </div>
            </div>
            <div class="ww-review-text">{{ block.settings.text }}</div>
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Reviews",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "What people say about Warm Wear"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Real reviews from real customers"
    },
    {
      "type": "text",
      "id": "average_rating",
      "label": "Average rating",
      "default": "4.9"
    },
    {
      "type": "text",
      "id": "total_reviews",
      "label": "Total reviews",
      "default": "485"
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        {
          "type": "image_picker",
          "id": "avatar",
          "label": "Avatar"
        },
        {
          "type": "text",
          "id": "name",
          "label": "Reviewer name",
          "default": "Sarah Johnson"
        },
        {
          "type": "text",
          "id": "rating",
          "label": "Rating",
          "default": "5 stars"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Review text",
          "default": "Best investment for winter! Keeps me warm even in -20°C. Highly recommend."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Reviews"
    }
  ]
}
{% endschema %}
