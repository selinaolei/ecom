{%- comment -%}
  Warm Wear – Gloves product hero
  Heated gloves bundle selector with 3-speed temperature control,
  optional add-ons (batteries, charging cables, etc).
{%- endcomment -%}
{%- liquid
  assign product = section.settings.product | default: product
  assign current_variant = product.selected_or_first_available_variant
  assign media_list = product.media
  assign features = section.blocks | where: 'type', 'feature'
  assign addons = section.blocks | where: 'type', 'addon'
  assign trusts = section.blocks | where: 'type', 'trust'

  assign color_option = product.options_with_values | where: 'name', 'Color' | first

  assign wm_orders_base = 16
  assign wm_seed = 'now' | date: '%j' | plus: 0 | times: 5 | modulo: 19
  assign wm_orders_today = wm_orders_base | plus: wm_seed

  assign wm_unit_price = current_variant.price
  assign wm_t2_qty = section.settings.tier2_qty
  assign wm_t2_pct = section.settings.tier2_discount_pct
  assign wm_t2_gross = wm_unit_price | times: wm_t2_qty
  assign wm_t2_off = wm_t2_gross | times: wm_t2_pct | divided_by: 100
  assign wm_t2_net = wm_t2_gross | minus: wm_t2_off

  assign wm_t3_qty = section.settings.tier3_qty
  assign wm_t3_pct = section.settings.tier3_discount_pct
  assign wm_t3_gross = wm_unit_price | times: wm_t3_qty
  assign wm_t3_off = wm_t3_gross | times: wm_t3_pct | divided_by: 100
  assign wm_t3_net = wm_t3_gross | minus: wm_t3_off
-%}

<section class="wmm" id="wm-gloves-{{ section.id }}" data-hm-product>
  <div class="wmm__inner">

    {%- comment -%} ===== GALLERY ===== {%- endcomment -%}
    <div class="wmm__gallery">
      <div class="wmm__main">
        {%- if section.settings.badge_text != blank -%}
          <span class="wmm__badge">{{ section.settings.badge_text }}</span>
        {%- endif -%}
        {%- if media_list.size > 0 -%}
          {%- assign first = media_list.first -%}
          <img
            data-hm-main-image
            src="{{ first | image_url: width: 1000 }}"
            srcset="{{ first | image_url: width: 600 }} 600w, {{ first | image_url: width: 1000 }} 1000w, {{ first | image_url: width: 1400 }} 1400w"
            sizes="(min-width: 990px) 560px, 100vw"
            width="1000" height="1000"
            alt="{{ first.alt | default: product.title | escape }}"
            fetchpriority="high"
          >
        {%- else -%}
          {{ 'product-1' | placeholder_svg_tag: 'wmm__placeholder' }}
        {%- endif -%}
        {%- if media_list.size > 1 -%}
          <button type="button" class="wmm__arrow wmm__arrow--prev" data-hm-prev aria-label="Previous image">&#8249;</button>
          <button type="button" class="wmm__arrow wmm__arrow--next" data-hm-next aria-label="Next image">&#8250;</button>
        {%- endif -%}
      </div>
      {%- if media_list.size > 1 -%}
        <div class="wmm__thumbs" role="list">
          {%- for media in media_list -%}
            <button
              type="button"
              role="listitem"
              class="wmm__thumb{% if forloop.first %} is-active{% endif %}"
              data-hm-thumb
              data-src="{{ media | image_url: width: 1000 }}"
              data-srcset="{{ media | image_url: width: 600 }} 600w, {{ media | image_url: width: 1000 }} 1000w, {{ media | image_url: width: 1400 }} 1400w"
              data-alt="{{ media.alt | default: product.title | escape }}"
              aria-label="Show image {{ forloop.index }}"
            >
              <img src="{{ media | image_url: width: 160 }}" width="80" height="80" loading="lazy" alt="">
            </button>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

    {%- comment -%} ===== DETAILS ===== {%- endcomment -%}
    <div class="wmm__details">

      {%- if section.settings.show_proof_bar -%}
        <p class="wmm__proof">
          <span class="wmm__proof-item"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3c1 4 5 5 5 10a5 5 0 0 1-10 0c0-2 1-3 2-4 0 2 1 3 2 3 0-3-1-5 1-9z"/></svg>{{ wm_orders_today }} ordered today</span>
        </p>
      {%- endif -%}

      {%- if section.settings.tag_text != blank -%}
        <span class="wmm__tag">{{ section.settings.tag_text }}</span>
      {%- endif -%}

      {%- if section.settings.eyebrow != blank -%}
        <span class="wmm__eyebrow">{{ section.settings.eyebrow }}</span>
      {%- endif -%}

      <h1 class="wmm__title">{{ section.settings.title_override | default: product.title }}</h1>

      <a class="wmm__rating" href="{{ section.settings.reviews_anchor | default: '#shopify-section-wm_gloves_reviews' }}" aria-label="Read customer reviews">
        <span class="wmm__stars" aria-hidden="true">
          {%- for i in (1..5) -%}
            <svg viewBox="0 0 20 20"><path d="M10 1.5l2.6 5.4 5.9.8-4.3 4.1 1.1 5.9L10 14.9l-5.3 2.8 1.1-5.9L1.5 7.7l5.9-.8z"/></svg>
          {%- endfor -%}
        </span>
        <span class="wmm__rating-text">{{ section.settings.rating_text }}</span>
        <span class="wmm__rating-arrow" aria-hidden="true">&rsaquo;</span>
      </a>

      <div class="wmm__price">
        <span class="wmm__price-now" data-hm-price-now>{{ current_variant.price | money }}</span>
        <s class="wmm__price-was" data-hm-price-was {% unless current_variant.compare_at_price > current_variant.price %}hidden{% endunless %}>{{ current_variant.compare_at_price | money }}</s>
        <span class="wmm__pill" data-hm-price-pill {% unless current_variant.compare_at_price > current_variant.price %}hidden{% endunless %}></span>
      </div>

      {%- if features.size > 0 -%}
        <ul class="wmm__features">
          {%- for block in features -%}
            <li {{ block.shopify_attributes }}>
              <span class="wmm__feature-icon" aria-hidden="true">
                {%- case block.settings.icon -%}
                  {%- when 'fire' -%}<svg viewBox="0 0 24 24"><path d="M12 2c1 3 2 6 2 9 0 3.3-1.8 6-4 6s-4-2.7-4-6c0-3 1-6 2-9M8 20c1.1 0 1 .9 2 .9s.9-.9 2-.9M10 20c1.1 0 1 1.5 2 1.5s.9-1.5 2-1.5"/></svg>
                  {%- when 'battery' -%}<svg viewBox="0 0 24 24"><rect x="3" y="8" width="14" height="8" rx="1"/><rect x="18" y="10" width="2" height="4" rx="0.5"/></svg>
                  {%- when 'thermometer' -%}<svg viewBox="0 0 24 24"><circle cx="12" cy="18" r="2"/><path d="M12 18V4M9 6h6v4H9z"/></svg>
                  {%- when 'star' -%}<svg viewBox="0 0 24 24"><path d="M12 2l2.6 6.4 6.9.5-5.3 4.4 1.8 6.7L12 16.5l-6 3.5 1.8-6.7-5.3-4.4 6.9-.5z"/></svg>
                  {%- when 'truck' -%}<svg viewBox="0 0 24 24"><path d="M3 7h11v9H3zM14 10h4l3 3v3h-7z"/><circle cx="7" cy="17.5" r="1.8"/><circle cx="17" cy="17.5" r="1.8"/></svg>
                  {%- when 'shield' -%}<svg viewBox="0 0 24 24"><path d="M12 3l7 3v5c0 5-3.5 8.5-7 10-3.5-1.5-7-5-7-10V6z"/><path d="M9 12l2 2 4-4"/></svg>
                  {%- else -%}<svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M8 12.5l2.5 2.5L16 9.5"/></svg>
                {%- endcase -%}
              </span>
              <span>{{ block.settings.text }}</span>
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}

      {%- comment -%} ===== VARIANT PICKER: Color ===== {%- endcomment -%}
      {%- if color_option -%}
        <div class="wmm__variants">
          <div class="wmm__opt-group">
            <p class="wmm__opt-label">Color: <span data-hm-color-label>{{ current_variant.option1 }}</span></p>
            <div class="wmm__swatches" role="radiogroup" aria-label="Color">
              {%- for value in color_option.values -%}
                <button
                  type="button"
                  class="wmm__swatch{% if value == current_variant.option1 %} is-active{% endif %}"
                  data-hm-color="{{ value | escape }}"
                  style="--swatch-color: {% if value == 'Black' %}#1A1A1A{% elsif value == 'Navy' %}#1E3A5F{% elsif value == 'Charcoal' %}#36454F{% else %}#ccc{% endif %};"
                  role="radio"
                  aria-checked="{% if value == current_variant.option1 %}true{% else %}false{% endif %}"
                  aria-label="{{ value }}"
                ></button>
              {%- endfor -%}
            </div>
          </div>
          {%- if section.settings.size_note != blank -%}
            <p class="wmm__size-guide">{{ section.settings.size_note }}</p>
          {%- endif -%}
        </div>
      {%- endif -%}

      {%- comment -%} ===== BUNDLE TIERS (Expandable Rows) ===== {%- endcomment -%}
      {%- if section.settings.show_bundle_tiers -%}
        <div class="wmm__bundle">
          <p class="wmm__label wmm__label--center"><span>{{ section.settings.bundle_heading }}</span></p>
          <div class="wmm__tiers" data-hm-tiers>
            {%- comment -%} TIER 1: 1 Glove {%- endcomment -%}
            <div class="wmm__tier is-active" data-hm-tier="1">
              <button type="button" class="wmm__tier-head" data-hm-tier-select aria-expanded="true">
                <span class="wmm__radio" aria-hidden="true"></span>
                <span class="wmm__tier-info">
                  <span class="wmm__tier-name">1 Pair</span>
                </span>
                <span class="wmm__tier-pricing">
                  <span class="wmm__tier-now" data-hm-tier-now>{{ wm_unit_price | money }}</span>
                </span>
              </button>
              <div class="wmm__tier-body">
                <div class="wmm__tier-shipping-badge">FREE SHIPPING</div>
                {%- if addons.size > 0 -%}
                  <div class="wmm__addons">
                    {%- for ab in addons -%}
                      {%- assign aidx = forloop.index0 -%}
                      {%- assign ap = ab.settings.product -%}
                      {%- assign av = ap.selected_or_first_available_variant -%}
                      <label class="wmm__addon{% if ab.settings.default_on %} is-on{% endif %}" data-hm-addon="{{ aidx }}">
                        <input type="checkbox" class="wmm__check-input" data-hm-addon-input="{{ aidx }}" {% if ab.settings.default_on %}checked{% endif %} {% unless av %}disabled{% endunless %} aria-label="Add {{ ab.settings.title | default: ap.title | escape }}">
                        <span class="wmm__checkbox" aria-hidden="true"><svg viewBox="0 0 20 20"><path d="M4 10.5l4 4 8-9" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
                        <span class="wmm__addon-title">{{ ab.settings.title | default: ap.title }}</span>
                        <span class="wmm__addon-price">{%- if av -%}{{ av.price | money }}{%- else -%}<em>Pick product</em>{%- endif -%}</span>
                      </label>
                    {%- endfor -%}
                  </div>
                {%- endif -%}
              </div>
            </div>

            {%- comment -%} TIER 2: 2 Gloves - Most Popular {%- endcomment -%}
            <div class="wmm__tier" data-hm-tier="{{ wm_t2_qty }}">
              {%- if wm_t2_qty > 1 -%}<span class="wmm__tier-tag">MOST POPULAR</span>{%- endif -%}
              <button type="button" class="wmm__tier-head" data-hm-tier-select aria-expanded="false">
                <span class="wmm__radio" aria-hidden="true"></span>
                <span class="wmm__tier-info">
                  <span class="wmm__tier-name">{{ wm_t2_qty }} Pairs
                    <span class="wmm__tier-save" data-hm-tier-save hidden></span>
                  </span>
                </span>
                <span class="wmm__tier-pricing">
                  <span class="wmm__tier-now" data-hm-tier-now>{{ wm_t2_net | money }}</span>
                  <s class="wmm__tier-was" data-hm-tier-was hidden>{{ wm_t2_gross | money }}</s>
                </span>
              </button>
              <div class="wmm__tier-body">
                <div class="wmm__tier-shipping-badge">FREE SHIPPING</div>
                {%- if addons.size > 0 -%}
                  <div class="wmm__addons">
                    {%- for ab in addons -%}
                      {%- assign aidx = forloop.index0 -%}
                      {%- assign ap = ab.settings.product -%}
                      {%- assign av = ap.selected_or_first_available_variant -%}
                      <label class="wmm__addon{% if ab.settings.default_on %} is-on{% endif %}" data-hm-addon="{{ aidx }}">
                        <input type="checkbox" class="wmm__check-input" data-hm-addon-input="{{ aidx }}" {% if ab.settings.default_on %}checked{% endif %} {% unless av %}disabled{% endunless %} aria-label="Add {{ ab.settings.title | default: ap.title | escape }}">
                        <span class="wmm__checkbox" aria-hidden="true"><svg viewBox="0 0 20 20"><path d="M4 10.5l4 4 8-9" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
                        <span class="wmm__addon-title">{{ ab.settings.title | default: ap.title }}</span>
                        <span class="wmm__addon-price">{%- if av -%}{{ av.price | money }}{%- else -%}<em>Pick product</em>{%- endif -%}</span>
                      </label>
                    {%- endfor -%}
                  </div>
                {%- endif -%}
              </div>
            </div>

            {%- comment -%} TIER 3: 3 Gloves - Most Value {%- endcomment -%}
            <div class="wmm__tier" data-hm-tier="{{ wm_t3_qty }}">
              {%- if wm_t3_qty > 1 -%}<span class="wmm__tier-tag">MOST VALUE</span>{%- endif -%}
              <button type="button" class="wmm__tier-head" data-hm-tier-select aria-expanded="false">
                <span class="wmm__radio" aria-hidden="true"></span>
                <span class="wmm__tier-info">
                  <span class="wmm__tier-name">{{ wm_t3_qty }} Pairs
                    <span class="wmm__tier-save" data-hm-tier-save hidden></span>
                  </span>
                </span>
                <span class="wmm__tier-pricing">
                  <span class="wmm__tier-now" data-hm-tier-now>{{ wm_t3_net | money }}</span>
                  <s class="wmm__tier-was" data-hm-tier-was hidden>{{ wm_t3_gross | money }}</s>
                </span>
              </button>
              <div class="wmm__tier-body">
                <div class="wmm__tier-shipping-badge">FREE SHIPPING</div>
                <div class="wmm__tier-bonus-banner">+ Free mystery gift</div>
                {%- if addons.size > 0 -%}
                  <div class="wmm__addons">
                    {%- for ab in addons -%}
                      {%- assign aidx = forloop.index0 -%}
                      {%- assign ap = ab.settings.product -%}
                      {%- assign av = ap.selected_or_first_available_variant -%}
                      <label class="wmm__addon{% if ab.settings.default_on %} is-on{% endif %}" data-hm-addon="{{ aidx }}">
                        <input type="checkbox" class="wmm__check-input" data-hm-addon-input="{{ aidx }}" {% if ab.settings.default_on %}checked{% endif %} {% unless av %}disabled{% endunless %} aria-label="Add {{ ab.settings.title | default: ap.title | escape }}">
                        <span class="wmm__checkbox" aria-hidden="true"><svg viewBox="0 0 20 20"><path d="M4 10.5l4 4 8-9" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
                        <span class="wmm__addon-title">{{ ab.settings.title | default: ap.title }}</span>
                        <span class="wmm__addon-price">{%- if av -%}{{ av.price | money }}{%- else -%}<em>Pick product</em>{%- endif -%}</span>
                      </label>
                    {%- endfor -%}
                  </div>
                {%- endif -%}
              </div>
            </div>
          </div>
        </div>
      {%- endif -%}

      {%- comment -%} ===== ADD TO CART ===== {%- endcomment -%}
      <div class="wmm__buy">
        <button type="button" class="wmm__atc" data-hm-atc {% unless current_variant.available %}disabled{% endunless %}>
          <span class="wmm__atc-label" data-hm-btn-label>{{ section.settings.button_text }}</span>
          <span class="wmm__atc-spinner" aria-hidden="true"></span>
        </button>
        {%- if section.settings.button_subtext != blank -%}
          <p class="wmm__atc-sub"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 7h11v9H3zM14 10h4l3 3v3h-7z"/><circle cx="7" cy="17.5" r="1.8"/><circle cx="17" cy="17.5" r="1.8"/></svg>{{ section.settings.button_subtext }}</p>
        {%- endif -%}
        <p class="wmm__error" data-hm-error hidden role="alert"></p>
        <ul class="wmm__guarantees" aria-label="Guarantees">
          <li><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3l7 3v5c0 5-3.5 8.5-7 10-3.5-1.5-7-5-7-10V6z"/><path d="M9 12l2 2 4-4"/></svg>30-day guarantee</li>
          <li><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="5" y="10" width="14" height="10" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/></svg>Secure checkout</li>
          <li><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 7h11v9H3zM14 10h4l3 3v3h-7z"/><circle cx="7" cy="17.5" r="1.8"/><circle cx="17" cy="17.5" r="1.8"/></svg>Free shipping</li>
        </ul>
      </div>

      {%- if section.settings.show_payment_icons -%}
        <div class="wmm__payments" aria-label="Accepted payment methods">
          {%- for type in shop.enabled_payment_types -%}
            {{ type | payment_type_svg_tag: class: 'wmm__payment-icon' }}
          {%- endfor -%}
        </div>
      {%- endif -%}

      {%- if trusts.size > 0 -%}
        <ul class="wmm__trust">
          {%- for block in trusts -%}
            <li {{ block.shopify_attributes }}>
              <span class="wmm__trust-icon" aria-hidden="true">
                {%- case block.settings.icon -%}
                  {%- when 'truck' -%}<svg viewBox="0 0 24 24"><path d="M3 7h11v9H3zM14 10h4l3 3v3h-7z"/><circle cx="7" cy="17.5" r="1.8"/><circle cx="17" cy="17.5" r="1.8"/></svg>
                  {%- when 'lock' -%}<svg viewBox="0 0 24 24"><rect x="5" y="10" width="14" height="10" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/></svg>
                  {%- when 'shield' -%}<svg viewBox="0 0 24 24"><path d="M12 3l7 3v5c0 5-3.5 8.5-7 10-3.5-1.5-7-5-7-10V6z"/><path d="M9 12l2 2 4-4"/></svg>
                  {%- when 'star' -%}<svg viewBox="0 0 24 24"><path d="M12 2l2.6 6.4 6.9.5-5.3 4.4 1.8 6.7L12 16.5l-6 3.5 1.8-6.7-5.3-4.4 6.9-.5z"/></svg>
                  {%- else -%}<svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M8 12.5l2.5 2.5L16 9.5"/></svg>
                {%- endcase -%}
              </span>
              <span>{{ block.settings.text }}</span>
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}

      {%- if section.settings.show_description and product.description != blank -%}
        <details class="wmm__desc">
          <summary>{{ section.settings.description_label }}</summary>
          <div class="wmm__desc-body rte">{{ product.description }}</div>
        </details>
      {%- endif -%}
    </div>
  </div>

  {%- if section.settings.sticky_bar -%}
    <div class="wmm__sticky" data-hm-sticky>
      <div class="wmm__sticky-inner">
        {%- if product.featured_media -%}<img src="{{ product.featured_media | image_url: width: 100 }}" width="48" height="48" alt="" loading="lazy" data-hm-sticky-img>{%- endif -%}
        <div class="wmm__sticky-meta">
          <strong>{{ product.title }}</strong>
          <span><s data-hm-sticky-was hidden></s> <b data-hm-sticky-total></b></span>
        </div>
        <button type="button" class="wmm__sticky-btn" data-hm-sticky-atc>{{ section.settings.button_text }}</button>
      </div>
    </div>
  {%- endif -%}

  <script type="application/json" data-hm-config>
    {
      "productId": {{ product.id | json }},
      "selectedVariantId": {{ current_variant.id | json }},
      "moneyFormat": {{ shop.money_format | json }},
      "variants": [
        {%- for variant in product.variants -%}
          {%- assign img_index = -1 -%}
          {%- if variant.featured_media -%}
            {%- for media in media_list -%}
              {%- if media.id == variant.featured_media.id -%}{%- assign img_index = forloop.index0 -%}{%- endif -%}
            {%- endfor -%}
          {%- endif -%}
          { "id": {{ variant.id | json }}, "title": {{ variant.title | json }}, "option1": {{ variant.option1 | json }}, "price": {{ variant.price | json }}, "compareAtPrice": {{ variant.compare_at_price | default: 0 | json }}, "available": {{ variant.available | json }}, "imageIndex": {{ img_index }} }{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ],
      "addons": [
        {%- for block in addons -%}
          {%- assign ap = block.settings.product -%}
          {%- assign av = ap.selected_or_first_available_variant -%}
          { "variantId": {{ av.id | default: null | json }}, "price": {{ av.price | default: 0 | json }}, "defaultOn": {{ block.settings.default_on | json }} }{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ],
      "tiers": [
        { "qty": 1, "pct": 0 },
        { "qty": {{ wm_t2_qty | json }}, "pct": {{ wm_t2_pct | json }} },
        { "qty": {{ wm_t3_qty | json }}, "pct": {{ wm_t3_pct | json }} }
      ],
      "text": {
        "addToCart": {{ section.settings.button_text | json }},
        "soldOut": "Sold out",
        "save": "Save",
        "savePct": "SAVE {pct}%"
      }
    }
  </script>
</section>

<script type="module" src="{{ 'wm-product.js' | asset_url }}"></script>

{% stylesheet %}
  .wmm { --wm-orange: #FF6B35; --wm-orange-2: #FF5722; --wm-black: #1A1A1A; --wm-accent: #FFA500; --wm-cream: #FFF8F0; --wm-ink: #1A1A1A; --wm-muted: #7A756D; --wm-line: #FFEEE1; --wm-radius: 14px;
    background: #fff; color: var(--wm-ink); font-family: var(--font-body--family, Inter, sans-serif); padding: 12px 0 40px; width: 100%; max-width: 100%; overflow-x: clip; }
  .wmm *, .wmm *::before, .wmm *::after { box-sizing: border-box; min-width: 0; }
  html { scroll-behavior: smooth; }
  body { overflow-x: clip; }
  .wm-section, .shopify-section:has(> .wm-section) { max-width: 100%; overflow-x: clip; }
  [id^="shopify-section-wm_"] { scroll-margin-top: 90px; }
  .wmm__inner { max-width: 1200px; margin: 0 auto; padding: 0 16px; display: grid; gap: 22px; }
  @media (min-width: 990px) {
    .wmm { padding: 32px 0 64px; }
    .wmm__inner { grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr); gap: 56px; align-items: start; padding: 0 32px; }
    .wmm__gallery { position: sticky; top: 90px; }
  }

  .wmm__main { position: relative; aspect-ratio: 1 / 1; border-radius: var(--wm-radius); overflow: hidden; background: var(--wm-black); }
  .wmm__main img, .wmm__placeholder { width: 100%; height: 100%; object-fit: cover; display: block; }
  .wmm__badge { position: absolute; top: 14px; left: 14px; z-index: 2; background: var(--wm-accent); color: var(--wm-black); font-size: 11px; font-weight: 800; letter-spacing: 1.6px; text-transform: uppercase; padding: 7px 12px; border-radius: 999px; }
  .wmm__arrow { position: absolute; top: 50%; transform: translateY(-50%); width: 40px; height: 40px; border-radius: 50%; border: 0; background: rgba(255,255,255,.92); color: var(--wm-orange); font-size: 26px; line-height: 1; cursor: pointer; box-shadow: 0 4px 14px rgba(0,0,0,.12); display: flex; align-items: center; justify-content: center; }
  .wmm__arrow--prev { left: 12px; } .wmm__arrow--next { right: 12px; }
  .wmm__thumbs { display: flex; gap: 8px; margin-top: 10px; overflow-x: auto; scrollbar-width: none; padding-bottom: 4px; }
  .wmm__thumbs::-webkit-scrollbar { display: none; }
  .wmm__thumb { flex: 0 0 auto; width: 68px; height: 68px; padding: 0; border-radius: 10px; overflow: hidden; border: 2px solid transparent; background: var(--wm-black); cursor: pointer; opacity: .75; transition: .2s; }
  .wmm__thumb img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .wmm__thumb.is-active { border-color: var(--wm-accent); opacity: 1; }

  .wmm__proof { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; margin: 0 0 10px; font-size: 13px; font-weight: 700; color: var(--wm-orange-2); }
  .wmm__proof-item { display: inline-flex; align-items: center; gap: 6px; background: var(--wm-cream); border-radius: 999px; padding: 6px 12px; }
  .wmm__proof-item svg { width: 15px; height: 15px; fill: none; stroke: var(--wm-orange); stroke-width: 1.8; stroke-linejoin: round; }
  .wmm__tag { display: inline-block; background: var(--wm-black); color: var(--wm-accent); font-size: 11px; font-weight: 800; letter-spacing: 1px; text-transform: uppercase; padding: 6px 14px; border-radius: 4px; margin-bottom: 12px; }
  .wmm__eyebrow { display: inline-block; font-size: 11px; font-weight: 700; letter-spacing: 2.5px; text-transform: uppercase; color: var(--wm-orange); margin-bottom: 8px; }
  .wmm__title { font-family: var(--font-heading--family, inherit); font-size: clamp(28px, 4.5vw, 40px); font-weight: 900; line-height: 1.05; letter-spacing: -0.5px; margin: 0 0 10px; color: var(--wm-black); }
  .wmm__rating { display: inline-flex; align-items: center; gap: 8px; margin-bottom: 12px; text-decoration: none; color: inherit; border-bottom: 1px dashed var(--wm-accent); padding-bottom: 2px; }
  .wmm__rating:hover .wmm__rating-text { color: var(--wm-orange); text-decoration: underline; }
  .wmm__rating-arrow { color: var(--wm-accent); font-size: 20px; line-height: 1; }
  .wmm__stars { display: inline-flex; gap: 2px; }
  .wmm__stars svg { width: 16px; height: 16px; fill: var(--wm-accent); }
  .wmm__rating-text { font-size: 13px; font-weight: 600; color: var(--wm-ink); }
  .wmm__price { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; margin-bottom: 16px; }
  .wmm__price-now { font-size: 30px; font-weight: 900; color: var(--wm-orange); letter-spacing: -0.5px; }
  .wmm__price-was { font-size: 18px; color: #a89a8c; }
  .wmm__pill { background: var(--wm-accent); color: var(--wm-black); font-size: 11px; font-weight: 800; letter-spacing: 1px; padding: 5px 10px; border-radius: 999px; }
  @media (max-width: 749px) { .wmm__title { font-size: 26px; } .wmm__price-now { font-size: 26px; } .wmm__price-was { font-size: 16px; } }

  .wmm__features { list-style: none; margin: 0 0 22px; padding: 0; display: grid; gap: 10px; }
  .wmm__features li { display: flex; gap: 12px; align-items: center; font-size: 14px; font-weight: 600; line-height: 1.4; }
  .wmm__feature-icon { flex: 0 0 34px; width: 34px; height: 34px; border-radius: 50%; background: var(--wm-black); border: 1px solid var(--wm-black); display: inline-flex; align-items: center; justify-content: center; }
  .wmm__feature-icon svg { width: 17px; height: 17px; fill: none; stroke: var(--wm-accent); stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }

  .wmm__label { font-size: 12px; font-weight: 700; letter-spacing: 1.8px; text-transform: uppercase; color: var(--wm-ink); margin: 0 0 12px; }
  .wmm__label--center { text-align: center; position: relative; }
  .wmm__label--center::before { content: ""; position: absolute; left: 0; right: 0; top: 50%; height: 1px; background: var(--wm-line); }
  .wmm__label--center span { position: relative; background: #fff; padding: 0 12px; }

  .wmm__bundle { margin-bottom: 18px; }
  .wmm__tiers { display: grid; gap: 12px; }
  .wmm__tier { position: relative; border-radius: var(--wm-radius); border: 1.5px solid var(--wm-line); background: #fff; transition: .15s; }
  .wmm__tier:hover { border-color: var(--wm-orange); }
  .wmm__tier.is-active { border-color: var(--wm-orange); box-shadow: 0 0 0 1.5px var(--wm-orange) inset; background: var(--wm-cream); }
  .wmm__tier-tag { position: absolute; top: -10px; right: 14px; background: var(--wm-orange); color: #fff; font-size: 10px; font-weight: 800; letter-spacing: 1px; text-transform: uppercase; padding: 4px 9px; border-radius: 999px; }
  .wmm__tier-head { width: 100%; display: flex; align-items: center; gap: 12px; padding: 16px 14px; border: 0; background: none; font: inherit; color: var(--wm-ink); text-align: left; cursor: pointer; }
  .wmm__radio { flex: 0 0 20px; width: 20px; height: 20px; border-radius: 50%; border: 2px solid #d8c8b3; background: #fff; position: relative; }
  .wmm__tier.is-active .wmm__radio { border-color: var(--wm-orange); }
  .wmm__tier.is-active .wmm__radio::after { content: ""; position: absolute; inset: 3px; border-radius: 50%; background: var(--wm-orange); }
  .wmm__tier-info { flex: 1; display: flex; flex-direction: column; gap: 2px; }
  .wmm__tier-name { font-size: 16px; font-weight: 800; display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
  .wmm__tier-save { background: #E9F4EC; color: #1f7a3a; font-size: 11px; font-weight: 800; padding: 3px 8px; border-radius: 999px; letter-spacing: .3px; }
  .wmm__tier-pricing { display: flex; flex-direction: column; align-items: flex-end; line-height: 1.2; }
  .wmm__tier-now { font-size: 17px; font-weight: 800; color: var(--wm-orange); }
  .wmm__tier-was { font-size: 12px; color: #a89a8c; }
  .wmm__tier-body { display: none; padding: 0 14px 14px 46px; }
  .wmm__tier.is-active .wmm__tier-body { display: block; }
  @media (max-width: 749px) { .wmm__tier-body { padding-left: 14px; } }

  .wmm__tier-shipping-badge { display: inline-block; background: #E8F4FF; color: #0066CC; font-size: 11px; font-weight: 800; letter-spacing: .8px; text-transform: uppercase; padding: 5px 12px; border-radius: 4px; width: fit-content; }
  .wmm__tier-bonus-banner { display: flex; align-items: center; gap: 8px; background: #E8F4FF; color: #0066CC; font-size: 12px; font-weight: 700; padding: 10px 12px; border-radius: 8px; text-align: center; justify-content: center; margin-top: 8px; }

  .wmm__addons { display: grid; gap: 6px; margin-top: 8px; padding-top: 12px; border-top: 1px solid var(--wm-line); }
  .wmm__addon { display: grid; grid-template-columns: 22px 30px 1fr auto; gap: 10px; align-items: center; padding: 7px 10px; border: 1px solid var(--wm-line); border-radius: 10px; background: #fff; cursor: pointer; transition: .15s; }
  .wmm__addon.is-on { border-color: var(--wm-orange); background: var(--wm-cream); }
  .wmm__check-input { position: absolute; opacity: 0; width: 0; height: 0; }
  .wmm__checkbox { width: 22px; height: 22px; border-radius: 6px; border: 2px solid #d8c8b3; background: #fff; display: inline-flex; align-items: center; justify-content: center; color: #fff; transition: .15s; }
  .wmm__checkbox svg { width: 14px; height: 14px; opacity: 0; transform: scale(.6); transition: .15s; }
  .wmm__check-input:checked + .wmm__checkbox { background: var(--wm-orange); border-color: var(--wm-orange); }
  .wmm__check-input:checked + .wmm__checkbox svg { opacity: 1; transform: scale(1); }
  .wmm__check-input:focus-visible + .wmm__checkbox { outline: 2px solid var(--wm-accent); outline-offset: 2px; }
  .wmm__check-input:disabled + .wmm__checkbox { opacity: .4; }
  .wmm__addon-title { font-size: 13px; font-weight: 600; line-height: 1.2; }
  .wmm__addon-price { font-size: 13px; font-weight: 700; color: var(--wm-orange); }
  .wmm__addon-price em { font-style: normal; font-size: 11px; color: #d1643a; }

  .wmm__variants { margin-bottom: 18px; display: grid; gap: 10px; }
  .wmm__opt-label { font-size: 13px; font-weight: 700; margin: 0 0 8px; }
  .wmm__opt-label span { font-weight: 800; color: var(--wm-orange); }
  .wmm__swatches { display: flex; gap: 10px; }
  .wmm__swatch { width: 40px; height: 40px; border-radius: 50%; border: 2px solid transparent; padding: 3px; cursor: pointer; background: #fff; box-shadow: 0 0 0 1.5px var(--wm-line); position: relative; }
  .wmm__swatch::before { content: ""; position: absolute; inset: 5px; border-radius: 50%; background: var(--swatch-color); }
  .wmm__swatch.is-active { box-shadow: 0 0 0 2px var(--wm-orange); }
  .wmm__size-guide { margin: 0; font-size: 12px; color: var(--wm-muted); }

  .wmm__buy { margin-top: 4px; }
  .wmm__atc { position: relative; width: 100%; display: flex; align-items: center; justify-content: center; padding: 18px 20px; border: 0; border-radius: var(--wm-radius); background: linear-gradient(135deg, #FF6B35 0%, #FF5722 60%, #FF6B35 100%); color: #fff; font: inherit; font-size: 17px; font-weight: 900; letter-spacing: .4px; text-transform: uppercase; cursor: pointer; transition: .15s; box-shadow: 0 12px 28px rgba(255,87,34,.32), inset 0 0 0 1.5px rgba(255,165,0,.55); animation: wmm-pulse 2.4s ease-in-out infinite; }
  .wmm__atc:hover { transform: translateY(-1px); box-shadow: 0 14px 30px rgba(255,87,34,.4), inset 0 0 0 1.5px var(--wm-accent); animation: none; }
  .wmm__atc:disabled { background: #b9b0a5; box-shadow: none; cursor: not-allowed; animation: none; }
  @keyframes wmm-pulse { 0%, 100% { box-shadow: 0 12px 28px rgba(255,87,34,.32), inset 0 0 0 1.5px rgba(255,165,0,.55), 0 0 0 0 rgba(255,165,0,.45); } 50% { box-shadow: 0 12px 28px rgba(255,87,34,.32), inset 0 0 0 1.5px rgba(255,165,0,.55), 0 0 0 8px rgba(255,165,0,0); } }
  @media (prefers-reduced-motion: reduce) { .wmm__atc { animation: none; } }
  .wmm__atc-spinner { display: none; position: absolute; right: 20px; top: 50%; width: 18px; height: 18px; margin-top: -9px; border: 2px solid rgba(255,255,255,.35); border-top-color: #fff; border-radius: 50%; animation: wmm-spin .7s linear infinite; }
  .wmm__atc.is-loading .wmm__atc-spinner { display: block; }
  .wmm__atc.is-added .wmm__atc-label::after { content: " \2713"; }
  @keyframes wmm-spin { to { transform: rotate(360deg); } }
  .wmm__atc-sub { display: flex; align-items: center; justify-content: center; gap: 6px; margin: 10px 0 0; font-size: 12px; font-weight: 600; color: var(--wm-orange); }
  .wmm__atc-sub svg { width: 16px; height: 16px; fill: none; stroke: var(--wm-orange); stroke-width: 1.7; stroke-linecap: round; stroke-linejoin: round; }
  .wmm__error { color: #d1643a; font-size: 13px; margin: 8px 0 0; text-align: center; }
  .wmm__guarantees { list-style: none; margin: 12px 0 0; padding: 0; display: flex; justify-content: center; flex-wrap: wrap; gap: 6px 14px; font-size: 11px; font-weight: 600; color: var(--wm-muted); }
  .wmm__guarantees li { display: inline-flex; align-items: center; gap: 5px; }
  .wmm__guarantees svg { width: 14px; height: 14px; fill: none; stroke: var(--wm-accent); stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }

  .wmm__payments { display: flex; flex-wrap: wrap; justify-content: center; gap: 6px; margin: 14px 0 4px; }
  .wmm__payment-icon { width: 38px; height: 24px; border-radius: 4px; }

  .wmm__trust { list-style: none; margin: 16px 0 0; padding: 14px 0 0; border-top: 1px solid var(--wm-line); display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px 16px; }
  .wmm__trust li { display: flex; align-items: center; gap: 10px; font-size: 13px; font-weight: 600; }
  .wmm__trust-icon { flex: 0 0 36px; width: 36px; height: 36px; border-radius: 50%; background: var(--wm-cream); display: inline-flex; align-items: center; justify-content: center; }
  .wmm__trust-icon svg { width: 18px; height: 18px; fill: none; stroke: var(--wm-orange); stroke-width: 1.7; stroke-linecap: round; stroke-linejoin: round; }

  .wmm__desc { margin-top: 18px; border-top: 1px solid var(--wm-line); border-bottom: 1px solid var(--wm-line); }
  .wmm__desc summary { cursor: pointer; padding: 14px 0; font-weight: 700; font-size: 14px; list-style: none; display: flex; justify-content: space-between; }
  .wmm__desc summary::-webkit-details-marker { display: none; }
  .wmm__desc summary::after { content: "+"; font-size: 18px; color: var(--wm-accent); }
  .wmm__desc[open] summary::after { content: "\2013"; }
  .wmm__desc-body { padding: 0 0 16px; font-size: 14px; line-height: 1.7; color: var(--wm-muted); }

  .wmm__sticky { position: fixed; left: 0; right: 0; bottom: 0; z-index: 40; background: #fff; border-top: 1px solid var(--wm-line); box-shadow: 0 -8px 24px rgba(0,0,0,.08); transform: translateY(110%); transition: transform .25s; padding: 10px 16px calc(10px + env(safe-area-inset-bottom)); }
  .wmm__sticky.is-visible { transform: translateY(0); }
  .wmm__sticky-inner { max-width: 1200px; margin: 0 auto; display: flex; align-items: center; gap: 12px; }
  .wmm__sticky img { width: 44px; height: 44px; border-radius: 8px; object-fit: cover; }
  .wmm__sticky-meta { flex: 1; min-width: 0; display: flex; flex-direction: column; font-size: 13px; }
  .wmm__sticky-meta strong { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .wmm__sticky-meta span { color: var(--wm-orange); font-weight: 800; }
  .wmm__sticky-meta s { color: #a89a8c; font-weight: 500; font-size: 12px; margin-right: 3px; }
  .wmm__sticky-btn { border: 0; border-radius: 10px; background: var(--wm-orange); color: #fff; font: inherit; font-weight: 800; font-size: 14px; padding: 12px 18px; cursor: pointer; }
{% endstylesheet %}

{% schema %}
{
  "name": "WM Gloves hero",
  "tag": "section",
  "class": "wm-section",
  "settings": [
    { "type": "product", "id": "product", "label": "Product", "info": "Leave empty to use the current page product." },
    { "type": "checkbox", "id": "show_proof_bar", "label": "Show \"ordered today\" proof bar", "default": true },
    { "type": "text", "id": "tag_text", "label": "Tag line" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "title_override", "label": "Title override" },
    { "type": "text", "id": "badge_text", "label": "Image badge", "default": "Best seller" },
    { "type": "text", "id": "rating_text", "label": "Rating text", "default": "Rated 4.9 based on 425 reviews" },
    { "type": "text", "id": "reviews_anchor", "label": "Reviews link (anchor)", "default": "#shopify-section-wm_gloves_reviews" },
    { "type": "text", "id": "size_note", "label": "Size note", "default": "One size fits most. 3-speed control: High (55°C) • Middle (45°C) • Low (35°C)" },
    { "type": "checkbox", "id": "show_bundle_tiers", "label": "Show multi-pack bundle selector", "default": true },
    { "type": "text", "id": "bundle_heading", "label": "Bundle heading", "default": "Choose your pair" },
    { "type": "text", "id": "bundle_addon_note", "label": "Bundle note (2 & 3 packs)", "default": "Add batteries and charging cables" },
    { "type": "range", "id": "tier2_qty", "label": "Tier 2 quantity", "min": 2, "max": 5, "step": 1, "default": 2 },
    { "type": "range", "id": "tier2_discount_pct", "label": "Tier 2 discount %", "min": 0, "max": 50, "step": 1, "default": 10 },
    { "type": "range", "id": "tier3_qty", "label": "Tier 3 quantity", "min": 2, "max": 6, "step": 1, "default": 3 },
    { "type": "range", "id": "tier3_discount_pct", "label": "Tier 3 discount %", "min": 0, "max": 60, "step": 1, "default": 18 },
    { "type": "text", "id": "addons_heading", "label": "Add-ons heading", "default": "Accessories" },
    { "type": "text", "id": "button_text", "label": "Button text", "default": "Add to cart" },
    { "type": "text", "id": "button_subtext", "label": "Text under button", "default": "Order today, ships within 48 hours" },
    { "type": "checkbox", "id": "show_payment_icons", "label": "Show payment icons", "default": true },
    { "type": "checkbox", "id": "show_description", "label": "Show product description accordion", "default": true },
    { "type": "text", "id": "description_label", "label": "Description label", "default": "Features & specs" },
    { "type": "checkbox", "id": "sticky_bar", "label": "Sticky add-to-cart bar", "default": true }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature row",
      "limit": 4,
      "settings": [
        { "type": "select", "id": "icon", "label": "Icon", "options": [
          { "value": "fire", "label": "Fire" }, { "value": "battery", "label": "Battery" }, { "value": "thermometer", "label": "Thermometer" },
          { "value": "star", "label": "Star" }, { "value": "truck", "label": "Truck" }, { "value": "shield", "label": "Shield" }, { "value": "check", "label": "Check" }
        ], "default": "fire" },
        { "type": "text", "id": "text", "label": "Text", "default": "3-speed temperature control" }
      ]
    },
    {
      "type": "addon",
      "name": "Add-on product",
      "limit": 4,
      "settings": [
        { "type": "product", "id": "product", "label": "Add-on product" },
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "text", "id": "text", "label": "Description" },
        { "type": "image_picker", "id": "image", "label": "Image (optional override)" },
        { "type": "checkbox", "id": "default_on", "label": "Selected by default", "default": false }
      ]
    },
    {
      "type": "trust",
      "name": "Trust item",
      "limit": 6,
      "settings": [
        { "type": "select", "id": "icon", "label": "Icon", "options": [
          { "value": "truck", "label": "Truck" }, { "value": "lock", "label": "Lock" },
          { "value": "shield", "label": "Shield" }, { "value": "star", "label": "Star" }
        ], "default": "truck" },
        { "type": "text", "id": "text", "label": "Text", "default": "Free shipping" }
      ]
    }
  ],
  "presets": [
    {
      "name": "WM Gloves hero",
      "blocks": [
        { "type": "feature", "settings": { "icon": "fire", "text": "3-speed temperature regulation (35°C - 55°C)" } },
        { "type": "feature", "settings": { "icon": "battery", "text": "USB battery powered, 8+ hour runtime" } },
        { "type": "feature", "settings": { "icon": "thermometer", "text": "Touchscreen compatible, waterproof" } },
        { "type": "addon", "settings": { "title": "Replacement batteries", "text": "Extra battery pack for extended use", "default_on": false } },
        { "type": "addon", "settings": { "title": "USB charging cable", "text": "Includes Type-C and Micro-USB adapters", "default_on": false } },
        { "type": "trust", "settings": { "icon": "lock", "text": "Secure checkout" } },
        { "type": "trust", "settings": { "icon": "shield", "text": "30-day guarantee" } },
        { "type": "trust", "settings": { "icon": "star", "text": "Rated 4.9 by customers" } }
      ]
    }
  ],
  "enabled_on": { "templates": ["product"] }
}
{% endschema %}
