<div class="ww-social-proof">
  <div class="ww-social-proof__inner">
    <div class="ww-section-heading">
      <h2 class="ww-section-title">{{ section.settings.heading }}</h2>
      <p class="ww-section-subtitle">{{ section.settings.subheading }}</p>
    </div>

    <div class="ww-proof-grid">
      {% for block in section.blocks %}
        {% if block.type == 'image' %}
          <div class="ww-proof-card">
            {% if block.settings.image %}
              <img src="{{ block.settings.image | img_url: '400x400' }}" alt="" class="ww-proof-image">
            {% else %}
              <div style="width: 100%; aspect-ratio: 1; background: #ddd; display: flex; align-items: center; justify-content: center; color: #999;">Image</div>
            {% endif %}
            <div class="ww-proof-caption">{{ block.settings.caption }}</div>
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Social Proof",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "People keep using Warm Wear"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Real customers enjoying their heated jacket and gloves"
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "caption",
          "label": "Caption",
          "default": "Warm and cozy"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Social Proof"
    }
  ]
}
{% endschema %}
