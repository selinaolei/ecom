<!DOCTYPE html>
<html lang="{{ request.locale.iso_code }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>{{ page_title }}</title>
<link rel="stylesheet" href="{{ 'warmwear-responsive.css' | asset_url }}">
{{ content_for_header }}
</head>
<body>
<style>
  .ww-header {
    display: flex;
    align-items: center;
    padding: 16px 20px;
    background: white;
    border-bottom: 1px solid #e0e0e0;
    max-width: 1200px;
    margin: 0 auto;
  }
  .ww-logo {
    height: 50px;
    width: auto;
  }
</style>
<header class="ww-header">
  <img src="{{ 'warmwear-logo.png' | asset_url }}" alt="Warm Wear" class="ww-logo">
</header>
{{ content_for_layout }}
</body>
</html>
